---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import { getGeneral } from "../lib/general.js";

interface Props {
  title: string;
  description?: string;
  image?: string;
  /** Páginas que no deben indexarse (post-formulario, 404). */
  noindex?: boolean;
}

const {
  title,
  description = "Anaerobia - Líderes en integración de sistemas de pintura y acabado para manufactura de alto volumen.",
  image,
  noindex = false,
} = Astro.props;

// La URL canónica evita que los filtros del catálogo (?categoria=, ?marca=)
// se indexen como páginas distintas del mismo contenido. Se normaliza sin
// barra final (salvo la raíz): una visita directa a la variante con barra
// no debe autocanonicalizarse a sí misma.
const rutaSinBarra = Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/+$/, "") : Astro.url.pathname;
const canonical = new URL(rutaSinBarra, Astro.site ?? Astro.url.origin).href;
const imagenSocial = image ? new URL(image, Astro.url.origin).href : undefined;

// Datos de entidad: name/url/logo/redes vienen del panel «General» (mismo
// contenido que ya consumen Navbar y Footer). Teléfono, correo y plazas
// están fijos porque así se publican hoy en /contacto, no hay campo
// administrable para ellos todavía.
const general = await getGeneral();

const datosOrganizacion = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Anaerobia",
  url: Astro.site?.href ?? "https://anaerobia.com/",
  logo: general.footer?.logo ?? general.logo?.image,
  email: "info@anaerobia.com",
  telephone: "+52-222-283-9604",
  sameAs: (general.footer?.social ?? []).map((red) => red.url),
  // Puebla, Monterrey y León son las plazas que hoy declara el pie de
  // página; Troy se agrega porque /contacto también la publica. Solo
  // Puebla y Troy tienen domicilio confirmado y se declaran como
  // LocalBusiness abajo — Monterrey y León no tienen dirección verificada
  // todavía (pendiente con el cliente).
  areaServed: ["Puebla, México", "Monterrey, México", "León, México", "Troy, Michigan, Estados Unidos"],
};

// Puebla y Troy confirmadas directamente con el cliente (ver memoria del
// proyecto). El resto de las plazas no tiene domicilio verificado.
const sedes = [
  {
    nombre: "Anaerobia Puebla",
    telefono: "+52-222-283-9604",
    calle: "Pº Sinfonía 3-14, Town Center Sonata, Lomas de Angelópolis",
    localidad: "Heroica Puebla de Zaragoza",
    region: "Puebla",
    codigoPostal: "72830",
    pais: "MX",
  },
  {
    nombre: "Anaerobia Troy",
    telefono: "+1-810-538-5775",
    calle: "48084 Rd. Suite 200 office 31",
    localidad: "Troy",
    region: "Michigan",
    codigoPostal: "48084",
    pais: "US",
  },
];

const datosLocalBusiness = sedes.map((sede) => ({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: sede.nombre,
  parentOrganization: { "@type": "Organization", name: "Anaerobia" },
  telephone: sede.telefono,
  email: "info@anaerobia.com",
  address: {
    "@type": "PostalAddress",
    streetAddress: sede.calle,
    addressLocality: sede.localidad,
    addressRegion: sede.region,
    postalCode: sede.codigoPostal,
    addressCountry: sede.pais,
  },
}));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="Blog | Anaerobia" href="/blog/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}

    <!-- Datos de entidad: Organization + LocalBusiness por sede -->
    <script type="application/ld+json" set:html={JSON.stringify(datosOrganizacion)} is:inline />
    {datosLocalBusiness.map((sede) => (
      <script type="application/ld+json" set:html={JSON.stringify(sede)} is:inline />
    ))}

    <!-- Redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Anaerobia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imagenSocial && <meta property="og:image" content={imagenSocial} />}
    <meta name="twitter:card" content={imagenSocial ? "summary_large_image" : "summary"} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Saira+Condensed:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700;1,800&display=swap"
      rel="stylesheet"
    />

    <!-- Swiper CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
    />
  </head>
  <body class="overflow-x-hidden font-inter text-gray-800">
    <Navbar />
    <slot />
    <Footer />

    <!-- CDNs de animaciones y UI -->
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"
    ></script>
    <script
      is:inline
      src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"
    ></script>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
    ></script>

    <script is:inline>
      // Registrar ScrollTrigger de forma global
      if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
        gsap.registerPlugin(ScrollTrigger);
      }
    </script>

    <!-- Chatbot (Conversia / ChatKodex) -->
    <script
      is:inline
      src="https://conversia.com.mx/assets/js/chatbot.js"
      id="chatbot-js"
    ></script>
    <script is:inline>
      CHATKODEX.init({
        host: window.location.host,
        key: "JQ5ChCTTl8wgz",
      });
    </script>

    <script is:inline>
      // Atribución de campaña: si la URL trae utm_*, se guardan en la sesión
      // del navegador para que sobrevivan la navegación hasta que se llene
      // el formulario de contacto (el clic al anuncio no siempre cae
      // directo en /contacto).
      (function () {
        var parametros = new URLSearchParams(window.location.search);
        var claves = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"];
        var alguno = claves.some(function (clave) { return parametros.has(clave); });
        if (!alguno) return;

        claves.forEach(function (clave) {
          var valor = parametros.get(clave);
          if (valor) sessionStorage.setItem(clave, valor);
        });
      })();
    </script>
  </body>
</html>

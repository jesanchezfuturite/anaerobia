---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Anaerobia - Líderes en integración de sistemas de pintura y acabado para manufactura de alto volumen.",
  image,
} = Astro.props;

// La URL canónica evita que los filtros del catálogo (?categoria=, ?marca=)
// se indexen como páginas distintas del mismo contenido.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const imagenSocial = image ? new URL(image, Astro.url.origin).href : undefined;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="alternate" type="application/rss+xml" title="Blog | Anaerobia" href="/blog/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <!-- Redes sociales -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Anaerobia" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {imagenSocial && <meta property="og:image" content={imagenSocial} />}
    <meta name="twitter:card" content={imagenSocial ? "summary_large_image" : "summary"} />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Saira+Condensed:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600;1,700;1,800&display=swap"
      rel="stylesheet"
    />

    <!-- Swiper CSS -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css"
    />
  </head>
  <body class="overflow-x-hidden font-inter text-gray-800">
    <Navbar />
    <slot />
    <Footer />

    <!-- CDNs de animaciones y UI -->
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/gsap.min.js"
    ></script>
    <script
      is:inline
      src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.2/ScrollTrigger.min.js"
    ></script>
    <script
      is:inline
      src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"
    ></script>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
    ></script>

    <script is:inline>
      // Registrar ScrollTrigger de forma global
      if (typeof gsap !== "undefined" && typeof ScrollTrigger !== "undefined") {
        gsap.registerPlugin(ScrollTrigger);
      }
    </script>

    <script is:inline>
      // Atribución de campaña: si la URL trae utm_*, se guardan en la sesión
      // del navegador para que sobrevivan la navegación hasta que se llene
      // el formulario de contacto (el clic al anuncio no siempre cae
      // directo en /contacto).
      (function () {
        var parametros = new URLSearchParams(window.location.search);
        var claves = ["utm_source", "utm_medium", "utm_campaign", "utm_term", "utm_content"];
        var alguno = claves.some(function (clave) { return parametros.has(clave); });
        if (!alguno) return;

        claves.forEach(function (clave) {
          var valor = parametros.get(clave);
          if (valor) sessionStorage.setItem(clave, valor);
        });
      })();
    </script>
  </body>
</html>

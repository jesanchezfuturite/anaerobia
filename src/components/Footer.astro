---
// Footer.astro - Reusable footer component for Anaerobia
---
<footer class="bg-[var(--color-brand-navy)] text-white pt-20 pb-10 border-t border-white/10">
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-16">
      <div class="md:col-span-1">
        <img src="https://anaerobia.com/wp-content/uploads/2020/10/Anaerobia-logotipo-1.svg" alt="Anaerobia" class="w-64 md:w-72 h-auto object-contain mb-6" />
        <p class="text-gray-400 text-sm leading-relaxed">
          Líderes en ingeniería e integración industrial. Desarrollamos soluciones integrales de pintura, silos y sistemas de pretratamiento para la manufactura global.
        </p>
      </div>
      
      <div>
        <h4 class="text-lg font-saira font-semibold italic text-[var(--color-brand-lime)] mb-6">Navegación</h4>
        <ul class="space-y-3 text-sm text-gray-300 font-medium">
          <li><a href="/#soluciones" class="hover:text-white hover:text-[var(--color-brand-lime)] transition-colors">Soluciones</a></li>
          <li><a href="/#mantenimiento" class="hover:text-white hover:text-[var(--color-brand-lime)] transition-colors">Mantenimiento</a></li>
          <li><a href="/#gestion360" class="hover:text-white hover:text-[var(--color-brand-lime)] transition-colors">Gestión 360°</a></li>
          <li><a href="/#industrias" class="hover:text-white hover:text-[var(--color-brand-lime)] transition-colors">Industrias</a></li>
          <li><a href="/#normativas" class="hover:text-white hover:text-[var(--color-brand-lime)] transition-colors">Normativas</a></li>
          <li><a href="/#mapa" class="hover:text-white hover:text-[var(--color-brand-lime)] transition-colors">Presencia Nacional</a></li>
          <li><a href="/#contacto" class="hover:text-white hover:text-[var(--color-brand-lime)] transition-colors">Contacto</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-lg font-saira font-semibold italic text-[var(--color-brand-lime)] mb-6">Especialidades</h4>
        <ul class="space-y-3 text-sm text-gray-300 font-medium">
          <li>Sistemas de Pintura en Polvo</li>
          <li>Sistemas de Pintura Líquida</li>
          <li>Sistemas de Aplicación</li>
          <li>Cabinas de Pintura y Acabado</li>
          <li>Hornos Industriales de Curado</li>
          <li>Transportadores / Conveyors</li>
        </ul>
      </div>

      <div>
        <h4 class="text-lg font-saira font-semibold italic text-[var(--color-brand-lime)] mb-6">Contacto Institucional</h4>
        <ul class="space-y-3 text-sm text-gray-300 font-medium">
          <li class="flex gap-2">
            <svg class="w-5 h-5 text-[var(--color-brand-lime)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            Parque Industrial Metalsa, NL
          </li>
          <li class="flex gap-2">
            <svg class="w-5 h-5 text-[var(--color-brand-lime)] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
            contacto@anaerobia.com
          </li>
        </ul>
      </div>
    </div>
    
    <div class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-500">
      <p>&copy; {new Date().getFullYear()} Anaerobia. Todos los derechos reservados.</p>
      <div class="flex gap-6 font-medium">
        <a href="#" class="hover:text-white transition-colors">Aviso de Privacidad</a>
        <a href="#" class="hover:text-white transition-colors">Términos y Condiciones</a>
      </div>
    </div>
  </div>
</footer>

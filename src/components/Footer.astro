---
import { getGeneral } from '../lib/general.js'

const general = await getGeneral()
const footer = general.footer ?? {}

// Un icono puede ser código SVG (se incrusta y hereda el color) o una imagen.
const esIconoSvg = (icono) => typeof icono === 'string' && icono.trimStart().startsWith('<svg')

// El menú vive en la pestaña «Menú de Navegación» de «General».
const nav = general.navigation ?? { links: [] }

// Los enlaces ocultos desde el panel (visible: false) no se renderizan
const visibles = (lista) => (lista ?? []).filter((i) => i.visible !== false)
const navItems = visibles(nav.links).map((item) => ({ ...item, submenu: visibles(item.submenu) }))
const footerNavItems = navItems.filter((item) => item.label !== 'Soluciones');
const solucionesItem = navItems.find((item) => item.label === 'Soluciones');
const solucionesSubmenu = solucionesItem?.submenu || [];
---

<footer
  class="bg-[var(--color-brand-navy)] text-white pt-20 pb-10 border-t border-white/10"
>
  <div class="container mx-auto px-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-12 mb-16">
      <div class="md:col-span-12 lg:col-span-3">
        <img
          src={footer.logo ?? general.logo?.image}
          alt={general.logo?.alt ?? "Anaerobia"}
          class="w-64 md:w-72 h-auto object-contain mb-6"
        />
        <p class="text-gray-400 text-sm leading-relaxed whitespace-pre-wrap">{footer.description}</p>

        <div class="mt-8 flex gap-5">
          {(footer.social ?? []).map((red) => (
            <a href={red.url} target="_blank" rel="noopener noreferrer" class="text-gray-400 hover:text-[var(--color-brand-lime)] transition-colors hover:-translate-y-1 transform duration-300" aria-label={red.name}>
              {esIconoSvg(red.icon) ? (
                <Fragment set:html={red.icon} />
              ) : (
                <img src={red.icon} alt={red.name} class="w-6 h-6 object-contain" />
              )}
            </a>
          ))}
        </div>
      </div>

      <div class="md:col-span-4 lg:col-span-2">
        <h4
          class="text-lg font-saira font-semibold italic text-[var(--color-brand-lime)] mb-6"
        >
          Navegación
        </h4>
        <ul class="space-y-3 text-sm text-gray-300 font-medium">
          {footerNavItems.map((item) => (
            <li>
              <a
                href={item.url}
                class="hover:text-white hover:text-[var(--color-brand-lime)] transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-8 lg:col-span-4">
        <h4
          class="text-lg font-saira font-semibold italic text-[var(--color-brand-lime)] mb-6 uppercase"
        >
          Especialidades
        </h4>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3 text-sm lg:text-[70%] text-gray-300 font-medium">
          {solucionesSubmenu.map((item) => (
            <li>
              <a href={item.url} class="hover:text-white hover:text-[var(--color-brand-lime)] transition-colors">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="md:col-span-12 lg:col-span-3">
        <h4
          class="text-lg font-saira font-semibold italic text-[var(--color-brand-lime)] mb-6 uppercase"
        >
          {footer.contactTitle}
        </h4>
        <ul class="space-y-3 text-sm text-gray-300 font-medium">
          {(footer.contacto ?? []).map((dato) => (
            <li class="flex gap-2 whitespace-pre-wrap">
              {esIconoSvg(dato.icon) ? (
                <Fragment set:html={dato.icon} />
              ) : (
                <img src={dato.icon} alt="" class="w-5 h-5 object-contain shrink-0" />
              )}
              {dato.text}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div
      class="pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-500"
    >
      <p class="whitespace-pre-wrap">&copy; {new Date().getFullYear()} {footer.copyright}</p>
      <div class="flex gap-6 font-medium">
        {(footer.legal ?? []).map((enlace) => (
          <a href={enlace.url} class="hover:text-white transition-colors">{enlace.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>

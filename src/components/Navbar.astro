---
import fallback from '../data/navigation.json'

// Menú administrable: se consulta la API del Admin en cada visita (SSR).
// Si la API no responde, se usa el respaldo local.
const API_URL = import.meta.env.ADMIN_API_URL ?? 'http://127.0.0.1:8000'
let nav = fallback
try {
    const res = await fetch(`${API_URL}/api/v1/paginas/navigation`, { signal: AbortSignal.timeout(5000) })
    if (res.ok) nav = (await res.json()).data
} catch {
    // API no disponible: el menú se sirve con el contenido de respaldo
}
// Los enlaces ocultos desde el panel (visible: false) no se renderizan
const visibles = (lista) => (lista ?? []).filter((i) => i.visible !== false)
const navItems = visibles(nav.links).map((item) => ({ ...item, submenu: visibles(item.submenu) }))
---

<header class="fixed w-full z-50 transition-all duration-300" id="main-nav">
  <div class="absolute inset-0 bg-white z-20" id="nav-bg"></div>
  <div class="container mx-auto px-6 relative z-30">
    <div class="flex items-center justify-between h-24 md:h-28">
      <!-- Logo Oficial -->
      <a href="/" class="flex items-center relative z-30">
        <img src="https://anaerobia.com/wp-content/uploads/2023/02/AnaerobiaLogo-Horizontal-1.png" alt="Anaerobia Logo" class="w-48 md:w-56 lg:w-64 xl:w-80 h-auto object-contain transition-all duration-300" />
      </a>

      <!-- Desktop Menu -->
      <nav class="hidden md:flex items-center gap-[clamp(8px,2vw,32px)]">
        {navItems.map((item) => (
          item.hasSubmenu && item.submenu && item.submenu.length > 0 ? (
            <div class="relative group py-4">
              <button class="flex items-center gap-1.5 text-[var(--color-brand-navy)] hover:text-[var(--color-brand-lime)] font-semibold text-[clamp(9px,1.1vw,14px)] uppercase tracking-widest transition-colors whitespace-nowrap cursor-pointer focus:outline-none">
                {item.label}
                <svg class="w-3.5 h-3.5 transform transition-transform duration-300 group-hover:rotate-180 text-gray-500 group-hover:text-[var(--color-brand-lime)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </button>
              
              <!-- Dropdown Menu -->
              <div class="absolute top-full left-1/2 -translate-x-1/2 mt-1 bg-white border border-gray-100 rounded-xl shadow-2xl p-6 transition-all duration-300 transform scale-95 opacity-0 pointer-events-none group-hover:scale-100 group-hover:opacity-100 group-hover:pointer-events-auto z-50 before:content-[''] before:absolute before:-top-6 before:left-0 before:w-full before:h-6 w-max min-w-[340px]">
                <div class="flex flex-col gap-y-3">
                  {item.submenu.map((subitem) => (
                    <a href={subitem.url} class="group/sub flex items-center justify-between w-full text-sm font-semibold text-[var(--color-brand-navy)] hover:text-[var(--color-brand-lime)] transition-colors py-1.5 gap-4">
                      <span>{subitem.label}</span>
                      <svg class="w-4 h-4 opacity-0 -translate-x-2 group-hover/sub:opacity-100 group-hover/sub:translate-x-0 text-[var(--color-brand-lime)] transition-all duration-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                      </svg>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ) : (
            <a href={item.url} class="text-[var(--color-brand-navy)] hover:text-[var(--color-brand-lime)] font-semibold text-[clamp(9px,1.1vw,14px)] uppercase tracking-widest transition-colors whitespace-nowrap">{item.label}</a>
          )
        ))}
      </nav>

      <!-- Mobile Button -->
      <button class="md:hidden text-[var(--color-brand-navy)] focus:outline-none z-30 cursor-pointer" id="mobile-menu-btn" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="hamburger-icon" class="block" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          <path id="close-icon" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Panel -->
  <div id="mobile-menu" class="absolute top-full left-0 w-full bg-white/98 backdrop-blur-lg shadow-xl border-t border-gray-100 transition-all duration-300 transform -translate-y-full opacity-0 pointer-events-none md:hidden z-10 max-h-[75vh] overflow-y-auto">
    <nav class="flex flex-col p-6 space-y-3">
      {navItems.map((item) => (
        item.hasSubmenu && item.submenu && item.submenu.length > 0 ? (
          <div class="flex flex-col border-b border-gray-100 py-2">
            <button class="mobile-submenu-trigger flex items-center justify-between text-[var(--color-brand-navy)] font-semibold text-sm uppercase tracking-widest py-2 cursor-pointer w-full text-left focus:outline-none">
              {item.label}
              <svg class="w-4 h-4 transform transition-transform duration-300 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
              </svg>
            </button>
            <div class="mobile-submenu hidden flex-col pl-4 mt-2 space-y-2.5 transition-all duration-300">
              {item.submenu.map((subitem) => (
                <a href={subitem.url} class="group/sub mobile-nav-link text-sm font-semibold text-gray-600 hover:text-[var(--color-brand-lime)] transition-colors py-1.5 flex items-center justify-between w-full gap-4">
                  <span>{subitem.label}</span>
                  <svg class="w-4 h-4 opacity-0 -translate-x-2 group-hover/sub:opacity-100 group-hover/sub:translate-x-0 text-[var(--color-brand-lime)] transition-all duration-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path>
                  </svg>
                </a>
              ))}
            </div>
          </div>
        ) : (
          <a href={item.url} class="mobile-nav-link text-[var(--color-brand-navy)] hover:text-[var(--color-brand-lime)] font-semibold text-sm uppercase tracking-widest transition-colors py-3 border-b border-gray-100 last:border-b-0">{item.label}</a>
        )
      ))}
    </nav>
  </div>
</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const navBg = document.getElementById("nav-bg");
    const mobileMenuBtn = document.getElementById("mobile-menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const hamburgerIcon = document.getElementById("hamburger-icon");
    const closeIcon = document.getElementById("close-icon");
    const mobileLinks = document.querySelectorAll(".mobile-nav-link");

    // Add shadow when scrolling for depth
    if (window.scrollY < 50) {
      navBg.classList.remove('shadow-md');
    }
    
    window.addEventListener("scroll", () => {
      if (window.scrollY > 50) {
        navBg.classList.add('shadow-md');
      } else {
        navBg.classList.remove('shadow-md');
      }
    });

    // Toggle Mobile Menu
    function toggleMobileMenu() {
      const isExpanded = mobileMenuBtn.getAttribute("aria-expanded") === "true";
      mobileMenuBtn.setAttribute("aria-expanded", !isExpanded);
      
      if (!isExpanded) {
        // Open
        mobileMenu.classList.remove("-translate-y-full", "opacity-0", "pointer-events-none");
        mobileMenu.classList.add("translate-y-0", "opacity-100", "pointer-events-auto");
        hamburgerIcon.classList.remove("block");
        hamburgerIcon.classList.add("hidden");
        closeIcon.classList.remove("hidden");
        closeIcon.classList.add("block");
      } else {
        // Close
        mobileMenu.classList.remove("translate-y-0", "opacity-100", "pointer-events-auto");
        mobileMenu.classList.add("-translate-y-full", "opacity-0", "pointer-events-none");
        hamburgerIcon.classList.remove("hidden");
        hamburgerIcon.classList.add("block");
        closeIcon.classList.remove("block");
        closeIcon.classList.add("hidden");
        
        // Also collapse any expanded submenus on menu close
        const mobileSubmenus = document.querySelectorAll(".mobile-submenu");
        const mobileSubmenuIcons = document.querySelectorAll(".mobile-submenu-trigger svg");
        mobileSubmenus.forEach(submenu => {
          submenu.classList.remove("flex");
          submenu.classList.add("hidden");
        });
        mobileSubmenuIcons.forEach(icon => {
          icon.classList.remove("rotate-180");
        });
      }
    }

    mobileMenuBtn?.addEventListener("click", toggleMobileMenu);

    // Close menu when clicking on any mobile nav link
    mobileLinks.forEach(link => {
      link.addEventListener("click", () => {
        if (mobileMenuBtn.getAttribute("aria-expanded") === "true") {
          toggleMobileMenu();
        }
      });
    });

    // Toggle Mobile Submenus
    const submenuTriggers = document.querySelectorAll(".mobile-submenu-trigger");
    submenuTriggers.forEach(trigger => {
      trigger.addEventListener("click", (e) => {
        e.preventDefault();
        const submenu = trigger.nextElementSibling;
        const icon = trigger.querySelector("svg");
        
        const isCollapsed = submenu.classList.contains("hidden");
        
        if (isCollapsed) {
          submenu.classList.remove("hidden");
          submenu.classList.add("flex");
          icon.classList.add("rotate-180");
        } else {
          submenu.classList.remove("flex");
          submenu.classList.add("hidden");
          icon.classList.remove("rotate-180");
        }
      });
    });
  });
</script>

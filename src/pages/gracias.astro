---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Gracias - Anaerobia">
  <section class="min-h-screen bg-[var(--color-brand-navy)] flex items-center justify-center pt-24 pb-12 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute top-0 right-0 w-96 h-96 bg-[var(--color-brand-lime)]/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-[var(--color-brand-blue)]/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4"></div>
    </div>
    
    <div class="container mx-auto px-6 relative z-10 text-center max-w-2xl">
      <div class="w-24 h-24 mx-auto mb-8 bg-[var(--color-brand-lime)] rounded-full flex items-center justify-center shadow-[0_0_30px_rgba(141,163,28,0.3)]">
        <svg class="w-12 h-12 text-[var(--color-brand-navy)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>
      </div>
      
      <h1 class="text-4xl md:text-5xl font-saira font-bold text-white mb-6 uppercase tracking-wider">¡Gracias por tu mensaje!</h1>
      <p class="text-gray-300 text-lg md:text-xl mb-12 font-light leading-relaxed">
        Hemos recibido tu información correctamente. Un ingeniero de nuestro equipo se pondrá en contacto contigo a la brevedad para brindarte la asesoría técnica que necesitas.
      </p>
      
      <a href="/" class="inline-flex items-center justify-center px-10 py-4 font-bold text-[var(--color-brand-navy)] uppercase tracking-widest bg-[var(--color-brand-lime)] hover:bg-white transition-all duration-300 rounded shadow-xl hover:-translate-y-1">
        Volver al Inicio
      </a>
    </div>
  </section>
</Layout>

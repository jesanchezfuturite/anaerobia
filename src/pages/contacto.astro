---
export const prerender = false

import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';

import fallback from '../data/contacto.json'

// Todo, menos el formulario, es contenido administrable: se consulta la API
// del Admin (Laravel) en cada visita (SSR). Si la API no responde, se usa el
// respaldo local.
const API_URL = import.meta.env.ADMIN_API_URL ?? 'http://127.0.0.1:8000'
let d = fallback
try {
    const res = await fetch(`${API_URL}/api/v1/paginas/contacto`, { signal: AbortSignal.timeout(5000) })
    if (res.ok) d = (await res.json()).data
} catch {
    // API no disponible: la página se sirve con el contenido de respaldo
}

const seoTitle = d.seo?.title
const seoDescription = d.seo?.description
const sedes = d.sedes ?? []
const mapEmbedUrl = d.mapa_contacto?.embedUrl
---

<Layout title={seoTitle} description={seoDescription}>
  <!-- Hero Section -->
  <section class="relative pt-32 pb-20 md:pt-40 md:pb-36 overflow-hidden min-h-[40vh] flex items-center justify-center">
    <div class="absolute inset-0 z-0">
      <img src="/img/parallax_bg.webp" alt="Contacto Anaerobia" class="w-full h-full object-cover object-center filter brightness-50" />
      <div class="absolute inset-0 bg-[var(--color-brand-navy)]/70 mix-blend-multiply"></div>
    </div>
    <div class="container mx-auto px-6 relative z-10 text-center">
      {d.hero?.badge && (
        <span class="text-[var(--color-brand-lime)] font-bold tracking-widest text-sm mb-4 uppercase inline-block bg-[var(--color-brand-lime)]/10 px-6 py-2 rounded-full backdrop-blur-sm">{d.hero.badge}</span>
      )}
      <h1 class="text-4xl md:text-6xl font-saira font-bold italic text-white uppercase tracking-wider mb-6 leading-tight">{d.hero?.title}</h1>
      {d.hero?.description && (
        <p class="text-gray-200 text-lg md:text-xl max-w-2xl mx-auto font-light">{d.hero.description}</p>
      )}
    </div>
  </section>

  <!-- Form and Info Section -->
  <section class="py-12 bg-gray-50 relative">
    <div class="container mx-auto px-6 max-w-4xl relative z-20 -mt-32">
      <!-- Formulario -->
      <div class="bg-white rounded-2xl p-8 md:p-12 shadow-[0_20px_50px_rgba(8,_112,_184,_0.1)] mb-16 border border-gray-100">
         <h2 class="text-2xl md:text-3xl font-saira font-semibold italic text-[var(--color-brand-navy)] mb-8 uppercase tracking-wider text-center">Envíanos un mensaje</h2>

         <ContactForm />
      </div>

      <!-- Info Cards Container -->
      <div class="flex flex-col gap-8 mb-12">
        {sedes.map((sede) => {
          const [emailUser, emailDomain] = (sede.email ?? '').split('@');
          return (
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center bg-[var(--color-brand-navy)] text-white rounded-2xl p-8 md:p-12 shadow-2xl overflow-hidden relative border-t-4 border-[var(--color-brand-lime)]">
            <div class="absolute top-0 right-0 w-64 h-64 bg-[var(--color-brand-blue)]/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4 pointer-events-none"></div>

            <!-- Col 1: Ciudad -->
            <div class="flex flex-col items-center md:items-start space-y-2 relative z-10 text-center md:text-left">
              <h3 class="text-white font-saira font-bold italic text-2xl md:text-3xl uppercase tracking-wider mb-2">{sede.ciudad}</h3>
              <p class="text-gray-300 text-sm font-light">{sede.label}</p>
            </div>

            <!-- Col 2: Teléfono -->
            <div class="flex flex-col items-center space-y-2 relative z-10 min-w-0 w-full">
              <div class="flex items-center gap-4 min-w-0 w-full">
                 <div class="w-12 h-12 [clip-path:polygon(50%_0%,100%_25%,100%_75%,50%_100%,0%_75%,0%_25%)] bg-[var(--color-brand-lime)] flex items-center justify-center shrink-0 shadow-lg shadow-[var(--color-brand-lime)]/30">
                    <svg class="w-5 h-5 text-[var(--color-brand-navy)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
                 </div>
                 <div class="text-left min-w-0">
                   <span class="block text-[10px] md:text-xs uppercase text-gray-400 tracking-widest font-bold mb-1">Centro de Atención</span>
                   <a href={`tel:${sede.phoneHref}`} class="font-bold text-white text-lg md:text-xl hover:text-[var(--color-brand-lime)] transition-colors leading-tight block break-words">{sede.phone}</a>
                 </div>
              </div>
            </div>

            <!-- Col 3: Correo -->
            <div class="flex flex-col items-center md:items-end space-y-2 relative z-10 min-w-0 w-full">
               <div class="flex items-center gap-4 min-w-0 w-full">
                 <div class="w-12 h-12 [clip-path:polygon(50%_0%,100%_25%,100%_75%,50%_100%,0%_75%,0%_25%)] bg-[#3a483a] flex items-center justify-center shrink-0 shadow-lg">
                    <svg class="w-5 h-5 text-[var(--color-brand-lime)]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
                 </div>
                 <div class="text-left min-w-0">
                   <span class="block text-[10px] md:text-xs uppercase text-gray-400 tracking-widest font-bold mb-1">Correo Corporativo</span>
                   <a href={`mailto:${sede.email}`} class="font-bold text-white text-base md:text-lg hover:text-[var(--color-brand-lime)] transition-colors break-words leading-snug">
                     {emailDomain ? <>{emailUser}@<wbr />{emailDomain}</> : sede.email}
                   </a>
                 </div>
               </div>
            </div>
          </div>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Map Section -->
  {mapEmbedUrl && (
    <section class="w-full relative z-10 -mt-8">
       <iframe src={mapEmbedUrl} width="100%" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    </section>
  )}

</Layout>

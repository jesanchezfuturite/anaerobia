                    opacity: 0,
                    duration: 1,
                    stagger: 0.15,
                    ease: 'power3.out',
                })
                gsap.from('.intro-text > *', {
                    scrollTrigger: { trigger: '#introduccion', start: 'top 80%' },
                    y: 30,
                    opacity: 0,
                    duration: 0.8,
                    stagger: 0.12,
                    ease: 'power2.out',
                })
                gsap.from('.intro-image', {
                    scrollTrigger: { trigger: '#introduccion', start: 'top 80%' },
                    x: 40,
                    opacity: 0,
                    duration: 0.9,
                    ease: 'power2.out',
                })
                gsap.from('.pain-points-grid > div', {
                    scrollTrigger: { trigger: '#importancia', start: 'top 85%' },
                    y: 40,
                    opacity: 0,
                    duration: 0.8,
                    stagger: 0.15,
                    ease: 'power2.out',
                })
                gsap.from('#ingenieria .grid > div', {
                    scrollTrigger: { trigger: '#ingenieria', start: 'top 80%' },
                    y: 30,
                    opacity: 0,
                    duration: 0.7,
                    stagger: 0.15,
                    ease: 'power2.out',
                    clearProps: 'all',
                })
                gsap.from('#fases .grid > div', {
                    scrollTrigger: { trigger: '#fases', start: 'top 85%' },
                    y: 20,
                    opacity: 0,
                    duration: 0.5,
                    stagger: 0.1,
                    ease: 'back.out(1.7)',
                })

                gsap.from('#sectores .grid > div', {
                    scrollTrigger: { trigger: '#sectores', start: 'top 85%' },
                    scale: 0.9,
                    opacity: 0,
                    duration: 0.5,
                    stagger: 0.05,
                    ease: 'power2.out',
                })
                gsap.from('#diferenciadores .grid > div', {
                    scrollTrigger: { trigger: '#diferenciadores', start: 'top 85%' },
                    y: 30,
                    opacity: 0,
                    duration: 0.6,
                    stagger: 0.1,
                    ease: 'power2.out',
                })
                gsap.from('#beneficios .grid > div', {
                    scrollTrigger: { trigger: '#beneficios', start: 'top 85%' },
                    y: 20,
                    opacity: 0,
                    duration: 0.6,
                    stagger: 0.1,
                    ease: 'power2.out',
                })

                // Nuevas animaciones añadidas
                gsap.from('.norms-text > *', {
                    scrollTrigger: { trigger: '#normas', start: 'top 80%' },
                    y: 30,
                    opacity: 0,
                    duration: 0.8,
                    stagger: 0.12,
                    ease: 'power2.out',
                })
                gsap.from('.norms-grid > div', {
                    scrollTrigger: { trigger: '.norms-grid', start: 'top 85%' },
                    y: 20,
                    opacity: 0,
                    duration: 0.6,
                    stagger: 0.1,
                    ease: 'power2.out',
                    clearProps: 'opacity,transform',
                })
                gsap.from('#faq details', {
                    scrollTrigger: { trigger: '#faq', start: 'top 80%' },
                    y: 20,
                    opacity: 0,
                    duration: 0.6,
                    stagger: 0.1,
                    ease: 'power2.out',
                    clearProps: 'opacity,transform',
                })
                gsap.from('.gallery-grid > div', {
                    scrollTrigger: { trigger: '.gallery-grid', start: 'top 85%' },
                    y: 30,
                    opacity: 0,
                    duration: 0.7,
                    stagger: 0.12,
                    ease: 'power2.out',
                    clearProps: 'opacity,transform',
                })
            }

            // Tech Tabs Logic
            const tabBtns = document.querySelectorAll('.tech-tab-btn')
            const tabPanels = document.querySelectorAll('.tech-tab-panel')

            if (tabBtns.length > 0) {
                tabBtns.forEach((btn) => {
                    btn.addEventListener('click', () => {
                        const targetTab = btn.getAttribute('data-tab')

                        // Update buttons
                        tabBtns.forEach((b) => {
                            b.classList.remove('active', 'border-brand-lime', 'bg-brand-lime/10', 'text-brand-lime')
                            b.classList.add('border-transparent', 'bg-transparent', 'text-gray-400')
                        })
                        btn.classList.remove('border-transparent', 'bg-transparent', 'text-gray-400')
                        btn.classList.add('active', 'border-brand-lime', 'bg-brand-lime/10', 'text-brand-lime')

                        // Update panels
                        tabPanels.forEach((panel) => {
                            panel.classList.remove('opacity-100', 'translate-y-0', 'relative', 'z-10')
                            panel.classList.add('opacity-0', 'translate-y-4', 'absolute', 'top-0', 'left-0', 'w-full', 'z-0', 'pointer-events-none')
                        })

                        const targetPanel = document.getElementById(targetTab)
                        if (targetPanel) {
                            targetPanel.classList.remove('opacity-0', 'translate-y-4', 'absolute', 'top-0', 'left-0', 'w-full', 'z-0', 'pointer-events-none')
                            targetPanel.classList.add('opacity-100', 'translate-y-0', 'relative', 'z-10')
                        }
                    })
                })
            }

            // Inicializar Marquee Swiper
            if (typeof Swiper !== 'undefined') {
                new Swiper('.marquee-swiper', {
                    loop: true,
                    speed: 3000,
                    autoplay: { delay: 0, disableOnInteraction: false },
                    slidesPerView: 'auto',
                    spaceBetween: 10,
                    allowTouchMove: false,
                    freeMode: true,
                })
            }
        })
    </script>
</Layout>

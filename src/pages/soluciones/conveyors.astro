---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import { getEntry } from "astro:content";

// Obtener datos de la página de inicio para reutilizar logos de normativas
const homepageEntry = await getEntry("homepage", "index");
const homepageData = homepageEntry?.data || {};
const certificados = homepageData.normativas?.certificados || [
  { name: "NFPA", logo: "/images/home/certificaciones/nfpa.png" },
  { name: "EPA", logo: "/images/home/certificaciones/epa.svg" },
  { name: "ETL", logo: "/images/home/certificaciones/etl.png" },
  { name: "ICC", logo: "/images/home/certificaciones/icc.png" },
  { name: "OSHA", logo: "/images/home/certificaciones/osha.png" },
];

// SEO Metadata
const seoTitle = "Sistemas de Transporte y Conveyors Industriales | Anaerobia";
const seoDescription =
  "Especialistas en el diseño, integración y montaje de sistemas de transporte y conveyors aéreos (Overhead), a piso (Floor) y Power & Free a la medida.";
---

<Layout title={seoTitle} description={seoDescription}>
  <main class="bg-industrial-gray min-h-screen text-brand-navy">
    <!-- 01. HEADER / HERO -->
    <section
      class="relative min-h-[60vh] flex items-center pt-36 pb-20 bg-brand-navy overflow-hidden"
    >
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0 z-0">
        <img
          src="/images/soluciones/conveyors/conveyor-13.webp"
          alt="Sistemas de Transporte y Conveyors Industriales"
          class="w-full h-full object-cover opacity-60 scale-105"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/85 to-brand-navy/60"
        >
        </div>
      </div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl hero-section-text">
          <!-- Breadcrumbs -->
          <nav
            class="flex items-center gap-2 text-xs md:text-sm text-gray-400 font-semibold uppercase tracking-widest mb-6"
          >
            <a
              href="/"
              class="text-gray-300 hover:text-brand-lime transition-colors"
              >Inicio</a
            >
            <span>/</span>
            <span class="text-gray-400">Soluciones</span>
            <span>/</span>
            <span class="text-brand-lime">Conveyors</span>
          </nav>

          <span
            class="inline-block bg-brand-lime/10 text-brand-lime border border-brand-lime/20 rounded px-3 py-1 text-xs font-semibold uppercase tracking-widest mb-6"
          >
            SISTEMAS DE TRANSPORTE Y MANIPULACIÓN B2B
          </span>
          <h1
            class="text-white font-saira italic font-semibold uppercase text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] mb-6"
          >
            Conveyors
          </h1>
          <p
            class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed"
          >
            Nuestros sistemas de transporte pueden adaptarse a las necesidades
            específicas de cualquier proceso, ya que es posible configurar
            elementos como la velocidad y los movimientos, además de ajustarse
            dependiendo del tamaño y peso de las piezas que se manipularán.
          </p>
        </div>
      </div>
    </section>

    <!-- 02. INTRODUCCIÓN -->
    <section
      class="py-16 bg-white px-6 md:px-12 relative overflow-hidden"
      id="introduccion"
    >
      <div class="container mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="space-y-8 intro-text">
            <div>
              <span
                class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full"
                >Logística Interna y Flujo Continuo</span
              >
              <h2
                class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4 mb-6 leading-tight"
              >
                ¿Qué son los conveyors?
              </h2>
              <p
                class="text-gray-600 leading-relaxed font-light text-base md:text-lg mb-4"
              >
                Los conveyors, o sistemas de transporte, son mecanismos
                utilizados en los procesos de aplicación de recubrimientos para
                el desplazamiento eficiente de materiales, productos o
                mercancías dentro de una instalación.
              </p>
              <p class="text-gray-600 leading-relaxed font-light text-base">
                Estos sistemas permiten trasladar, separar y clasificar objetos
                de forma continua y ordenada, minimizando la intervención manual
                y optimizando los tiempos del ciclo de producción. Su
                adaptabilidad a diferentes pesos, velocidades y recorridos los
                convierte en el núcleo de la automatización en plantas
                industriales de acabados.
              </p>
              <p
                class="text-brand-navy font-saira font-bold uppercase italic mt-6 border-l-4 border-brand-lime pl-4"
              >
                Mejoramos la industria del mundo con ingeniería especializada y
                alta tecnología.
              </p>
            </div>

            <!-- Key pillars (Experiencia, Soporte local, Normativa) -->
            <div
              class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-gray-100"
            >
              <div class="space-y-2">
                <div
                  class="flex items-center justify-center w-10 h-10 rounded bg-brand-lime/10 text-brand-lime"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    ></path>
                  </svg>
                </div>
                <h3
                  class="font-saira font-semibold italic text-brand-navy text-base uppercase"
                >
                  Experiencia
                </h3>
                <p class="text-xs text-gray-500 leading-relaxed">
                  Nuestro equipo cuenta con la preparación y experiencia
                  necesarias para afrontar los desafíos de la industria.
                </p>
              </div>

              <div class="space-y-2">
                <div
                  class="flex items-center justify-center w-10 h-10 rounded bg-brand-blue/10 text-brand-blue"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    ></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </div>
                <h3
                  class="font-saira font-semibold italic text-brand-navy text-base uppercase"
                >
                  Soporte Local
                </h3>
                <p class="text-xs text-gray-500 leading-relaxed">
                  Estamos presentes en los centros industriales del país para
                  dar acompañamiento cercano y puntual a nuestros clientes.
                </p>
              </div>

              <div class="space-y-2">
                <div
                  class="flex items-center justify-center w-10 h-10 rounded bg-brand-navy/10 text-brand-navy"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    ></path>
                  </svg>
                </div>
                <h3
                  class="font-saira font-semibold italic text-brand-navy text-base uppercase"
                >
                  Normativa
                </h3>
                <p class="text-xs text-gray-500 leading-relaxed">
                  Nuestros equipos cumplen con normativas internacionales y
                  nacionales.
                </p>
              </div>
            </div>
          </div>

          <!-- Intro Image -->
          <div class="relative intro-image group">
            <div class="relative rounded-lg overflow-hidden shadow-2xl">
              <img
                src="/images/soluciones/conveyors/conveyor-1.webp"
                alt="Sistema de Conveyor Industrial en Operación"
                class="w-full h-auto object-cover transform hover:scale-[1.02] transition-transform duration-700"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 03. PROBLEMA / NECESIDAD (PAIN POINTS) -->
    <section
      class="py-16 bg-industrial-gray px-6 md:px-12 border-t border-gray-200/50"
    >
      <div class="container mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 pain-points-header">
          <span
            class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full"
            >Desafíos</span
          >
          <h2
            class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4"
          >
            Desafíos Comunes en el Transporte de Materiales
          </h2>
          <p class="text-gray-600 mt-4 font-light">
            El flujo ineficiente de piezas en una línea de aplicación de
            recubrimiento puede elevar drásticamente los tiempos muertos y
            reducir la calidad del acabado.
          </p>
        </div>

        <div
          class="flex flex-col lg:flex-row gap-8 lg:h-[600px] w-full max-w-7xl mx-auto pain-points-grid items-stretch"
        >
          <!-- Column 1: Image (45%) -->
          <div
            class="w-full lg:w-[45%] relative rounded-3xl overflow-hidden shadow-2xl h-[400px] lg:h-auto shrink-0 group"
          >
            <img
              src="/images/soluciones/conveyors/conveyor-4.webp"
              alt="Desafíos de Transporte de Materiales"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-brand-navy/30 mix-blend-multiply">
            </div>
          </div>

          <!-- Column 2: Cards (20%) -->
          <div
            class="w-full lg:w-[20%] flex flex-col justify-between gap-4 shrink-0 h-full"
          >
            <!-- Card 1 -->
            <div
              class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 lg:h-[32%] min-h-[100px]"
            >
              <p
                class="text-lg lg:text-xl font-saira font-bold italic text-brand-blue leading-snug text-center"
              >
                Cuellos de botella en la línea
              </p>
            </div>

            <!-- Card 2 -->
            <div
              class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 lg:h-[36%] min-h-[120px]"
            >
              <p
                class="text-lg lg:text-xl font-saira font-bold italic text-brand-blue leading-snug text-center"
              >
                Riesgos por manejo manual
              </p>
            </div>

            <!-- Card 3 -->
            <div
              class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 lg:h-[32%] min-h-[100px]"
            >
              <p
                class="text-lg lg:text-xl font-saira font-bold italic text-brand-blue leading-snug text-center"
              >
                Rigidez en el trayecto de piezas
              </p>
            </div>
          </div>

          <!-- Column 3: Content (35%) -->
          <div
            class="w-full lg:w-[35%] flex flex-col justify-center space-y-10 shrink-0 lg:pl-2"
          >
            <!-- Item 1 -->
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <div class="text-brand-lime shrink-0">
                  <svg
                    class="w-7 h-7"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                    ></path>
                  </svg>
                </div>
                <h3
                  class="font-saira font-bold italic text-brand-navy text-xl md:text-2xl uppercase"
                >
                  Cuellos de Botella y Retrasos
                </h3>
              </div>
              <p class="text-base text-gray-600 leading-relaxed font-light">
                El traslado ineficiente o manual de componentes de gran tamaño
                interrumpe la sincronía de la línea de acabado, generando
                acumulaciones críticas en las áreas de pretratamiento o
                aplicación.
              </p>
            </div>

            <!-- Item 2 -->
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <div class="text-brand-lime shrink-0">
                  <svg
                    class="w-7 h-7"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                </div>
                <h3
                  class="font-saira font-bold italic text-brand-navy text-xl md:text-2xl uppercase"
                >
                  Riesgos Ocupacionales y Daños
                </h3>
              </div>
              <p class="text-base text-gray-600 leading-relaxed font-light">
                La manipulación física directa de piezas pesadas incrementa el
                riesgo de accidentes laborales y fatiga de los operadores,
                elevando además la probabilidad de rayaduras o contaminación del
                recubrimiento fresco.
              </p>
            </div>

            <!-- Item 3 -->
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <div class="text-brand-lime shrink-0">
                  <svg
                    class="w-7 h-7"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M7 13v-8a1 1 0 0 0 -1 -1h-2a1 1 0 0 0 -1 1v7a1 1 0 0 0 1 1h3a4 4 0 0 1 4 4v1a2 2 0 0 0 4 0v-5h3a2 2 0 0 0 2 -2l-1 -5a2 3 0 0 0 -2 -2h-7a3 3 0 0 0 -3 3"
                    ></path>
                  </svg>
                </div>
                <h3
                  class="font-saira font-bold italic text-brand-navy text-xl md:text-2xl uppercase"
                >
                  Falta de Adaptabilidad
                </h3>
              </div>
              <p class="text-base text-gray-600 leading-relaxed font-light">
                Los sistemas de transporte que no permiten curvas cerradas,
                inclinaciones o rampas de velocidad dinámicas restringen
                severamente la optimización y flexibilidad del espacio en
                planta.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 04. PRIMER CTA PERSONALIZADO -->
    <section class="py-16 bg-brand-navy relative overflow-hidden">
      <div
        class="absolute inset-0 bg-gradient-to-r from-brand-navy via-brand-navy to-brand-blue/50 opacity-90"
      >
      </div>
      <div
        class="container mx-auto px-6 relative z-10 flex flex-col md:flex-row items-center justify-between gap-8"
      >
        <div class="text-left">
          <h2
            class="text-white text-2xl md:text-3xl font-saira italic font-semibold uppercase"
          >
            ¿Requieres optimizar el flujo de tu línea con conveyors a la medida?
          </h2>
          <p
            class="text-gray-300 text-sm md:text-base font-light mt-2 max-w-xl"
          >
            Diseñamos e integramos un sistema de transporte adaptado a las
            necesidades específicas de tu proceso.
          </p>
        </div>
        <a
          href="/contacto?solucion=conveyors"
          class="bg-brand-lime text-brand-navy font-bold uppercase tracking-widest px-8 py-4 rounded hover:brightness-110 transition-all shadow-lg shrink-0 text-center"
        >
          Solicitar Cotización
        </a>
      </div>
    </section>

    <!-- 05. SOLUCIÓN ANAEROBIA (NUESTRA INGENIERÍA) -->
    <section
      class="py-16 bg-gradient-to-b from-gray-100 to-white px-6 md:px-12 relative overflow-hidden"
      id="ingenieria"
    >
      <div class="container mx-auto">
        <div class="max-w-5xl mb-10 section-solucion-header">
          <span
            class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full"
            >Integrador Especializado</span
          >
          <h2
            class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4"
          >
            Nuestra Ingeniería en Sistemas de Transporte
          </h2>
          <p class="text-gray-600 font-light mt-4">
            Diseñamos e integramos sistemas de transporte avanzados, adaptados a
            la geometría de tus piezas, condiciones de carga y la velocidad
            requerida por tus cabinas y hornos de curado.
          </p>
        </div>

        <div
          class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-10 text-left items-stretch"
        >
          <!-- Bento Card 1 (Large Left) -->
          <div
            class="bg-brand-navy rounded-3xl p-10 lg:p-14 flex flex-col justify-between relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 shadow-2xl min-h-[500px] h-full"
          >
            <!-- Image background -->
            <div
              class="absolute inset-0 bg-[url('/images/soluciones/conveyors/conveyor-3.webp')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"
            >
            </div>
            <!-- Overlay azul -->
            <div
              class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"
            >
            </div>

            <!-- Decorative background element -->
            <div
              class="absolute -right-20 -top-20 w-64 h-64 bg-brand-lime opacity-20 blur-3xl rounded-full group-hover:scale-150 transition-transform duration-700"
            >
            </div>

            <div
              class="absolute top-6 right-6 lg:top-8 lg:right-8 w-20 h-20 bg-brand-lime/20 text-brand-lime rounded-2xl flex items-center justify-center z-20"
            >
              <svg
                class="w-10 h-10"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path
                  d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"
                ></path>
              </svg>
            </div>
            <div class="relative z-10 mt-auto">
              <div>
                <h3
                  class="font-saira font-semibold italic text-white text-3xl md:text-4xl uppercase mb-4 leading-tight"
                >
                  Sistemas Aéreos (Overhead Conveyors)
                </h3>
                <p class="text-lg text-gray-200 font-light leading-relaxed">
                  Configuraciones con Viga I (I Beam) y Track Cerrado. Ideales
                  para optimizar el espacio a nivel de piso. Suspendiendo la
                  carga, facilitan el tránsito de las piezas de forma continua y
                  segura por zonas de pretratamiento químico, cabinas de
                  aplicación y hornos de secado.
                </p>
              </div>
            </div>
          </div>

          <!-- Right Column for Bento Cards 2 & 3 -->
          <div class="flex flex-col gap-6 h-full">
            <!-- Bento Card 2 -->
            <div
              class="bg-brand-navy rounded-3xl p-8 lg:p-10 flex flex-col justify-center relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 h-full shadow-xl min-h-[250px]"
            >
              <!-- Image background -->
              <div
                class="absolute inset-0 bg-[url('/images/soluciones/conveyors/conveyor-2.webp')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"
              >
              </div>
              <!-- Overlay azul -->
              <div
                class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"
              >
              </div>

              <div
                class="absolute top-6 right-6 lg:top-8 lg:right-8 w-14 h-14 bg-brand-lime/20 shadow-sm text-brand-lime rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 z-20"
              >
                <svg
                  class="w-7 h-7"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <circle cx="12" cy="12" r="4"></circle>
                </svg>
              </div>
              <div class="relative z-10">
                <h3
                  class="font-saira font-semibold italic text-white text-2xl uppercase leading-tight pr-16 mb-6"
                >
                  Sistemas a Piso (Floor Conveyors)
                </h3>
                <p class="text-base text-gray-200 font-light leading-relaxed">
                  Soluciones de Rodillos, Cadena y Banda. Brindan máxima
                  estabilidad y arrastre para piezas masivas o de gran volumen.
                  Son clave para ensambles finales, líneas de transferencia
                  pesada y retorno de dispositivos o ganchos vacíos.
                </p>
              </div>
            </div>

            <!-- Bento Card 3 -->
            <div
              class="bg-brand-navy rounded-3xl p-8 lg:p-10 shadow-xl border border-transparent flex flex-col justify-center relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 h-full min-h-[250px]"
            >
              <!-- Image background -->
              <div
                class="absolute inset-0 bg-[url('/images/soluciones/conveyors/conveyor-5.webp')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"
              >
              </div>
              <!-- Overlay azul -->
              <div
                class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"
              >
              </div>

              <div
                class="absolute top-6 right-6 lg:top-8 lg:right-8 w-14 h-14 bg-brand-lime/20 text-brand-lime rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 z-20"
              >
                <svg
                  class="w-7 h-7"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                  <path d="M21 12H3M12 3v18"></path>
                </svg>
              </div>
              <div class="relative z-10">
                <h3
                  class="font-saira font-semibold italic text-white text-2xl uppercase leading-tight pr-16 mb-6"
                >
                  Automatización y Power & Free

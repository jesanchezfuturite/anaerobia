---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import { getEntry } from "astro:content";

// Obtener datos de la página de inicio para reutilizar logos de normativas
const homepageEntry = await getEntry("homepage", "index");
const homepageData = homepageEntry?.data || {};
const certificados = homepageData.normativas?.certificados || [
  { name: "NFPA", logo: "/images/home/certificaciones/nfpa.png" },
  { name: "EPA", logo: "/images/home/certificaciones/epa.svg" },
  { name: "ETL", logo: "/images/home/certificaciones/etl.png" },
  { name: "ICC", logo: "/images/home/certificaciones/icc.png" },
  { name: "OSHA", logo: "/images/home/certificaciones/osha.png" },
];

// SEO Metadata
const seoTitle = "Sistemas de Pintura Líquida Industriales | Anaerobia";
const seoDescription =
  "Diseño, fabricación e instalación de sistemas integrales de pintura líquida manuales y automatizados. Soluciones llave en mano de alto volumen.";
---

<Layout title={seoTitle} description={seoDescription}>
  <main class="bg-industrial-gray min-h-screen text-brand-navy">
    <!-- 01. HEADER / HERO -->
    <section
      class="relative min-h-[60vh] flex items-center pt-36 pb-20 bg-brand-navy overflow-hidden"
    >
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0 z-0">
        <img
          src="/images/soluciones/pintura_liquida_1.webp"
          alt="Línea de Pintura Líquida Industrial"
          class="w-full h-full object-cover opacity-30 mix-blend-luminosity scale-105"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/85 to-brand-navy/60"
        >
        </div>
      </div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl hero-section-text">
          <!-- Breadcrumbs -->
          <nav
            class="flex items-center gap-2 text-xs md:text-sm text-gray-400 font-semibold uppercase tracking-widest mb-6"
          >
            <a href="/" class="hover:text-brand-lime transition-colors"
              >Inicio</a
            >
            <span>/</span>
            <span class="text-gray-500">Soluciones</span>
            <span>/</span>
            <span class="text-brand-lime">Pintura Líquida</span>
          </nav>

          <span
            class="inline-block bg-brand-lime/10 text-brand-lime border border-brand-lime/20 rounded px-3 py-1 text-xs font-semibold uppercase tracking-widest mb-6"
          >
            Integración de Acabados Superficiales
          </span>
          <h1
            class="text-white font-saira italic font-semibold uppercase text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] mb-6"
          >
            Sistemas de Pintura Líquida
          </h1>
          <p
            class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed"
          >
            Especialistas en el diseño, fabricación, instalación y puesta en
            marcha de sistemas integrales de pintura líquida, desde cabinas
            manuales hasta líneas completamente programables y automatizadas.
          </p>
        </div>
      </div>
    </section>

    <!-- 02. INTRODUCCIÓN -->
    <section
      class="py-24 bg-white px-6 md:px-12 relative overflow-hidden"
      id="introduccion"
    >
      <div class="container mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="space-y-8 intro-text">
            <div>
              <span
                class="text-brand-blue font-bold text-xs uppercase tracking-widest block mb-2"
                >Ingeniería y Tecnología</span
              >
              <h2
                class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mb-6 leading-tight"
              >
                Mejoramos la industria del mundo con ingeniería especializada y
                alta tecnología
              </h2>
              <p
                class="text-gray-600 leading-relaxed font-light text-base md:text-lg"
              >
                Un sistema de pintura líquida engloba un conjunto de equipos,
                procesos y tecnologías que se utilizan para aplicar
                recubrimientos líquidos sobre superficies de diversos
                materiales. Estos sistemas permiten proteger la superficie de la
                corrosión, mejorar la apariencia estética y cumplir con otros
                requisitos funcionales rigurosos de los productos terminados en
                cualquier industria.
              </p>
            </div>

            <!-- Key pillars (Experiencia, Soporte local, Normativa) -->
            <div
              class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-gray-100"
            >
              <div class="space-y-2">
                <div
                  class="flex items-center justify-center w-10 h-10 rounded bg-brand-lime/10 text-brand-lime"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    ></path>
                  </svg>
                </div>
                <h3
                  class="font-saira font-semibold italic text-brand-navy text-base uppercase"
                >
                  Experiencia
                </h3>
                <p class="text-xs text-gray-500 leading-relaxed">
                  Nuestro equipo cuenta con la preparación y experiencia
                  necesaria para afrontar los desafíos de la industria.
                </p>
              </div>

              <div class="space-y-2">
                <div
                  class="flex items-center justify-center w-10 h-10 rounded bg-brand-blue/10 text-brand-blue"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    ></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </div>
                <h3
                  class="font-saira font-semibold italic text-brand-navy text-base uppercase"
                >
                  Soporte Nacional
                </h3>
                <p class="text-xs text-gray-500 leading-relaxed">
                  Estamos presentes en los centros industriales del país para
                  dar acompañamiento cercano y puntual a nuestros clientes.
                </p>
              </div>

              <div class="space-y-2">
                <div
                  class="flex items-center justify-center w-10 h-10 rounded bg-brand-navy/10 text-brand-navy"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    ></path>
                  </svg>
                </div>
                <h3
                  class="font-saira font-semibold italic text-brand-navy text-base uppercase"
                >
                  Normativa
                </h3>
                <p class="text-xs text-gray-500 leading-relaxed">
                  Nuestros equipos cumplen con normativas internacionales y
                  nacionales.
                </p>
              </div>
            </div>
          </div>

          <!-- Intro Image -->
          <div class="relative intro-image group">
            <div
              class="absolute -inset-4 bg-brand-lime/10 rounded-xl transform rotate-2 transition-transform group-hover:rotate-1 duration-500"
            >
            </div>
            <div
              class="relative rounded-lg overflow-hidden shadow-2xl border border-gray-100 bg-gray-50"
            >
              <img
                src="/images/soluciones/pintura_liquida_2.webp"
                alt="Proceso de Pintura Líquida Automatizada"
                class="w-full h-auto object-cover transform hover:scale-[1.02] transition-transform duration-700"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 03. PROBLEMA / NECESIDAD (PAIN POINTS) -->
    <section
      class="py-24 bg-industrial-gray px-6 md:px-12 border-t border-gray-200/50"
    >
      <div class="container mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 pain-points-header">
          <span
            class="text-brand-lime font-bold text-xs uppercase tracking-widest block mb-2 bg-brand-navy text-white px-3 py-1 rounded-full w-fit mx-auto"
            >Desafíos</span
          >
          <h2
            class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4"
          >
            Puntos de Inflexión Comunes en la Línea de Pintura
          </h2>
          <p class="text-gray-600 mt-4 font-light">
            Las operaciones de manufactura de alto volumen a menudo enfrentan
            ineficiencias críticas que elevan el costo por pieza y afectan la
            calidad estética final.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pain-points-grid">
          <!-- Card 1 -->
          <div
            class="bg-white p-8 rounded-xl border border-gray-200/60 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group"
          >
            <div class="space-y-4">
              <div
                class="w-12 h-12 rounded bg-red-50 text-red-500 flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"
                  ></path>
                </svg>
              </div>
              <h3
                class="font-saira font-semibold italic text-brand-navy text-xl uppercase group-hover:text-brand-blue transition-colors"
              >
                Baja Eficiencia de Transferencia
              </h3>
              <p class="text-sm text-gray-500 leading-relaxed font-light">
                El exceso de pintura desperdiciada (overspray) no solo eleva los
                costos operativos de materia prima, sino que satura los filtros
                rápidamente e incrementa los desechos químicos.
              </p>
            </div>
            <div
              class="pt-6 border-t border-gray-100 mt-6 text-xs font-semibold text-red-500 flex items-center gap-1"
            >
              <span>Impacto: Desperdicio de pintura de hasta un 60%</span>
            </div>
          </div>

          <!-- Card 2 -->
          <div
            class="bg-white p-8 rounded-xl border border-gray-200/60 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group"
          >
            <div class="space-y-4">
              <div
                class="w-12 h-12 rounded bg-orange-50 text-orange-500 flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
              </div>
              <h3
                class="font-saira font-semibold italic text-brand-navy text-xl uppercase group-hover:text-brand-blue transition-colors"
              >
                Altos Costos de Energía
              </h3>
              <p class="text-sm text-gray-500 leading-relaxed font-light">
                El curado o secado térmico ineficiente en hornos que no retienen
                el calor o cabinas con exceso de ventilación desbalanceada
                dispara el consumo eléctrico y de gas natural.
              </p>
            </div>
            <div
              class="pt-6 border-t border-gray-100 mt-6 text-xs font-semibold text-orange-500 flex items-center gap-1"
            >
              <span>Impacto: Sobrecosto térmico e ineficiencia eléctrica</span>
            </div>
          </div>

          <!-- Card 3 -->
          <div
            class="bg-white p-8 rounded-xl border border-gray-200/60 shadow-sm hover:shadow-md transition-shadow flex flex-col justify-between group"
          >
            <div class="space-y-4">
              <div
                class="w-12 h-12 rounded bg-yellow-50 text-yellow-600 flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"
                  ></path>
                </svg>
              </div>
              <h3
                class="font-saira font-semibold italic text-brand-navy text-xl uppercase group-hover:text-brand-blue transition-colors"
              >
                Defectos de Acabado (Clase A)
              </h3>
              <p class="text-sm text-gray-500 leading-relaxed font-light">
                Variación de espesor, ojos de pescado por grasa remanente, y
                desprendimientos por pretratamientos mal controlados derivan en
                altos porcentajes de rechazo y retrabajos costosos.
              </p>
            </div>
            <div
              class="pt-6 border-t border-gray-100 mt-6 text-xs font-semibold text-yellow-600 flex items-center gap-1"
            >
              <span>Impacto: Tasa de rechazo y retrabajos elevados</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 04. PRIMER CTA PERSONALIZADO -->
    <section class="py-12 bg-brand-navy relative overflow-hidden">
      <div
        class="absolute inset-0 bg-gradient-to-r from-brand-navy via-brand-navy to-brand-blue/50 opacity-90"
      >
      </div>
      <div
        class="container mx-auto px-6 relative z-10 flex flex-col md:flex-row items-center justify-between gap-8"
      >
        <div class="text-left">
          <h2
            class="text-white text-2xl md:text-3xl font-saira italic font-semibold uppercase"
          >
            ¿Requieres automatizar o diseñar tu línea de pintura líquida?
          </h2>
          <p
            class="text-gray-300 text-sm md:text-base font-light mt-2 max-w-xl"
          >
            Diseñamos un sistema a la medida adaptado a los alcances específicos
            de tu producción.
          </p>
        </div>
        <a
          href="/#contacto?solucion=pintura-liquida"
          class="bg-brand-lime text-brand-navy font-bold uppercase tracking-widest px-8 py-4 rounded hover:brightness-110 transition-all shadow-lg shrink-0 text-center"
        >
          Solicitar Cotización
        </a>
      </div>
    </section>

    <!-- 05. SOLUCIÓN ANAEROBIA (NUESTRA INGENIERÍA) -->
    <section
      class="py-24 bg-white px-6 md:px-12 relative overflow-hidden"
      id="ingenieria"
    >
      <div class="container mx-auto">
        <div class="max-w-3xl mb-20 section-solucion-header">
          <span
            class="text-brand-blue font-bold text-xs uppercase tracking-widest block mb-2"
            >Integrador Especializado</span
          >
          <h2
            class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-2"
          >
            Nuestra Solución en Ingeniería de Pintura Líquida
          </h2>
          <p class="text-gray-600 font-light mt-4">
            Diseñamos y fabricamos líneas completas "llave en mano" adaptadas a
            los requisitos físicos de tu planta, la geometría de tus piezas y
            los estándares químicos del recubrimiento.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 text-left">
          <!-- Item 1 -->
          <div class="space-y-4 border-l-2 border-brand-lime pl-6 py-2">
            <h3
              class="font-saira font-semibold italic text-brand-navy text-xl uppercase"
            >
              Diseño Manual o Programable
            </h3>
            <p class="text-sm text-gray-500 font-light leading-relaxed">
              Desde cabinas de aplicación por batch y pistolas manuales
              asistidas, hasta sistemas automatizados con transportadores aéreos
              de velocidad variable y reciprocadores inteligentes para altos
              volúmenes de producción.
            </p>
          </div>

          <!-- Item 2 -->
          <div class="space-y-4 border-l-2 border-brand-blue pl-6 py-2">
            <h3
              class="font-saira font-semibold italic text-brand-navy text-xl uppercase"
            >
              Control Ambiental en Cabinas
            </h3>
            <p class="text-sm text-gray-500 font-light leading-relaxed">
              Garantizamos acabados Clase A integrando cabinas de pintura
              líquida presurizadas con flujo de aire laminado y sistemas de
              climatización (HVAC) para controlar de forma exacta la temperatura
              y el porcentaje de humedad.
            </p>
          </div>

          <!-- Item 3 -->
          <div class="space-y-4 border-l-2 border-brand-navy pl-6 py-2">
            <h3
              class="font-saira font-semibold italic text-brand-navy text-xl uppercase"
            >
              Mezcla y Suministro Eficiente
            </h3>
            <p class="text-sm text-gray-500 font-light leading-relaxed">
              Integramos cocinas de pintura con sistemas de almacenamiento y
              bombeo neumático o eléctrico, incorporando cambiadores rápidos de
              color y dosificadores electrónicos bicomponentes (2K/3K) de alta
              precisión.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 06. DIFERENCIADORES ANAEROBIA -->
    <section
      class="py-24 bg-white px-6 md:px-12 border-t border-gray-100 relative overflow-hidden"
      id="diferenciadores"
    >
      <div class="container mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 diferenciadores-header">
          <span
            class="text-brand-blue font-bold text-xs uppercase tracking-widest block mb-2"
            >Ventajas Competitivas</span
          >
          <h2
            class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-2"
          >
            Diferenciadores de Anaerobia en Pintura Líquida
          </h2>
          <p class="text-gray-600 font-light mt-4">
            Nuestra ingeniería destaca por resolver los desafíos más exigentes
            en acabados industriales con un enfoque integral.
          </p>
        </div>

        <div
          class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 diferenciadores-grid"
        >
          <!-- Card 1 -->
          <div
            class="bg-industrial-gray p-8 rounded-xl border border-gray-200/60 shadow-sm hover:shadow-md transition-shadow group flex flex-col justify-between"
          >
            <div class="space-y-4">
              <div
                class="w-12 h-12 rounded bg-brand-lime/10 text-brand-lime flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"
                  ></path>
                </svg>
              </div>
              <h3
                class="font-saira font-semibold italic text-brand-navy text-xl uppercase group-hover:text-brand-blue transition-colors"
              >
                Ingeniería Llave en Mano
              </h3>
              <p class="text-sm text-gray-500 leading-relaxed font-light">
                Diseñamos, fabricamos e instalamos de manera centralizada. Un
                solo punto de contacto para todo tu proyecto de pintura.
              </p>
            </div>
          </div>

          <!-- Card 2 -->
          <div
            class="bg-industrial-gray p-8 rounded-xl border border-gray-200/60 shadow-sm hover:shadow-md transition-shadow group flex flex-col justify-between"
          >
            <div class="space-y-4">
              <div
                class="w-12 h-12 rounded bg-brand-blue/10 text-brand-blue flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <h3
                class="font-saira font-semibold italic text-brand-navy text-xl uppercase group-hover:text-brand-blue transition-colors"
              >
                Soporte y Refacciones
              </h3>
              <p class="text-sm text-gray-500 leading-relaxed font-light">
                Respuesta técnica local inmediata y refaccionamiento garantizado
                para asegurar la continuidad de tu operación.
              </p>
            </div>
          </div>

          <!-- Card 3 -->
          <div
            class="bg-industrial-gray p-8 rounded-xl border border-gray-200/60 shadow-sm hover:shadow-md transition-shadow group flex flex-col justify-between"
          >
            <div class="space-y-4">
              <div
                class="w-12 h-12 rounded bg-brand-navy/10 text-brand-navy flex items-center justify-center"

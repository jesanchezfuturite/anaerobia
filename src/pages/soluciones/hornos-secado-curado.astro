        <!-- 12. FAQ (PREGUNTAS FRECUENTES) -->
        <section class="py-16 bg-industrial-gray px-6 md:px-12 border-b border-gray-200/50" id="faq">
            <div class="container mx-auto max-w-4xl">
                <div class="text-center mb-16 faq-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full"> Preguntas Técnicas </span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Preguntas Frecuentes</h2>
                </div>

                <div class="space-y-4">
                    <!-- FAQ 1 -->
                    <details name="faq" class="group border border-gray-300/80 rounded-xl bg-white overflow-hidden transition-all duration-300 open:shadow-md" open>
                        <summary class="flex justify-between items-center px-6 py-5 font-saira font-semibold italic text-brand-navy uppercase text-base md:text-lg cursor-pointer hover:bg-gray-50 transition-colors list-none select-none">
                            <span>¿Cuál es la diferencia entre secado y curado en pintura industrial?</span>
                            <span class="w-6 h-6 rounded-full bg-brand-navy/5 flex items-center justify-center text-brand-navy font-bold text-xl after:content-['+'] group-open:after:content-['-']"></span>
                        </summary>
                        <div class="px-6 pb-6 pt-2 border-t border-gray-100 text-gray-600 font-light text-base leading-relaxed details-content-reveal">
                            En pintura industrial, el secado, químico o físico, es donde se evapora el agua del pretratamiento o solventes y agua de recubrimientos, dejándola seca al tacto. El curado, en cambio, es un proceso químico en el que los componentes de la pintura reaccionan para formar una
                            película resistente y completamente endurecida. Mientras el secado prepara la superficie, el curado garantiza su durabilidad, adherencia y resistencia final.
                        </div>
                    </details>

                    <!-- FAQ 2 -->
                    <details name="faq" class="group border border-gray-300/80 rounded-xl bg-white overflow-hidden transition-all duration-300 open:shadow-md">
                        <summary class="flex justify-between items-center px-6 py-5 font-saira font-semibold italic text-brand-navy uppercase text-base md:text-lg cursor-pointer hover:bg-gray-50 transition-colors list-none select-none">
                            <span>¿Cuánto tiempo tarda en curar la pintura en horno industrial?</span>
                            <span class="w-6 h-6 rounded-full bg-brand-navy/5 flex items-center justify-center text-brand-navy font-bold text-xl after:content-['+'] group-open:after:content-['-']"></span>
                        </summary>
                        <div class="px-6 pb-6 pt-2 border-t border-gray-100 text-gray-600 font-light text-base leading-relaxed details-content-reveal">
                            El tiempo de curado depende del tipo de recubrimiento y la temperatura aplicada, pero generalmente varía entre 10 y 60 minutos. En el caso de pinturas líquidas como epóxicas o poliuretanos, el curado suele realizarse entre 20 a 60 minutos. Para pinturas en polvo, el proceso
                            suele ser rápido, con tiempos de 10 a 30 minutos a temperaturas de 160 °C a 200 °C.
                        </div>
                    </details>

                    <!-- FAQ 3 -->
                    <details name="faq" class="group border border-gray-300/80 rounded-xl bg-white overflow-hidden transition-all duration-300 open:shadow-md">
                        <summary class="flex justify-between items-center px-6 py-5 font-saira font-semibold italic text-brand-navy uppercase text-base md:text-lg cursor-pointer hover:bg-gray-50 transition-colors list-none select-none">
                            <span>¿Qué mantenimiento requiere un horno de secado y curado?</span>
                            <span class="w-6 h-6 rounded-full bg-brand-navy/5 flex items-center justify-center text-brand-navy font-bold text-xl after:content-['+'] group-open:after:content-['-']"></span>
                        </summary>
                        <div class="px-6 pb-6 pt-2 border-t border-gray-100 text-gray-600 font-light text-base leading-relaxed details-content-reveal">
                            Un horno de secado y curado requiere mantenimiento regular que incluya la limpieza de filtros, ventiladores y conductos para evitar acumulación de polvo o residuos inflamables; inspección y calibración de sensores de temperatura y sistemas de control para asegurar un
                            calentamiento uniforme; verificación del aislamiento térmico y sellos para evitar fugas de calor; revisión de quemadores o resistencias eléctricas; y pruebas de seguridad en sistemas de corte de gas o electricidad.
                        </div>
                    </details>

                    <!-- FAQ 4 -->
                    <details name="faq" class="group border border-gray-300/80 rounded-xl bg-white overflow-hidden transition-all duration-300 open:shadow-md">
                        <summary class="flex justify-between items-center px-6 py-5 font-saira font-semibold italic text-brand-navy uppercase text-base md:text-lg cursor-pointer hover:bg-gray-50 transition-colors list-none select-none">
                            <span>¿Cómo elegir el horno de secado y curado adecuado para mi empresa?</span>
                            <span class="w-6 h-6 rounded-full bg-brand-navy/5 flex items-center justify-center text-brand-navy font-bold text-xl after:content-['+'] group-open:after:content-['-']"></span>
                        </summary>
                        <div class="px-6 pb-6 pt-2 border-t border-gray-100 text-gray-600 font-light text-base leading-relaxed details-content-reveal">
                            Para elegir el horno adecuado, considera el tipo de material y recubrimiento (líquido, en polvo, epóxico, etc.), el volumen de producción diario, las dimensiones, el peso de las piezas y el espacio disponible en tu planta. Evalúa la temperatura y el tiempo de curado
                            requeridos para determinar si necesitas un horno de convección, catalítico o infrarrojo. Un proveedor especializado como Anaerobia puede diseñar y personalizar la rampa térmica exacta para tu proceso.
                        </div>
                    </details>
                </div>
            </div>
        </section>
    </main>
</Layout>

<!-- CDNs y Configuración de Animación Scroll / Lenis -->
<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        // 1. Inicializar Lenis (Scroll Suave)
        if (typeof Lenis !== 'undefined') {
            const lenis = new Lenis({
                duration: 1.2,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                smoothWheel: true,
            })
            function raf(time) {
                lenis.raf(time)
                requestAnimationFrame(raf)
            }
            requestAnimationFrame(raf)

            // 2. Conectar GSAP con Lenis y animar
            if (typeof gsap !== 'undefined') {
                gsap.ticker.add((time) => {
                    lenis.raf(time * 1000)
                })
                gsap.ticker.lagSmoothing(0)

                if (typeof ScrollTrigger !== 'undefined') {
                    lenis.on('scroll', ScrollTrigger.update)
                }
            }
        }

        // Animaciones GSAP
        if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
            // Animación Hero al cargar
            gsap.from('.hero-section-text > *', {
                y: 35,
                opacity: 0,
                duration: 1,
                stagger: 0.15,
                ease: 'power3.out',
            })

            // Animación Introducción
            gsap.from('.intro-text > *', {
                scrollTrigger: { trigger: '#introduccion', start: 'top 80%' },
                y: 30,
                opacity: 0,
                duration: 0.8,
                stagger: 0.12,
                ease: 'power2.out',
            })
            gsap.from('.intro-image', {
                scrollTrigger: { trigger: '#introduccion', start: 'top 80%' },
                x: 40,
                opacity: 0,
                duration: 0.9,
                ease: 'power2.out',
            })

            // Pain points grid
            gsap.from('.pain-points-grid > div', {
                scrollTrigger: { trigger: '.pain-points-grid', start: 'top 85%' },
                y: 40,
                opacity: 0,
                duration: 0.8,
                stagger: 0.15,
                ease: 'power2.out',
            })

            // Ingeniería grid (Bento)
            gsap.from('#ingenieria .grid > div', {
                scrollTrigger: { trigger: '#ingenieria', start: 'top 80%' },
                y: 30,
                opacity: 0,
                duration: 0.7,
                stagger: 0.15,
                ease: 'power2.out',
                clearProps: 'all',
            })

            // Diferenciadores grid
            gsap.from('.diferenciadores-grid > div', {
                scrollTrigger: { trigger: '.diferenciadores-grid', start: 'top 85%' },
                y: 30,
                opacity: 0,
                duration: 0.7,
                stagger: 0.15,
                ease: 'power2.out',
            })

            // Especificaciones (Tabs)
            gsap.from('#datos-tecnicos table, #datos-tecnicos .grid > div', {
                scrollTrigger: { trigger: '#datos-tecnicos', start: 'top 80%' },
                y: 40,
                opacity: 0,
                duration: 0.8,
                stagger: 0.15,
                ease: 'power2.out',
            })

            // Resultados
            gsap.from('.animate-results .grid > div', {
                scrollTrigger: { trigger: '.animate-results', start: 'top 80%' },
                y: 30,
                opacity: 0,
                duration: 0.8,
                stagger: 0.15,
                ease: 'power2.out',
            })

            // Normativas text
            gsap.from('.norms-text > *', {
                scrollTrigger: { trigger: '#normas', start: 'top 80%' },
                y: 30,
                opacity: 0,
                duration: 0.8,
                stagger: 0.12,
                ease: 'power2.out',
            })

            // Normativas grid
            gsap.from('.norms-grid > div', {
                scrollTrigger: { trigger: '.norms-grid', start: 'top 85%' },
                y: 20,
                opacity: 0,
                duration: 0.6,
                stagger: 0.1,
                ease: 'power2.out',
                clearProps: 'opacity,transform',
            })

            // FAQ list
            gsap.from('#faq details', {
                scrollTrigger: { trigger: '#faq', start: 'top 80%' },
                y: 20,
                opacity: 0,
                duration: 0.6,
                stagger: 0.1,
                ease: 'power2.out',
                clearProps: 'opacity,transform',
            })
        }

        // 3. Controlador de Tabs Técnicos
        const tabBtns = document.querySelectorAll('.tech-tab-btn')
        const tabPanels = document.querySelectorAll('.tech-tab-panel')

        tabBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
                const targetTabId = btn.getAttribute('data-tab')

                tabBtns.forEach((b) => {
                    b.classList.remove('active', 'border-brand-lime', 'text-brand-lime', 'bg-brand-lime/10')
                    b.classList.add('border-transparent', 'text-gray-400', 'bg-transparent')
                })

                btn.classList.add('active', 'border-brand-lime', 'text-brand-lime', 'bg-brand-lime/10')
                btn.classList.remove('border-transparent', 'text-gray-400', 'bg-transparent')

                tabPanels.forEach((panel) => {
                    panel.classList.add('hidden', 'opacity-0', 'translate-y-4')
                    panel.classList.remove('opacity-100', 'translate-y-0')
                })

                const activePanel = document.getElementById(targetTabId)
                if (activePanel) {
                    activePanel.classList.remove('hidden')
                    setTimeout(() => {
                        activePanel.classList.remove('opacity-0', 'translate-y-4')
                        activePanel.classList.add('opacity-100', 'translate-y-0')
                    }, 20)
                }

                if (typeof ScrollTrigger !== 'undefined') {
                    ScrollTrigger.refresh()
                }
            })
        })

        // Inicializar Marquee Swiper
        if (typeof Swiper !== 'undefined') {
            new Swiper('.marquee-swiper', {
                loop: true,
                speed: 3000,
                autoplay: { delay: 0, disableOnInteraction: false },
                slidesPerView: 'auto',
                spaceBetween: 10,
                allowTouchMove: false,
                freeMode: true,
            })
        }
    })

    // Refrescar ScrollTrigger al cargar completamente la página
    window.addEventListener('load', () => {
        if (typeof ScrollTrigger !== 'undefined') {
            ScrollTrigger.refresh()
        }
    })
</script>

---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import { getEntry } from 'astro:content'
import fallback from '../../data/soluciones/hornos-secado-curado.json'

// Obtener datos de la página de inicio para reutilizar logos de normativas
const homepageEntry = await getEntry('homepage', 'index')
const homepageData = homepageEntry?.data || {}
const certificados = homepageData.normativas?.certificados || [
    { name: 'NFPA', logo: '/images/home/certificaciones/nfpa.png' },
    { name: 'EPA', logo: '/images/home/certificaciones/epa.svg' },
    { name: 'ETL', logo: '/images/home/certificaciones/etl.png' },
    { name: 'ICC', logo: '/images/home/certificaciones/icc.png' },
    { name: 'OSHA', logo: '/images/home/certificaciones/osha.png' },
]

// Contenido administrable: se consulta la API del Admin (Laravel) en cada
// visita (SSR). Si la API no responde, se usa el respaldo local (fallback).
const API_URL = import.meta.env.ADMIN_API_URL ?? 'http://127.0.0.1:8000'
let d = fallback
try {
    const res = await fetch(`${API_URL}/api/v1/soluciones/hornos-secado-curado`, { signal: AbortSignal.timeout(5000) })
    if (res.ok) d = (await res.json()).data
} catch {
    // API no disponible: la página se sirve con el contenido de respaldo
}

// SEO Metadata
const seoTitle = d.seo?.title
const seoDescription = d.seo?.description

// Alturas para alinear las tarjetas de la sección Desafíos (diseño fijo)
const desafioCardHeights = ['lg:h-[32%] min-h-[100px]', 'lg:h-[36%] min-h-[120px]', 'lg:h-[32%] min-h-[100px]']
// Iconos (SVG paths) de los items de Desafíos
const desafioIcons = [
    'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
    'M13 10V3L4 14h7v7l9-11h-7z',
    'M7 13v-8a1 1 0 0 0 -1 -1h-2a1 1 0 0 0 -1 1v7a1 1 0 0 0 1 1h3a4 4 0 0 1 4 4v1a2 2 0 0 0 4 0v-5h3a2 2 0 0 0 2 -2l-1 -5a2 3 0 0 0 -2 -2h-7a3 3 0 0 0 -3 3',
]
// Iconos (SVG paths) de las tarjetas de Diferenciadores
const diferenciadorIcons = [
    'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
    'M13 10V3L4 14h7v7l9-11h-7z',
    'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
    'M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10',
]
// Iconos (SVG paths) de los items de cada pestaña de información técnica
const tipoItemIcons = [
    [
        'M12 3v19M3 12h19M5 5l14 14M19 5L5 19',
        'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z',
        'M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.656 48.656 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7C4.547 9.547 4.5 10.768 4.5 12s.047 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.092-1.209.138-2.43.138-3.662z',
    ],
    [
        'M19.5 12h-15m0 0l3-3m-3 3l3 3',
        'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z',
        'M2.25 15a4.5 4.5 0 004.5 4.5H18a3.75 3.75 0 001.332-7.365 5.25 5.25 0 00-9.88-2.32 4.5 4.5 0 00-7.202 5.185Z',
    ],
    [
        'M12 3v19',
        'M13 10V3L4 14h7v7l9-11h-7z',
        'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h2a2 2 0 002-2z',
    ],
]
// Iconos (contenido SVG) de las tarjetas de Resultados / Importancia
const resultadoIcons = [
    '<path d="M13 3v7h6l-8 11v-7H5l8-11z"></path>',
    '<circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 3"></path>',
    '<path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>',
]
---

<Layout title={seoTitle} description={seoDescription}>
    <main class="bg-industrial-gray min-h-screen text-brand-navy">
        <!-- 01. HEADER / HERO -->
        <section class="relative min-h-[60vh] flex items-center pt-36 pb-20 bg-brand-navy overflow-hidden">
            <!-- Background Image with Overlay -->
            <div class="absolute inset-0 z-0">
                <img src={d.hero.image} alt={d.hero.title} class="w-full h-full object-cover opacity-60 scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/85 to-brand-navy/60"></div>
            </div>

            <div class="container mx-auto px-6 relative z-10">
                <div class="max-w-4xl hero-section-text">
                    <!-- Breadcrumbs -->
                    <nav class="flex items-center gap-2 text-xs md:text-sm text-gray-400 font-semibold uppercase tracking-widest mb-6">
                        <a href="/" class="text-gray-300 hover:text-brand-lime transition-colors">Inicio</a>
                        <span>/</span>
                        <span class="text-gray-400">Soluciones</span>
                        <span>/</span>
                        <span class="text-brand-lime">Hornos de Secado y Curado</span>
                    </nav>

                    <span class="inline-block bg-brand-lime/10 text-brand-lime border border-brand-lime/20 rounded px-3 py-1 text-xs font-semibold uppercase tracking-widest mb-6">{d.hero.badge}</span>
                    <h1 class="text-white font-saira italic font-semibold uppercase text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] mb-6">{d.hero.title}</h1>
                    <p class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed">{d.hero.description}</p>
                </div>
            </div>
        </section>

        <!-- 02. INTRODUCCIÓN -->
        <section class="py-16 bg-white px-6 md:px-12 relative overflow-hidden" id="introduccion">
            <div class="container mx-auto">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                    <div class="space-y-8 intro-text">
                        <div>
                            <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Ingeniería y tecnología</span>
                            <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4 mb-6 leading-tight">{d.intro.title}</h2>
                            {
                                d.intro.paragraphs.map((p, i) => (
                                    <p class={`text-gray-600 leading-relaxed font-light text-base${i === 0 ? ' md:text-lg' : ''}${i < d.intro.paragraphs.length - 1 ? ' mb-4' : ''}`}>{p.text}</p>
                                ))
                            }
                            <p class="text-brand-navy font-saira font-bold uppercase italic mt-6 border-l-4 border-brand-lime pl-4 md:text-lg">{d.intro.highlight}</p>
                        </div>
                    </div>

                    <!-- Intro Image -->
                    <div class="relative intro-image group">
                        <div class="relative rounded-lg overflow-hidden shadow-2xl">
                            <img src={d.intro.image} alt={d.intro.title} class="w-full h-auto object-cover transform hover:scale-[1.02] transition-transform duration-700" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 03. PROBLEMA / NECESIDAD (PAIN POINTS) -->
        <section class="py-16 bg-industrial-gray px-6 md:px-12 border-t border-gray-200/50">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 pain-points-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.desafios.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">{d.desafios.title}</h2>
                    <p class="text-gray-600 mt-4 font-light">{d.desafios.description}</p>
                </div>

                <div class="flex flex-col lg:flex-row gap-8 lg:h-[600px] w-full max-w-7xl mx-auto pain-points-grid items-stretch">
                    <!-- Column 1: Image (45%) -->
                    <div class="w-full lg:w-[45%] relative rounded-3xl overflow-hidden shadow-2xl h-[400px] lg:h-auto shrink-0 group">
                        <img src={d.desafios.image} alt={d.desafios.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-navy/30 mix-blend-multiply"></div>
                    </div>

                    <!-- Column 2: Cards (20%) -->
                    <div class="w-full lg:w-[20%] flex flex-col justify-between gap-4 shrink-0 h-full">
                        {
                            d.desafios.tarjetas.map((t, i) => (
                                <div class={`relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 ${desafioCardHeights[i] ?? 'lg:h-[32%] min-h-[100px]'}`}>
                                    <p class="text-lg lg:text-xl font-saira font-bold italic text-brand-blue leading-snug text-center">{t.text}</p>
                                </div>
                            ))
                        }
                    </div>

                    <!-- Column 3: Content (35%) -->
                    <div class="w-full lg:w-[35%] flex flex-col justify-center space-y-10 shrink-0 lg:pl-2">
                        {
                            d.desafios.items.map((item, i) => (
                                <div class="space-y-3">
                                    <div class="flex items-center gap-3">
                                        <div class="text-brand-lime shrink-0">
                                            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={desafioIcons[i] ?? desafioIcons[0]} />
                                            </svg>
                                        </div>
                                        <h3 class="font-saira font-bold italic text-brand-navy text-xl md:text-2xl uppercase">{item.title}</h3>
                                    </div>
                                    <p class="text-base text-gray-600 leading-relaxed font-light">{item.description}</p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- 04. PRIMER CTA PERSONALIZADO -->
        <section class="py-16 bg-brand-navy relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-brand-navy via-brand-navy to-brand-blue/50 opacity-90"></div>
            <div class="container mx-auto px-6 relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
                <div class="text-left">
                    <h2 class="text-white text-2xl md:text-3xl font-saira italic font-semibold uppercase">{d.cta1.title}</h2>
                    <p class="text-gray-300 text-sm md:text-base font-light mt-2 max-w-xl">{d.cta1.description}</p>
                </div>
                <a href={d.cta1.button_url} class="bg-brand-lime text-brand-navy font-bold uppercase tracking-widest px-8 py-4 rounded hover:brightness-110 transition-all shadow-lg shrink-0 text-center">{d.cta1.button_label}</a>
            </div>
        </section>

        <!-- 05. SOLUCIÓN ANAEROBIA (NUESTRA INGENIERÍA) -->
        <section class="py-16 bg-gradient-to-b from-gray-100 to-white px-6 md:px-12 relative overflow-hidden" id="ingenieria">
            <div class="container mx-auto">
                <div class="max-w-5xl mb-10 section-solucion-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.ingenieria.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">{d.ingenieria.title}</h2>
                    <p class="text-gray-600 font-light mt-4">{d.ingenieria.description}</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-10 text-left items-stretch">
                    <!-- Bento Card 1 (Large Left) -->
                    <div class="bg-brand-navy rounded-3xl p-10 lg:p-14 flex flex-col justify-between relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 shadow-2xl min-h-[500px] h-full">
                        <!-- Image background -->
                        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105" style={`background-image: url('${d.ingenieria.cards[0].image}')`}></div>
                        <!-- Overlay azul -->
                        <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                        <!-- Decorative background element -->
                        <div class="absolute -right-20 -top-20 w-64 h-64 bg-brand-lime opacity-20 blur-3xl rounded-full group-hover:scale-150 transition-transform duration-700"></div>

                        <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-20 h-20 bg-brand-lime/20 text-brand-lime rounded-2xl flex items-center justify-center z-20">
                            <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3q1 4 4 6.5t3 5.5a1 1 0 0 1-14 0 5 5 0 0 1 1-3 1 1 0 0 0 5 0c0-2-1.5-3-1.5-5q0-2 2.5-4"></path>
                            </svg>
                        </div>
                        <div class="relative z-10 mt-auto">
                            <div>
                                <h3 class="font-saira font-semibold italic text-white text-3xl md:text-4xl uppercase mb-4 leading-tight">{d.ingenieria.cards[0].title}</h3>
                                <p class="text-lg text-gray-200 font-light leading-relaxed">
                                    {d.ingenieria.cards[0].description}
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column for Bento Cards 2 & 3 -->
                    <div class="flex flex-col gap-6 h-full">
                        <!-- Bento Card 2 -->
                        <div class="bg-brand-navy rounded-3xl p-8 lg:p-10 flex flex-col justify-center relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 h-full shadow-xl min-h-[250px]">
                            <!-- Image background -->
                            <div class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105" style={`background-image: url('${d.ingenieria.cards[1].image}')`}></div>
                            <!-- Overlay azul -->
                            <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                            <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-14 h-14 bg-brand-lime/20 shadow-sm text-brand-lime rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 z-20">
                                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M11 8c2-3-2-3 0-6"></path>
                                    <path d="M15.5 8c2-3-2-3 0-6"></path>
                                    <path d="M6 10h.01"></path>
                                    <path d="M6 14h.01"></path>
                                    <path d="M10 16v-4"></path>
                                    <path d="M14 16v-4"></path>
                                    <path d="M18 16v-4"></path>
                                    <path d="M20 6a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h3"></path>
                                    <path d="M5 20v2"></path>
                                    <path d="M19 20v2"></path>
                                </svg>
                            </div>
                            <div class="relative z-10">
                                <h3 class="font-saira font-semibold italic text-white text-2xl uppercase leading-tight pr-16 mb-6">{d.ingenieria.cards[1].title}</h3>
                                <p class="text-base text-gray-200 font-light leading-relaxed">{d.ingenieria.cards[1].description}</p>
                            </div>
                        </div>

                        <!-- Bento Card 3 -->
                        <div class="bg-brand-navy rounded-3xl p-8 lg:p-10 shadow-xl border border-transparent flex flex-col justify-center relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 h-full min-h-[250px]">
                            <!-- Image background -->
                            <div class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105" style={`background-image: url('${d.ingenieria.cards[2].image}')`}></div>
                            <!-- Overlay azul -->
                            <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                            <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-14 h-14 bg-brand-lime/20 text-brand-lime rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 z-20">
                                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 12h2m2.5-7.5 1.5 1.5M3 21l5.5-5.5M21 12h-2M17.5 4.5 16 6M21 21l-5.5-5.5"></path>
                                    <circle cx="12" cy="12" r="4"></circle>
                                </svg>
                            </div>
                            <div class="relative z-10">
                                <h3 class="font-saira font-semibold italic text-white text-2xl uppercase leading-tight pr-16 mb-6">{d.ingenieria.cards[2].title}</h3>
                                <p class="text-base text-gray-200 font-light leading-relaxed">{d.ingenieria.cards[2].description}</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 06. DIFERENCIADORES ANAEROBIA (VENTAJAS) -->
        <section class="py-16 bg-white px-6 md:px-12 border-t border-gray-100 relative overflow-hidden" id="diferenciadores">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 diferenciadores-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.extras.diferenciadores.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">{d.extras.diferenciadores.title}</h2>
                    <p class="text-gray-600 font-light mt-4">{d.extras.diferenciadores.description}</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 diferenciadores-grid">
                    {
                        d.extras.diferenciadores.cards.map((card, i) => (
                            <div class="bg-white p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] transition-shadow duration-300 hover:shadow-[0_8px_30px_rgb(0,0,0,0.2)] group flex flex-col justify-between">
                                <div class="space-y-4">
                                    <div class="flex items-center gap-4">
                                        <div class="text-brand-lime flex items-center justify-center shrink-0">
                                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={diferenciadorIcons[i] ?? diferenciadorIcons[0]} />
                                            </svg>
                                        </div>
                                        <h3 class="font-saira font-semibold italic text-brand-navy text-xl uppercase group-hover:text-brand-blue transition-colors leading-tight">{card.title}</h3>
                                    </div>
                                    <p class="text-sm text-gray-500 leading-relaxed font-light">{card.description}</p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 07. INFORMACIÓN TÉCNICA -->
        <section class="py-16 bg-brand-lime/5 px-6 md:px-12 border-y border-gray-200/50 relative overflow-hidden" id="datos-tecnicos">
            <!-- Logo de fondo -->
            <img src="/images/soluciones/fondo-seccion.png" alt="" class="absolute top-1/2 -translate-y-1/2 -right-32 lg:-right-20 w-[400px] lg:w-[600px] opacity-10 invert mix-blend-multiply object-contain pointer-events-none z-0" />

            <div class="container mx-auto relative z-10">
                <div class="mb-16">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.tipos.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase text-center md:text-left mt-4 mb-8">{d.tipos.title}</h2>
                </div>

                <!-- Tabs Navigation -->
                <div class="flex w-full border-b border-gray-200 mb-16 overflow-x-auto" id="tech-tabs-nav">
                    {
                        d.tipos.tabs.map((tab, i) => (
                            <button
                                class={
                                    i === 0
                                        ? 'tech-tab-btn active flex-1 py-4 px-2 border-b-2 border-brand-lime bg-brand-lime/10 rounded-t-xl text-brand-lime flex flex-col items-center justify-center gap-1 cursor-pointer select-none font-saira font-semibold italic text-base md:text-lg uppercase tracking-wider transition-colors min-w-[150px]'
                                        : 'tech-tab-btn flex-1 py-4 px-2 border-b-2 border-transparent bg-transparent rounded-t-xl text-gray-400 hover:text-brand-lime hover:bg-brand-lime/5 flex flex-col items-center justify-center gap-1 cursor-pointer select-none font-saira font-semibold italic text-base md:text-lg uppercase tracking-wider transition-colors min-w-[150px]'
                                }
                                data-tab={`tab-${i}`}
                            >
                                <span class="text-3xl font-light not-italic font-sans">{String(i + 1).padStart(2, '0')}</span>
                                <span>{tab.label}</span>
                            </button>
                        ))
                    }
                </div>

                <!-- Tabs Content Panels -->
                <div id="tech-tabs-content" class="relative w-full">
                    {
                        d.tipos.tabs.map((tab, tabIndex) => (
                            <div id={`tab-${tabIndex}`} class={tabIndex === 0 ? 'tech-tab-panel transition-all duration-500 opacity-100 transform translate-y-0' : 'tech-tab-panel hidden transition-all duration-500 opacity-0 transform translate-y-4'}>
                                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
                                    <div class="w-full relative rounded-3xl overflow-hidden shadow-2xl h-[300px] md:h-[400px] lg:h-full lg:min-h-[550px]">
                                        <img src={tab.image} alt={tab.title} class={`w-full h-full object-cover absolute inset-0${tabIndex === 1 ? ' scale-[1.3]' : ''}`} />
                                        <div class="absolute inset-0 bg-brand-navy/10 mix-blend-multiply" />
                                    </div>

                                    <div class="flex flex-col pb-8">
                                        <div class="mb-10 text-center lg:text-left">
                                            <h3 class="font-saira font-semibold italic text-brand-navy text-3xl md:text-4xl uppercase mb-4">{tab.title}</h3>
                                            <p class="text-base text-gray-600 font-light leading-relaxed">{tab.description}</p>
                                        </div>

                                        <div class="flex flex-col gap-10">
                                            {tab.items.map((item, i) => (
                                                <div class="flex flex-col">
                                                    <div class="flex items-center gap-3 mb-4">
                                                        <div class="text-brand-lime flex items-center justify-center shrink-0">
                                                            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                                                <path stroke-linecap="round" stroke-linejoin="round" d={tipoItemIcons[tabIndex]?.[i] ?? tipoItemIcons[0][0]} />
                                                            </svg>
                                                        </div>
                                                        <h4 class="font-saira font-bold text-brand-navy text-xl uppercase italic">{item.title}</h4>
                                                    </div>
                                                    <p class="text-gray-600 font-light text-sm pl-10 lg:pl-0" set:html={item.description} />
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 08. RESULTADOS Y VENTAJAS -->
        <section class="py-24 bg-white px-6 md:px-12 animate-results" id="ventajas-adicionales">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 advantages-header">
                    <span class="text-brand-lime font-bold tracking-widest text-sm mb-4 uppercase inline-block">{d.resultados.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">{d.resultados.title}</h2>
                    <p class="text-gray-600 mt-4 font-light text-base md:text-lg">
                        {d.resultados.description}
                    </p>
                </div>

                <!-- Quantitative Metrics Grid -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center max-w-5xl mx-auto">
                    {
                        d.resultados.metrics.map((metric, i) => (
                            <div class="p-8 rounded-3xl bg-brand-navy text-white flex flex-col justify-between items-center shadow-lg h-60">
                                <svg class="w-14 h-14 text-brand-lime" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" set:html={resultadoIcons[i] ?? resultadoIcons[0]} />
                                <h4 class="font-saira font-semibold uppercase italic text-sm tracking-wider text-gray-300">{metric.label}</h4>
                                <p class="text-xs text-gray-400 font-light">{metric.description}</p>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 09. SEGUNDO CTA -->
        <section class="py-16 relative flex items-center justify-center overflow-hidden px-6">
            <img src={d.cta2.image} alt={d.cta2.title} class="absolute top-1/2 left-0 w-full h-[130%] -translate-y-1/2 object-cover z-0" />
            <div class="absolute inset-0 bg-brand-navy/90 z-10 mix-blend-multiply"></div>

            <div class="container mx-auto max-w-4xl text-center space-y-6 relative z-20">
                <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-white uppercase tracking-wider">{d.cta2.title}</h2>
                <p class="text-gray-300 font-light text-base md:text-lg max-w-2xl mx-auto">{d.cta2.description}</p>
                <div class="pt-8">
                    <a href={d.cta2.button_url} class="inline-block bg-brand-lime text-brand-navy font-bold uppercase tracking-widest px-10 py-4 rounded hover:bg-white transition-all duration-300 shadow-lg hover:-translate-y-1">{d.cta2.button_label}</a>
                </div>
            </div>
        </section>

        <!-- 10. NORMATIVIDAD -->
        <section class="py-16 bg-brand-navy text-white px-6 md:px-12" id="normas">
            <div class="container mx-auto max-w-6xl">
                <div class="flex flex-col lg:flex-row items-center justify-between gap-12">
                    <div class="lg:w-1/2 space-y-6 norms-text">
                        <div>
                            <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.normatividad.badge}</span>
                            <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-white uppercase mt-4 leading-tight">{d.normatividad.title}</h2>
                            <p class="text-gray-300 font-light leading-relaxed mt-4">
                                {d.normatividad.description}
                            </p>
                        </div>

                        <ul class="space-y-3 text-sm text-gray-300 font-light border-t border-white/10 pt-6 pl-4 mt-6">
                            {
                                d.normatividad.bullets.map((b) => (
                                    <li class="flex items-center gap-2">
                                        <span class="w-2 h-2 rounded-full bg-brand-lime" /> {b.text}
                                    </li>
                                ))
                            }
                        </ul>
                    </div>

                    <div class="lg:w-1/2 w-full">
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 norms-grid">
                            {
                                certificados.map((cert) => (
                                    <div class="bg-white rounded-xl p-4 flex flex-col items-center justify-center shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group border border-transparent hover:border-brand-lime">
                                        <div class="h-14 w-full flex items-center justify-center mb-2">
                                            <img src={cert.logo} alt={`Certificado ${cert.name}`} class="max-h-full max-w-full object-contain filter transition-all duration-300" onerror={`this.outerHTML='<span class=\\'font-bold text-gray-400\\'>${cert.name}</span>'`} />
                                        </div>
                                        <span class="font-saira font-semibold text-[10px] tracking-wider text-brand-navy opacity-60 group-hover:opacity-100 transition-opacity uppercase">{cert.name}</span>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 11. ALIANZAS / PARTNERS -->
        <section class="bg-white py-4 border-y border-gray-200 overflow-hidden flex items-center">
            <div class="container mx-auto px-6 flex flex-col md:flex-row items-center gap-6">
                <span class="text-gray-500 font-medium whitespace-nowrap text-sm mt-1 uppercase tracking-wide"> Tecnología respaldada por aliados globales: </span>
                <div class="swiper marquee-swiper w-full overflow-hidden relative">
                    <div class="swiper-wrapper flex items-center gap-16">
                        <div class="swiper-slide !w-auto px-8">
                            <img src="/img/logos/fanuc.png" alt="FANUC" class="h-4 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>FANUC</span>'" />
                        </div>
                        <div class="swiper-slide !w-auto px-8">
                            <img src="/img/logos/graco.png" alt="GRACO" class="h-4 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>GRACO</span>'" />
                        </div>
                        <div class="swiper-slide !w-auto px-8">
                            <img src="/img/logos/binks.png" alt="BINKS" class="h-4 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>BINKS</span>'" />
                        </div>
                        <div class="swiper-slide !w-auto px-8">
                            <img src="/img/logos/gfs.png" alt="GFS" class="h-9 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>GFS</span>'" />
                        </div>

                        <!-- Duplicate for loop -->
                        <div class="swiper-slide !w-auto px-8">
                            <img src="/img/logos/fanuc.png" alt="FANUC" class="h-4 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>FANUC</span>'" />
                        </div>
                        <div class="swiper-slide !w-auto px-8">
                            <img src="/img/logos/graco.png" alt="GRACO" class="h-4 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>GRACO</span>'" />
                        </div>
                        <div class="swiper-slide !w-auto px-8">
                            <img src="/img/logos/binks.png" alt="BINKS" class="h-4 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>BINKS</span>'" />
                        </div>
                        <div class="swiper-slide !w-auto px-8">
                            <img src="/img/logos/gfs.png" alt="GFS" class="h-9 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>GFS</span>'" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 12. FAQ (PREGUNTAS FRECUENTES) -->
        <section class="py-16 bg-industrial-gray px-6 md:px-12 border-b border-gray-200/50" id="faq">
            <div class="container mx-auto max-w-4xl">
                <div class="text-center mb-16 faq-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.faqs.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">{d.faqs.title}</h2>
                </div>

                <div class="space-y-4">
                    {
                        d.faqs.items.map((faq, i) => (
                            <details name="faq" class="group border border-gray-300/80 rounded-xl bg-white overflow-hidden transition-all duration-300 open:shadow-md" open={i === 0}>
                                <summary class="flex justify-between items-center px-6 py-5 font-saira font-semibold italic text-brand-navy uppercase text-base md:text-lg cursor-pointer hover:bg-gray-50 transition-colors list-none select-none">
                                    <span>{faq.question}</span>
                                    <span class="w-6 h-6 rounded-full bg-brand-navy/5 flex items-center justify-center text-brand-navy font-bold text-xl after:content-['+'] group-open:after:content-['-']" />
                                </summary>
                                <div class="px-6 pb-6 pt-2 border-t border-gray-100 text-gray-600 font-light text-base leading-relaxed details-content-reveal">{faq.answer}</div>
                            </details>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>
</Layout>

<!-- CDNs y Configuración de Animación Scroll / Lenis -->
<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        // 1. Inicializar Lenis (Scroll Suave)
        if (typeof Lenis !== 'undefined') {
            const lenis = new Lenis({
                duration: 1.2,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                smoothWheel: true,
            })
            function raf(time) {
                lenis.raf(time)
                requestAnimationFrame(raf)
            }
            requestAnimationFrame(raf)

            // 2. Conectar GSAP con Lenis y animar
            if (typeof gsap !== 'undefined') {
                gsap.ticker.add((time) => {
                    lenis.raf(time * 1000)
                })
                gsap.ticker.lagSmoothing(0)

                if (typeof ScrollTrigger !== 'undefined') {
                    lenis.on('scroll', ScrollTrigger.update)
                }
            }
        }

        // Animaciones GSAP
        if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
            // Animación Hero al cargar
            gsap.from('.hero-section-text > *', {
                y: 35,
                opacity: 0,
                duration: 1,
                stagger: 0.15,
                ease: 'power3.out',
            })

            // Animación Introducción
            gsap.from('.intro-text > *', {
                scrollTrigger: { trigger: '#introduccion', start: 'top 80%' },
                y: 30,
                opacity: 0,
                duration: 0.8,
                stagger: 0.12,
                ease: 'power2.out',
            })
            gsap.from('.intro-image', {
                scrollTrigger: { trigger: '#introduccion', start: 'top 80%' },
                x: 40,
                opacity: 0,
                duration: 0.9,
                ease: 'power2.out',
            })

            // Pain points grid
            gsap.from('.pain-points-grid > div', {
                scrollTrigger: { trigger: '.pain-points-grid', start: 'top 85%' },
                y: 40,
                opacity: 0,
                duration: 0.8,
                stagger: 0.15,
                ease: 'power2.out',
            })

            // Ingeniería grid (Bento)
            gsap.from('#ingenieria .grid > div', {
                scrollTrigger: { trigger: '#ingenieria', start: 'top 80%' },
                y: 30,
                opacity: 0,
                duration: 0.7,
                stagger: 0.15,
                ease: 'power2.out',
                clearProps: 'all',
            })

            // Diferenciadores grid
            gsap.from('.diferenciadores-grid > div', {
                scrollTrigger: { trigger: '.diferenciadores-grid', start: 'top 85%' },
                y: 30,
                opacity: 0,
                duration: 0.7,
                stagger: 0.15,
                ease: 'power2.out',
            })

            // Especificaciones (Tabs)
            gsap.from('#datos-tecnicos table, #datos-tecnicos .grid > div', {
                scrollTrigger: { trigger: '#datos-tecnicos', start: 'top 80%' },
                y: 40,
                opacity: 0,
                duration: 0.8,
                stagger: 0.15,
                ease: 'power2.out',
            })

            // Resultados
            gsap.from('.animate-results .grid > div', {
                scrollTrigger: { trigger: '.animate-results', start: 'top 80%' },
                y: 30,
                opacity: 0,
                duration: 0.8,
                stagger: 0.15,
                ease: 'power2.out',
            })

            // Normativas text
            gsap.from('.norms-text > *', {
                scrollTrigger: { trigger: '#normas', start: 'top 80%' },
                y: 30,
                opacity: 0,
                duration: 0.8,
                stagger: 0.12,
                ease: 'power2.out',
            })

            // Normativas grid
            gsap.from('.norms-grid > div', {
                scrollTrigger: { trigger: '.norms-grid', start: 'top 85%' },
                y: 20,
                opacity: 0,
                duration: 0.6,
                stagger: 0.1,
                ease: 'power2.out',
                clearProps: 'opacity,transform',
            })

            // FAQ list
            gsap.from('#faq details', {
                scrollTrigger: { trigger: '#faq', start: 'top 80%' },
                y: 20,
                opacity: 0,
                duration: 0.6,
                stagger: 0.1,
                ease: 'power2.out',
                clearProps: 'opacity,transform',
            })
        }

        // 3. Controlador de Tabs Técnicos
        const tabBtns = document.querySelectorAll('.tech-tab-btn')
        const tabPanels = document.querySelectorAll('.tech-tab-panel')

        tabBtns.forEach((btn) => {
            btn.addEventListener('click', () => {
                const targetTabId = btn.getAttribute('data-tab')

                tabBtns.forEach((b) => {
                    b.classList.remove('active', 'border-brand-lime', 'text-brand-lime', 'bg-brand-lime/10')
                    b.classList.add('border-transparent', 'text-gray-400', 'bg-transparent')
                })

                btn.classList.add('active', 'border-brand-lime', 'text-brand-lime', 'bg-brand-lime/10')
                btn.classList.remove('border-transparent', 'text-gray-400', 'bg-transparent')

                tabPanels.forEach((panel) => {
                    panel.classList.add('hidden', 'opacity-0', 'translate-y-4')
                    panel.classList.remove('opacity-100', 'translate-y-0')
                })

                const activePanel = document.getElementById(targetTabId)
                if (activePanel) {
                    activePanel.classList.remove('hidden')
                    setTimeout(() => {
                        activePanel.classList.remove('opacity-0', 'translate-y-4')
                        activePanel.classList.add('opacity-100', 'translate-y-0')
                    }, 20)
                }

                if (typeof ScrollTrigger !== 'undefined') {
                    ScrollTrigger.refresh()
                }
            })
        })

        // Inicializar Marquee Swiper
        if (typeof Swiper !== 'undefined') {
            new Swiper('.marquee-swiper', {
                loop: true,
                speed: 3000,
                autoplay: { delay: 0, disableOnInteraction: false },
                slidesPerView: 'auto',
                spaceBetween: 10,
                allowTouchMove: false,
                freeMode: true,
            })
        }
    })

    // Refrescar ScrollTrigger al cargar completamente la página
    window.addEventListener('load', () => {
        if (typeof ScrollTrigger !== 'undefined') {
            ScrollTrigger.refresh()
        }
    })
</script>

                                </ul>
                            </div>
                        </div>
                    </div>
                    )}

                    <!-- Panel 3: Recolección de Polvo y Bolsas -->
                    {d.tipos.tabs[3].active !== false && (
                    <div id="tab-recoleccion" class="tech-tab-panel hidden transition-all duration-500 opacity-0 transform translate-y-4">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
                            <div class="w-full relative rounded-3xl overflow-hidden shadow-2xl h-[300px] md:h-[400px] lg:h-full lg:min-h-[500px]">
                                <img src={d.tipos.tabs[3].image} alt="Filtros de Bolsa y Cartuchos" class="w-full h-full object-cover absolute inset-0" />
                                <div class="absolute inset-0 bg-brand-navy/10 mix-blend-multiply"></div>
                            </div>
                            <div class="flex flex-col pb-8">
                                <h3 class="font-saira font-semibold italic text-brand-navy text-3xl md:text-4xl uppercase mb-6">{d.tipos.tabs[3].title}</h3>
                                <p class="text-base text-gray-600 font-light leading-relaxed mb-6 whitespace-pre-wrap">{d.tipos.tabs[3].description}</p>
                                <ul class="space-y-4 text-gray-600 font-light text-sm">
                                    {
                                        d.tipos.tabs[3].items.map((item) => (
                                            <li class="flex items-start gap-3">
                                                <svg class="w-5 h-5 text-brand-lime shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                                                <span class="whitespace-pre-wrap"><strong class="whitespace-pre-wrap">{item.title}:</strong> {item.description}</span>
                                            </li>
                                        ))
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                    )}

                    <!-- Panel 4: Multifuncional y Cromatos -->
                    {d.tipos.tabs[4].active !== false && (
                    <div id="tab-multifuncional" class="tech-tab-panel hidden transition-all duration-500 opacity-0 transform translate-y-4">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
                            <div class="w-full relative rounded-3xl overflow-hidden shadow-2xl h-[300px] md:h-[400px] lg:h-full lg:min-h-[500px]">

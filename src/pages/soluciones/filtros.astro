---
import Layout from '../../layouts/Layout.astro'
import { getEntry } from 'astro:content'

// Obtener datos de la página de inicio para reutilizar logos de normativas
const homepageEntry = await getEntry('homepage', 'index')
const homepageData = homepageEntry?.data || {}
const certificados = homepageData.normativas?.certificados || [
    { name: 'NFPA', logo: '/images/home/certificaciones/nfpa.png' },
    { name: 'EPA', logo: '/images/home/certificaciones/epa.svg' },
    { name: 'ETL', logo: '/images/home/certificaciones/etl.png' },
    { name: 'ICC', logo: '/images/home/certificaciones/icc.png' },
    { name: 'OSHA', logo: '/images/home/certificaciones/osha.png' },
]

// SEO Metadata
const seoTitle = 'Filtros Industriales y Colectores de Polvo | Anaerobia'
const seoDescription = 'Suministramos filtros de extracción, inyección, filtros de bolsa, cartuchos y sistemas colectores de polvo para cabinas de pintura y procesos de acabado.'
---

<Layout title={seoTitle} description={seoDescription}>
    <main class="bg-industrial-gray min-h-screen text-brand-navy">
        <!-- 01. HEADER / HERO -->
        <section class="relative min-h-[60vh] flex items-center pt-36 pb-20 bg-brand-navy overflow-hidden">
            <!-- Background Image with Overlay -->
            <div class="absolute inset-0 z-0">
                <img src="/images/soluciones/filtros/filtro-1.webp" alt="Filtros Industriales" class="w-full h-full object-cover opacity-60 scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/85 to-brand-navy/60"></div>
            </div>

            <div class="container mx-auto px-6 relative z-10">
                <div class="max-w-4xl hero-section-text">
                    <!-- Breadcrumbs -->
                    <nav class="flex items-center gap-2 text-xs md:text-sm text-gray-400 font-semibold uppercase tracking-widest mb-6">
                        <a href="/" class="text-gray-300 hover:text-brand-lime transition-colors">Inicio</a>
                        <span>/</span>
                        <span class="text-gray-400">Soluciones</span>
                        <span>/</span>
                        <span class="text-brand-lime">Filtros</span>
                    </nav>

                    <span class="inline-block bg-brand-lime/10 text-brand-lime border border-brand-lime/20 rounded px-3 py-1 text-xs font-semibold uppercase tracking-widest mb-6"> SOLUCIONES DE FILTRACIÓN INDUSTRIAL </span>
                    <h1 class="text-white font-saira italic font-semibold uppercase text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] mb-6">Filtros y Recolección de Polvo</h1>
                    <p class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed">Sistemas completos de filtración para inyección, extracción y recuperación de pintura, así como colectores de polvos a la medida para garantizar ambientes limpios y seguros.</p>
                </div>
            </div>
        </section>

        <!-- 02. INTRODUCCIÓN -->
        <section class="py-16 bg-white px-6 md:px-12 relative overflow-hidden" id="introduccion">
            <div class="container mx-auto">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                    <div class="space-y-8 intro-text">
                        <div>
                            <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Sistemas de Aire Limpio</span>
                            <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4 mb-6 leading-tight">¿Por qué es crítica la filtración industrial?</h2>
                            <p class="text-gray-600 leading-relaxed font-light text-base md:text-lg">
                                En los procesos industriales de aplicación de acabados y pinturas, el aire es el principal portador de contaminantes. Un sistema de filtración ineficiente no solo daña el acabado final de las piezas (generando retrabajos costosos), sino que pone en riesgo la salud del
                                personal operativo y el cumplimiento de las normativas ambientales locales e internacionales.
                            </p>
                            <p class="text-gray-600 leading-relaxed font-light text-base md:text-lg mt-4">
                                ANAEROBIA ofrece una gama completa de filtros para cabina de pintura de alta eficiencia (como la línea exclusiva GFS Wave), filtros tacky de inyección para contención de micropartículas, y colectores de polvos para lijado y granallado diseñados a la medida de tu
                                planta.
                            </p>
                            <p class="text-brand-navy font-saira font-bold uppercase italic mt-6 border-l-4 border-brand-lime pl-4">Garantizamos aire libre de impurezas bajo estrictos estándares normativos.</p>
                        </div>

                    </div>

                    <!-- Intro Image -->
                    <div class="relative intro-image group">
                        <div class="relative rounded-lg overflow-hidden shadow-2xl">
                            <img src="/images/soluciones/filtros/filtro-2.webp" alt="Suministro de Filtros Industriales" class="w-full h-auto object-cover transform hover:scale-[1.02] transition-transform duration-700" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 03. IMPORTANCIA / PAIN POINTS -->
        <section class="py-16 bg-industrial-gray px-6 md:px-12 border-t border-gray-200/50">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 pain-points-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Desafíos</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Riesgos de una filtración deficiente en la línea</h2>
                    <p class="text-gray-600 mt-4 font-light">Un sistema de filtración inadecuado o saturado desencadena múltiples complicaciones críticas en tu producción:</p>
                </div>

                <div class="flex flex-col lg:flex-row gap-8 lg:h-[700px] w-full max-w-7xl mx-auto pain-points-grid items-stretch">
                    <!-- Column 1: Image (45%) -->
                    <div class="w-full lg:w-[45%] relative rounded-3xl overflow-hidden shadow-2xl h-[400px] lg:h-auto shrink-0 group">
                        <img src="/images/soluciones/filtros/filtro-4.webp" alt="Riesgos en el Acabado de Pintura" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-navy/30 mix-blend-multiply"></div>
                    </div>

                    <!-- Column 2: Cards (20%) -->
                    <div class="w-full lg:w-[20%] flex flex-col justify-between gap-4 shrink-0 h-full">
                        <!-- Card 1 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 flex-1 min-h-[100px]">
                            <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Contaminación en el Acabado</p>
                        </div>

                        <!-- Card 2 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 flex-1 min-h-[100px]">
                            <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Incumplimiento de Normas</p>
                        </div>

                        <!-- Card 3 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 flex-1 min-h-[100px]">
                            <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Saturación y Desgaste</p>
                        </div>

                        <!-- Card 4 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 flex-1 min-h-[100px]">
                            <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Riesgos Explosivos e Incendios</p>
                        </div>
                    </div>

                    <!-- Column 3: Content (35%) -->
                    <div class="w-full lg:w-[35%] flex flex-col justify-between space-y-4 shrink-0 lg:pl-2 h-full py-2">
                        <!-- Item 1 -->
                        <div class="space-y-2 flex-1 flex flex-col justify-center">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase">Contaminación en el Acabado</h3>
                            </div>
                            <p class="text-sm text-gray-600 leading-relaxed font-light">
                                La acumulación de motas, polvo y fibras en el flujo de aire compromete la calidad Clase A del pintado. Las impurezas se incrustan en la pintura húmeda, forzando costosos procesos de pulido y repintado de las piezas.
                            </p>
                        </div>

                        <!-- Item 2 -->
                        <div class="space-y-2 flex-1 flex flex-col justify-center">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase">Incumplimiento de Normas y Multas</h3>
                            </div>
                            <p class="text-sm text-gray-600 leading-relaxed font-light">
                                La emisión incontrolada de partículas y compuestos químicos peligrosos (como residuos de cromato) fuera de la cabina infringe las normativas NFPA 33 y las directrices ambientales de la EPA, acarreando costosas sanciones.
                            </p>
                        </div>

                        <!-- Item 3 -->
                        <div class="space-y-2 flex-1 flex flex-col justify-center">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase">Saturación y Pérdida de Presión</h3>
                            </div>
                            <p class="text-sm text-gray-600 leading-relaxed font-light">
                                Filtros saturados elevan drásticamente la resistencia al flujo de aire (caída de presión), provocando que los extractores trabajen forzados. Esto incrementa el consumo eléctrico y disminuye la capacidad de arrastre en la cabina.
                            </p>
                        </div>

                        <!-- Item 4 -->
                        <div class="space-y-2 flex-1 flex flex-col justify-center">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase">Riesgos Explosivos e Incendios</h3>
                            </div>
                            <p class="text-sm text-gray-600 leading-relaxed font-light">
                                La acumulación excesiva de overspray inflamable en el plenum de extracción y los ductos eleva gravemente el riesgo de ignición. La filtración certificada es obligatoria según la NFPA 33 para evitar catástrofes.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 04. PRIMER CTA PERSONALIZADO -->
        <section class="py-16 bg-brand-navy relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-brand-navy via-brand-navy to-brand-blue/50 opacity-90"></div>
            <div class="container mx-auto px-6 relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
                <div class="text-left">
                    <h2 class="text-white text-2xl md:text-3xl font-saira italic font-semibold uppercase">¿Requieres optimizar los filtros de tus cabinas?</h2>
                    <p class="text-gray-300 text-sm md:text-base font-light mt-2 max-w-xl">Abastecemos filtros plisados, tacky, de bolsa y cartuchos para marcas líderes del mercado.</p>
                </div>
                <a href="/contacto?solucion=filtros" class="bg-brand-lime text-brand-navy font-bold uppercase tracking-widest px-8 py-4 rounded hover:brightness-110 transition-all shadow-lg shrink-0 text-center"> Solicitar Cotización de Filtros </a>
            </div>
        </section>

        <!-- 05. SOLUCIÓN ANAEROBIA (NUESTRA INGENIERÍA - BENTO GRID) -->
        <section class="py-16 bg-gradient-to-b from-gray-100 to-white px-6 md:px-12 relative overflow-hidden" id="ingenieria">
            <div class="container mx-auto">
                <div class="max-w-5xl mb-10 section-solucion-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Integración y Suministro</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Ingeniería en Filtración y Colección de Polvos</h2>
                    <p class="text-gray-600 font-light mt-4">No solo vendemos filtros, evaluamos las caídas de presión de tus sistemas, el flujo volumétrico (CFM) requerido y las características físicas del recubrimiento para suministrar la solución idónea.</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-10 text-left items-stretch">
                    <!-- Bento Card 1 (Large Left) -->
                    <div class="bg-brand-navy rounded-3xl p-10 lg:p-14 flex flex-col justify-between relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 shadow-2xl min-h-[500px] h-full">
                        <!-- Image background -->
                        <div class="absolute inset-0 bg-[url('/images/soluciones/filtros/filtro-3.webp')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"></div>
                        <!-- Overlay azul -->
                        <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                        <!-- Decorative background element -->
                        <div class="absolute -right-20 -top-20 w-64 h-64 bg-brand-lime opacity-20 blur-3xl rounded-full group-hover:scale-150 transition-transform duration-700"></div>

                        <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-20 h-20 bg-brand-lime/20 text-brand-lime rounded-2xl flex items-center justify-center z-20">
                            <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3v18M3 12h18M12 3a9 9 0 0 1 9 9M12 3a9 9 0 0 0-9 9M12 21a9 9 0 0 1 9-9M12 21a9 9 0 0 0-9 9"></path>
                            </svg>
                        </div>
                        <div class="relative z-10 mt-auto">
                            <div>
                                <h3 class="font-saira font-semibold italic text-white text-3xl md:text-4xl uppercase mb-4 leading-tight">Línea de Filtros de Alta Eficiencia Wave GFS</h3>
                                <p class="text-lg text-gray-200 font-light leading-relaxed">Línea exclusiva de extracción con una superficie corrugada patentada que duplica la superficie de captura. Logra un 99.83% de eficiencia y extiende notablemente la vida útil del plenum de la cabina.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column for Bento Cards 2 & 3 -->
                    <div class="flex flex-col gap-6 h-full">
                        <!-- Bento Card 2 -->
                        <div class="bg-brand-navy rounded-3xl p-8 lg:p-10 flex flex-col justify-center relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 h-full shadow-xl min-h-[250px]">
                            <!-- Image background -->
                            <div class="absolute inset-0 bg-[url('/images/soluciones/filtros/filtro-5.webp')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"></div>
                            <!-- Overlay azul -->
                            <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                            <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-14 h-14 bg-brand-lime/20 shadow-sm text-brand-lime rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 z-20">
                                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16v16H4V4zM4 9h16M4 15h16M9 4v16M15 4v16"></path>
                                </svg>
                            </div>
                            <div class="relative z-10">
                                <h3 class="font-saira font-semibold italic text-white text-2xl uppercase leading-tight pr-16 mb-6">Filtros Tacky de Inyección con Marco Interno</h3>
                                <p class="text-base text-gray-200 font-light leading-relaxed">Filtros sintéticos tacky que capturan partículas superiores a 5 micras. Su marco interno de acero sólido soldada garantiza un sello hermético que evita derivaciones de aire no filtrado.</p>
                            </div>
                        </div>

                        <!-- Bento Card 3 -->
                        <div class="bg-brand-navy rounded-3xl p-8 lg:p-10 shadow-xl border border-transparent flex flex-col justify-center relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 h-full min-h-[250px]">
                            <!-- Image background -->
                            <div class="absolute inset-0 bg-[url('/images/soluciones/filtros/filtro-7.webp')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"></div>
                            <!-- Overlay azul -->
                            <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                            <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-14 h-14 bg-brand-lime/20 text-brand-lime rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 z-20">
                                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M19 11H5m14 0a2 2 0 0 1 2 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                                </svg>
                            </div>
                            <div class="relative z-10">
                                <h3 class="font-saira font-semibold italic text-white text-2xl uppercase leading-tight pr-16 mb-6">Cabinas y Colectores de Polvo a la Medida</h3>
                                <p class="text-base text-gray-200 font-light leading-relaxed">Diseñamos e integramos cabinas de colección de polvo para lijado y desbastado. Empleamos colectores de cartucho y bolsa autolimpiables por chorro de pulso (Pulse Jet) de alto desempeño.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 06. DIFERENCIADORES / PILARES DE MARCA -->
        <section class="py-16 bg-white px-6 md:px-12 border-t border-gray-100 relative overflow-hidden" id="diferenciadores">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 diferenciadores-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Diferenciadores</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Valor Añadido en Filtración ANAEROBIA</h2>
                    <p class="text-gray-600 font-light mt-4">Nuestra propuesta garantiza un rendimiento óptimo de tus cabinas:</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 diferenciadores-grid">
                    {
                        [
                            { title: 'Certificación de Seguridad', desc: 'Suministramos exclusivamente productos aprobados por UL, garantizando retardancia a la flama de acuerdo con la norma NFPA 33.' },
                            { title: 'Ingeniería Multimarca', desc: 'Nuestros filtros se adaptan físicamente a cabinas de cualquier fabricante, respetando los flujos de aire y dimensiones de marcos.' },
                            { title: 'Reducción de Consumos', desc: 'Seleccionamos medios filtrantes con menor resistencia inicial, permitiendo reducir la carga eléctrica en motores de extracción.' },
                            { title: 'Disponibilidad de Stock', desc: 'Contamos con stock de entrega rápida para refacciones, consumibles críticos y repuestos de filtros tacky, plisados y bolsas.' },
                        ].map((app, index) => (
                            <div class="bg-white p-6 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.06)] border border-gray-100 flex flex-col justify-between hover:shadow-md transition-shadow duration-300">
                                <div>
                                    <span class="text-brand-lime font-saira font-bold text-lg mb-2 block">0{index + 1}</span>
                                    <h3 class="font-saira font-semibold italic text-brand-navy text-lg uppercase mb-3 leading-tight">{app.title}</h3>
                                    <p class="text-xs text-gray-500 leading-relaxed font-light">{app.desc}</p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 07. INFORMACIÓN TÉCNICA (TABS DE MEDIOS FILTRANTES) -->
        <section class="py-16 bg-brand-lime/5 px-6 md:px-12 border-y border-gray-200/50 relative overflow-hidden" id="datos-tecnicos">
            <!-- Logo de fondo -->
            <img src="/images/soluciones/fondo-seccion.png" alt="" class="absolute top-1/2 -translate-y-1/2 -right-32 lg:-right-20 w-[400px] lg:w-[600px] opacity-10 invert mix-blend-multiply object-contain pointer-events-none z-0" />

            <div class="container mx-auto relative z-10">
                <div class="max-w-5xl mb-10 section-solucion-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Catálogo Técnico</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Especificaciones de Medios Filtrantes</h2>

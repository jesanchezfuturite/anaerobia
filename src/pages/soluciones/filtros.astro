            </div>
        </section>

        <!-- 08. COMPONENTES Y ELEMENTOS DE FILTRACIÓN -->
        <section class="py-16 bg-white px-6 md:px-12 border-t border-gray-100 relative overflow-hidden" id="componentes">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 components-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.extras.componentes.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">{d.extras.componentes.title}</h2>
                    <p class="text-gray-600 font-light mt-4 whitespace-pre-wrap">{d.extras.componentes.description}</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    {
                        d.extras.componentes.cards.map((comp) => (
                            <div class="bg-gray-50 p-8 rounded-2xl border border-gray-200/50 flex flex-col justify-between hover:bg-white hover:shadow-xl transition-all duration-300 group">
                                <div class="space-y-4">
                                    <h3 class="font-saira font-semibold italic text-brand-navy text-xl uppercase group-hover:text-brand-blue transition-colors leading-tight">{comp.title}</h3>
                                    <p class="text-sm text-gray-500 leading-relaxed font-light whitespace-pre-wrap">{comp.description}</p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 09. SEGUNDO CTA PERSONALIZADO -->
        <section class="py-16 relative flex flex-col items-center justify-center overflow-hidden px-6" id="conclusion">
            <img src={d.cta2.image} alt="Ingenieros interactuando con maquinaria" class="absolute top-1/2 left-0 w-full h-[130%] -translate-y-1/2 object-cover z-0" />
            <div class="absolute inset-0 bg-brand-navy/90 z-10 mix-blend-multiply"></div>
            <div class="container mx-auto px-6 relative z-10 max-w-5xl text-center space-y-8">
                <span class="text-brand-lime font-bold tracking-widest text-xs uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Diseño Industrial Llave en Mano</span>
                <h2 class="text-white text-3xl md:text-5xl font-saira italic font-semibold uppercase tracking-wider leading-tight max-w-4xl mx-auto">{d.cta2.title}</h2>
                <p class="text-gray-300 text-lg md:text-xl font-light max-w-3xl mx-auto whitespace-pre-wrap">{d.cta2.description}</p>
                <div class="pt-4 flex justify-center">
                    <a href={d.cta2.button_url} class="bg-brand-lime text-brand-navy font-bold uppercase tracking-widest px-8 py-4 rounded hover:brightness-110 transition-all shadow-lg text-center">{d.cta2.button_label}</a>
                </div>
            </div>
        </section>

        <!-- 10. NORMATIVIDAD -->
        <section class="py-16 bg-brand-navy text-white px-6 md:px-12 relative overflow-hidden" id="normas">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-white/5 via-transparent to-transparent opacity-30 z-0"></div>
            <div class="container mx-auto relative z-10 max-w-6xl">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                    <div class="space-y-6 norms-text">
                        <span class="text-brand-lime font-bold tracking-widest text-xs uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.normatividad.badge}</span>
                        <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-white uppercase tracking-wider">{d.normatividad.title}</h2>
                        <div class="w-16 h-1 bg-brand-lime mt-2 mb-6"></div>
                        <p class="text-gray-300 leading-relaxed font-light text-base whitespace-pre-wrap">{d.normatividad.description}</p>
                    </div>

                    <div class="w-full">
                        <div class="grid grid-cols-3 gap-4 md:gap-6 norms-grid">
                            {
                                certificados.map((cert) => (
                                    <div class="bg-white rounded-xl p-4 flex flex-col items-center justify-center shadow-lg transition-transform duration-300 hover:-translate-y-1 border border-transparent hover:border-brand-lime group">
                                        <div class="h-12 w-full flex items-center justify-center mb-2">
                                            <img
                                                src={cert.logo}
                                                alt={`Certificación ${cert.name}`}
                                                class="max-h-full max-w-full object-contain transition-all"
                                            />
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 11. ALIANZAS / PARTNERS -->
        <section class="bg-white py-6 border-y border-gray-200 overflow-hidden flex items-center">
            <div class="container mx-auto px-6 flex flex-col md:flex-row items-center gap-6">
                <span class="text-gray-500 font-medium whitespace-nowrap text-xs uppercase tracking-widest mt-1"> {general.aliados?.title} </span>
                <div class="swiper marquee-swiper w-full">
                    <div class="swiper-wrapper items-center">
                        {[...(general.aliados?.logos ?? []), ...(general.aliados?.logos ?? [])].map((aliado) => (
                            <div class="swiper-slide !w-auto px-8 flex items-center justify-center">
                                <img src={aliado.image} alt={aliado.name} class="h-auto max-h-9 w-auto max-w-full object-contain opacity-60 grayscale hover:grayscale-0 transition-all" />
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- 12. PREGUNTAS FRECUENTES (FAQ) -->
        <section class="py-16 bg-white px-6 md:px-12" id="faq">
            <div class="container mx-auto max-w-4xl">
                <div class="text-center mb-16">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.faqs.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">{d.faqs.title}</h2>
                    <p class="text-gray-600 mt-4 font-light">Respuestas a las dudas de filtración y recolección de polvo industrial más comunes en la planta.</p>
                </div>

                <div class="space-y-4">
                    {
                        d.faqs.items.map((faq, i) => (
                            <details class="group border border-gray-200 rounded-2xl bg-gray-50 transition-all duration-300 open:bg-white open:shadow-xl [&_summary::-webkit-details-marker]:hidden" open={i === 0}>
                                <summary class="flex items-center justify-between p-6 cursor-pointer focus:outline-none">
                                    <h3 class="font-saira font-semibold italic text-brand-navy text-lg md:text-xl uppercase tracking-wide">{faq.question}</h3>
                                    <span class="w-6 h-6 rounded-full bg-brand-navy/5 flex items-center justify-center text-brand-navy font-bold text-xl after:content-['+'] group-open:after:content-['-']" />
                                </summary>
                                <div class="px-6 pb-6 pt-2 border-t border-gray-100 text-gray-600 font-light text-base leading-relaxed details-content-reveal whitespace-pre-wrap">{faq.answer}</div>
                            </details>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 13. GALERÍA DE PROYECTOS -->
        <section class="py-16 bg-white px-6 md:px-12 border-t border-gray-100" id="galeria">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 gallery-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.galeria.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">{d.galeria.title}</h2>
                    <p class="text-gray-600 mt-4 font-light">Instalaciones de colectores de polvo, cabinas de lijado y plenum de filtración en operación.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 gallery-grid">
                    {
                        d.galeria.images.map((img) => (
                            <div class="relative overflow-hidden rounded-lg shadow group border border-gray-200">
                                <img src={img.image} alt={img.alt} class="w-full h-64 object-cover transform group-hover:scale-105 transition-transform duration-500" />
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>

    <!-- CDNs y Configuración de Animación Scroll / Lenis -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            // 1. Inicializar Lenis (Smooth Scroll)
            const lenis = new Lenis({
                duration: 1.2,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                smoothWheel: true,
            })
            function raf(time) {
                lenis.raf(time)
                requestAnimationFrame(raf)
            }
            requestAnimationFrame(raf)

            // 2. Conectar GSAP con Lenis y animar
            if (typeof gsap !== 'undefined') {
                gsap.ticker.add((time) => {
                    lenis.raf(time * 1000)
                })
                gsap.ticker.lagSmoothing(0)

                // Animaciones GSAP de elementos
                if (typeof ScrollTrigger !== 'undefined') {
                    // Header text
                    gsap.from('.hero-section-text > *', {
                        y: 30,
                        opacity: 0,
                        duration: 0.8,
                        stagger: 0.15,
                        ease: 'power2.out',
                    })

                    // Intro
                    gsap.from('.intro-text > *', {
                        scrollTrigger: { trigger: '#introduccion', start: 'top 80%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.7,
                        stagger: 0.15,
                        ease: 'power2.out',
                    })

                    // Pain points grid
                    gsap.from('.pain-points-grid > div', {
                        scrollTrigger: { trigger: '.pain-points-grid', start: 'top 85%' },
                        y: 40,
                        opacity: 0,
                        duration: 0.8,
                        stagger: 0.15,
                        ease: 'power2.out',
                    })

                    // Ingeniería grid
                    gsap.from('#ingenieria .grid > div', {
                        scrollTrigger: { trigger: '#ingenieria', start: 'top 80%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.7,
                        stagger: 0.15,
                        ease: 'power2.out',
                        clearProps: 'all',
                    })

                    // Diferenciadores grid
                    gsap.from('.diferenciadores-grid > div', {
                        scrollTrigger: {
                            trigger: '.diferenciadores-grid',
                            start: 'top 85%',
                        },
                        y: 30,
                        opacity: 0,
                        duration: 0.7,
                        stagger: 0.15,
                        ease: 'power2.out',
                    })

                    // Especificaciones
                    gsap.from('#datos-tecnicos table, #datos-tecnicos .grid > div', {
                        scrollTrigger: { trigger: '#datos-tecnicos', start: 'top 80%' },
                        y: 40,
                        opacity: 0,
                        duration: 0.8,
                        stagger: 0.15,
                        ease: 'power2.out',
                    })

                    // Conclusión
                    gsap.from('#conclusion > div', {
                        scrollTrigger: { trigger: '#conclusion', start: 'top 85%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.8,
                        ease: 'power2.out',
                    })

                    // Normativas text
                    gsap.from('.norms-text > *', {
                        scrollTrigger: { trigger: '#normas', start: 'top 80%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.8,
                        stagger: 0.12,
                        ease: 'power2.out',
                    })

                    // Normativas grid items
                    gsap.from('.norms-grid > div', {
                        scrollTrigger: { trigger: '.norms-grid', start: 'top 85%' },
                        y: 20,
                        opacity: 0,
                        duration: 0.6,
                        stagger: 0.1,
                        ease: 'power2.out',
                        clearProps: 'opacity,transform',
                    })

                    // FAQ list
                    gsap.from('#faq details', {
                        scrollTrigger: { trigger: '#faq', start: 'top 80%' },
                        y: 20,
                        opacity: 0,
                        duration: 0.6,
                        stagger: 0.1,
                        ease: 'power2.out',
                        clearProps: 'opacity,transform',
                    })

                    // Gallery grid
                    gsap.from('.gallery-grid > div', {
                        scrollTrigger: { trigger: '.gallery-grid', start: 'top 85%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.7,
                        stagger: 0.12,
                        ease: 'power2.out',
                        clearProps: 'opacity,transform',
                    })
                }
            }

            // 3. Inicializar Marquee Swiper
            if (typeof Swiper !== 'undefined') {
                new Swiper('.marquee-swiper', {
                    loop: true,
                    speed: 3000,
                    autoplay: {
                        delay: 0,
                        disableOnInteraction: false,
                    },
                    slidesPerView: 'auto',
                    spaceBetween: 10,
                    allowTouchMove: false,
                    freeMode: true,
                })
            }

            // 5. Controlador de Tabs Técnicos
            const tabBtns = document.querySelectorAll('.tech-tab-btn')
            const tabPanels = document.querySelectorAll('.tech-tab-panel')

            tabBtns.forEach((btn) => {
                btn.addEventListener('click', () => {
                    const targetTabId = btn.getAttribute('data-tab')

                    tabBtns.forEach((b) => {
                        b.classList.remove('active', 'border-brand-lime', 'text-brand-lime', 'bg-brand-lime/10')
                        b.classList.add('border-transparent', 'text-gray-400', 'bg-transparent')
                    })

                    btn.classList.add('active', 'border-brand-lime', 'text-brand-lime', 'bg-brand-lime/10')
                    btn.classList.remove('border-transparent', 'text-gray-400', 'bg-transparent')

                    tabPanels.forEach((panel) => {
                        panel.classList.add('hidden', 'opacity-0', 'translate-y-4')
                        panel.classList.remove('opacity-100', 'translate-y-0')
                    })

                    const activePanel = document.getElementById(targetTabId)
                    if (activePanel) {
                        activePanel.classList.remove('hidden')
                        setTimeout(() => {
                            activePanel.classList.remove('opacity-0', 'translate-y-4')
                            activePanel.classList.add('opacity-100', 'translate-y-0')
                        }, 20)
                    }

                    if (typeof ScrollTrigger !== 'undefined') {
                        ScrollTrigger.refresh()
                    }
                })
            })

            // Si la primera pestaña está inactiva, activar la primera visible
            if (tabBtns.length && !document.querySelector('.tech-tab-btn.active')) {
                tabBtns[0].click()
            }
        })
    </script>
</Layout>

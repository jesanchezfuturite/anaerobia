                        <p class="text-gray-300 leading-relaxed font-light text-base">
                            Nuestras soluciones aseguran el cumplimiento de la norma <strong>NFPA 33</strong> para limitar concentraciones de vapores inflamables, las directrices de la <strong>OSHA</strong> sobre seguridad laboral, y las certificaciones <strong>UL Clase 1 o 2</strong> de inflamabilidad
                            de los filtros.
                        </p>
                    </div>

                    <div class="lg:w-1/2 w-full">
                        <div class="grid grid-cols-2 gap-4 md:gap-6 norms-grid">
                            {
                                certificados.map((cert) => (
                                    <div class="bg-white rounded-xl p-4 flex flex-col items-center justify-center shadow-lg transition-transform duration-300 hover:-translate-y-1 border border-transparent hover:border-brand-lime group">
                                        <div class="h-12 w-full flex items-center justify-center mb-2">
                                            <img
                                                src={cert.logo}
                                                alt={`Certificación ${cert.name}`}
                                                class="max-h-full max-w-full object-contain grayscale hover:grayscale-0 transition-all"
                                                onerror="this.outerHTML='<span class=\'text-lg font-bold text-gray-400\'>' + this.alt.split(' ')[1] + '</span>'"
                                            />
                                        </div>
                                        <span class="font-saira font-semibold text-2xs tracking-wider text-brand-navy opacity-60 group-hover:opacity-100 transition-opacity uppercase">{cert.name}</span>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 11. ALIANZAS / PARTNERS -->
        <section class="bg-white py-6 border-y border-gray-200 overflow-hidden flex items-center">
            <div class="container mx-auto px-6 flex flex-col md:flex-row items-center gap-6">
                <span class="text-gray-500 font-medium whitespace-nowrap text-xs uppercase tracking-widest mt-1"> Equipamiento y Consumibles con Tecnología de: </span>
                <div class="swiper marquee-swiper w-full">
                    <div class="swiper-wrapper items-center">
                        <div class="swiper-slide !w-auto px-8"><span class="text-xl font-saira font-bold text-gray-400/70 tracking-widest">GFS (GLOBAL FINISHING SOLUTIONS)</span></div>
                        <div class="swiper-slide !w-auto px-8"><span class="text-xl font-saira font-bold text-gray-400/70 tracking-widest">GRACO</span></div>
                        <div class="swiper-slide !w-auto px-8"><span class="text-xl font-saira font-bold text-gray-400/70 tracking-widest">NORDSON</span></div>
                        <div class="swiper-slide !w-auto px-8"><span class="text-xl font-saira font-bold text-gray-400/70 tracking-widest">BINKS</span></div>
                        <!-- Duplicados para ciclo continuo -->
                        <div class="swiper-slide !w-auto px-8"><span class="text-xl font-saira font-bold text-gray-400/70 tracking-widest">GFS (GLOBAL FINISHING SOLUTIONS)</span></div>
                        <div class="swiper-slide !w-auto px-8"><span class="text-xl font-saira font-bold text-gray-400/70 tracking-widest">GRACO</span></div>
                        <div class="swiper-slide !w-auto px-8"><span class="text-xl font-saira font-bold text-gray-400/70 tracking-widest">NORDSON</span></div>
                        <div class="swiper-slide !w-auto px-8"><span class="text-xl font-saira font-bold text-gray-400/70 tracking-widest">BINKS</span></div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 12. PREGUNTAS FRECUENTES (FAQ) -->
        <section class="py-16 bg-white px-6 md:px-12" id="faq">
            <div class="container mx-auto max-w-4xl">
                <div class="text-center mb-16">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Preguntas Frecuentes</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Preguntas Frecuentes</h2>
                    <p class="text-gray-600 mt-4 font-light">Respuestas a las dudas de filtración y recolección de polvo industrial más comunes en la planta.</p>
                </div>

                <div class="space-y-4">
                    <details class="group border border-gray-200 rounded-2xl bg-gray-50 transition-all duration-300 open:bg-white open:shadow-xl [&_summary::-webkit-details-marker]:hidden" open>
                        <summary class="flex items-center justify-between p-6 cursor-pointer focus:outline-none">
                            <h3 class="font-saira font-semibold italic text-brand-navy text-lg md:text-xl uppercase tracking-wide">¿Cuál es la ventaja del Filtro Wave de GFS frente a un filtro de fibra de vidrio tradicional?</h3>
                            <span class="w-6 h-6 rounded-full bg-brand-navy/5 flex items-center justify-center text-brand-navy font-bold text-xl after:content-['+'] group-open:after:content-['-']"></span>
                        </summary>
                        <div class="px-6 pb-6 pt-2 border-t border-gray-100 text-gray-600 font-light text-base leading-relaxed details-content-reveal">
                            El Filtro Wave cuenta con un patrón corrugado en ondas que duplica la superficie de captura útil en el mismo tamaño de marco. Esto resulta en una eficiencia del 99.83%, mayor capacidad de retención de pintura líquida y en polvo antes de saturarse, menor caída de presión
                            inicial y una vida útil sustancialmente mayor, reduciendo el número de paros y cambios de filtro.
                        </div>
                    </details>

                    <details class="group border border-gray-200 rounded-2xl bg-gray-50 transition-all duration-300 open:bg-white open:shadow-xl [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex items-center justify-between p-6 cursor-pointer focus:outline-none">
                            <h3 class="font-saira font-semibold italic text-brand-navy text-lg md:text-xl uppercase tracking-wide">¿Por qué es obligatorio un filtro de 3 etapas en la captura de cromatos?</h3>
                            <span class="w-6 h-6 rounded-full bg-brand-navy/5 flex items-center justify-center text-brand-navy font-bold text-xl after:content-['+'] group-open:after:content-['-']"></span>
                        </summary>
                        <div class="px-6 pb-6 pt-2 border-t border-gray-100 text-gray-600 font-light text-base leading-relaxed details-content-reveal">
                            Los cromatos son compuestos químicos altamente tóxicos y regulados por agencias de salud y medio ambiente (como OSHA y EPA). Para garantizar su contención absoluta, la norma NESHAP Método 319 exige un sistema de filtración progresivo de 3 etapas (Wave, filtro plisado de
                            media eficiencia MEPT, y filtro de bolsa final de alta eficiencia) para detener partículas ultrafinas.
                        </div>
                    </details>

                    <details class="group border border-gray-200 rounded-2xl bg-gray-50 transition-all duration-300 open:bg-white open:shadow-xl [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex items-center justify-between p-6 cursor-pointer focus:outline-none">
                            <h3 class="font-saira font-semibold italic text-brand-navy text-lg md:text-xl uppercase tracking-wide">¿Qué diferencia hay entre los filtros tacky con y sin marco interno?</h3>
                            <span class="w-6 h-6 rounded-full bg-brand-navy/5 flex items-center justify-center text-brand-navy font-bold text-xl after:content-['+'] group-open:after:content-['-']"></span>
                        </summary>
                        <div class="px-6 pb-6 pt-2 border-t border-gray-100 text-gray-600 font-light text-base leading-relaxed details-content-reveal">
                            Los filtros tacky sin marco se suministran en rollo o almohadillas sueltas y requieren de un marco de rejilla exterior de la cabina para sujetarse. Los filtros con marco de acero soldado interno son unidades autónomas rígidas que se deslizan o sujetan directamente en el
                            plenum, proporcionando una junta hermética de cierre automático que elimina las derivaciones de aire sucio.
                        </div>
                    </details>

                    <details class="group border border-gray-200 rounded-2xl bg-gray-50 transition-all duration-300 open:bg-white open:shadow-xl [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex items-center justify-between p-6 cursor-pointer focus:outline-none">
                            <h3 class="font-saira font-semibold italic text-brand-navy text-lg md:text-xl uppercase tracking-wide">¿Cómo funciona la limpieza automática Pulse Jet en los colectores de polvo?</h3>
                            <span class="w-6 h-6 rounded-full bg-brand-navy/5 flex items-center justify-center text-brand-navy font-bold text-xl after:content-['+'] group-open:after:content-['-']"></span>
                        </summary>
                        <div class="px-6 pb-6 pt-2 border-t border-gray-100 text-gray-600 font-light text-base leading-relaxed details-content-reveal">
                            El sistema Pulse Jet monitorea la diferencia de presión en los cartuchos filtrantes. Cuando la presión supera un límite establecido por saturación de polvo, el sistema dispara un pulso de aire comprimido a alta presión en sentido inverso en el interior del cartucho. Esto
                            sacude el cartucho y hace caer el polvo acumulado en la tolva de recolección inferior, limpiándolo sin interrumpir la operación de la cabina.
                        </div>
                    </details>
                </div>
            </div>
        </section>

        <!-- 13. GALERÍA DE PROYECTOS -->
        <section class="py-16 bg-white px-6 md:px-12 border-t border-gray-100" id="galeria">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 gallery-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Galería</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Proyectos</h2>
                    <p class="text-gray-600 mt-4 font-light">Instalaciones de colectores de polvo, cabinas de lijado y plenum de filtración en operación.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 gallery-grid">
                    <div class="relative overflow-hidden rounded-lg shadow group border border-gray-200">
                        <img src="/images/soluciones/filtros/filtro-11.webp" alt="Plenum de Inyección Filtros Tacky" class="w-full h-64 object-cover transform group-hover:scale-105 transition-transform duration-500" />
                    </div>
                    <div class="relative overflow-hidden rounded-lg shadow group border border-gray-200">
                        <img src="/images/soluciones/filtros/filtro-9.webp" alt="Instalación de Colector de Polvos" class="w-full h-64 object-cover transform group-hover:scale-105 transition-transform duration-500" />
                    </div>
                    <div class="relative overflow-hidden rounded-lg shadow group border border-gray-200">
                        <img src="/images/soluciones/filtros/filtro-13.webp" alt="Módulo Colector de Lijado Autolimpiable" class="w-full h-64 object-cover transform group-hover:scale-105 transition-transform duration-500" />
                    </div>
                </div>
            </div>
        </section>
    </main>

    <!-- CDNs y Configuración de Animación Scroll / Lenis -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            // 1. Inicializar Lenis (Smooth Scroll)
            const lenis = new Lenis({
                duration: 1.2,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                smoothWheel: true,
            })
            function raf(time) {
                lenis.raf(time)
                requestAnimationFrame(raf)
            }
            requestAnimationFrame(raf)

            // 2. Conectar GSAP con Lenis y animar
            if (typeof gsap !== 'undefined') {
                gsap.ticker.add((time) => {
                    lenis.raf(time * 1000)
                })
                gsap.ticker.lagSmoothing(0)

                // Animaciones GSAP de elementos
                if (typeof ScrollTrigger !== 'undefined') {
                    // Header text
                    gsap.from('.hero-section-text > *', {
                        y: 30,
                        opacity: 0,
                        duration: 0.8,
                        stagger: 0.15,
                        ease: 'power2.out',
                    })

                    // Intro
                    gsap.from('.intro-text > *', {
                        scrollTrigger: { trigger: '#introduccion', start: 'top 80%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.7,
                        stagger: 0.15,
                        ease: 'power2.out',
                    })

                    // Pain points grid
                    gsap.from('.pain-points-grid > div', {
                        scrollTrigger: { trigger: '.pain-points-grid', start: 'top 85%' },
                        y: 40,
                        opacity: 0,
                        duration: 0.8,
                        stagger: 0.15,
                        ease: 'power2.out',
                    })

                    // Ingeniería grid
                    gsap.from('#ingenieria .grid > div', {
                        scrollTrigger: { trigger: '#ingenieria', start: 'top 80%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.7,
                        stagger: 0.15,
                        ease: 'power2.out',
                        clearProps: 'all',
                    })

                    // Diferenciadores grid
                    gsap.from('.diferenciadores-grid > div', {
                        scrollTrigger: {
                            trigger: '.diferenciadores-grid',
                            start: 'top 85%',
                        },
                        y: 30,
                        opacity: 0,
                        duration: 0.7,
                        stagger: 0.15,
                        ease: 'power2.out',
                    })

                    // Especificaciones
                    gsap.from('#datos-tecnicos table, #datos-tecnicos .grid > div', {
                        scrollTrigger: { trigger: '#datos-tecnicos', start: 'top 80%' },
                        y: 40,
                        opacity: 0,
                        duration: 0.8,
                        stagger: 0.15,
                        ease: 'power2.out',
                    })

                    // Conclusión
                    gsap.from('#conclusion > div', {
                        scrollTrigger: { trigger: '#conclusion', start: 'top 85%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.8,
                        ease: 'power2.out',
                    })

                    // Normativas text
                    gsap.from('.norms-text > *', {
                        scrollTrigger: { trigger: '#normas', start: 'top 80%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.8,
                        stagger: 0.12,
                        ease: 'power2.out',
                    })

                    // Normativas grid items
                    gsap.from('.norms-grid > div', {
                        scrollTrigger: { trigger: '.norms-grid', start: 'top 85%' },
                        y: 20,
                        opacity: 0,
                        duration: 0.6,
                        stagger: 0.1,
                        ease: 'power2.out',
                        clearProps: 'opacity,transform',
                    })

                    // FAQ list
                    gsap.from('#faq details', {
                        scrollTrigger: { trigger: '#faq', start: 'top 80%' },
                        y: 20,
                        opacity: 0,
                        duration: 0.6,
                        stagger: 0.1,
                        ease: 'power2.out',
                        clearProps: 'opacity,transform',
                    })

                    // Gallery grid
                    gsap.from('.gallery-grid > div', {
                        scrollTrigger: { trigger: '.gallery-grid', start: 'top 85%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.7,
                        stagger: 0.12,
                        ease: 'power2.out',
                        clearProps: 'opacity,transform',
                    })
                }
            }

            // 3. Inicializar Marquee Swiper
            if (typeof Swiper !== 'undefined') {
                new Swiper('.marquee-swiper', {
                    loop: true,
                    speed: 3000,
                    autoplay: {
                        delay: 0,
                        disableOnInteraction: false,
                    },
                    slidesPerView: 'auto',
                    spaceBetween: 10,
                    allowTouchMove: false,
                    freeMode: true,
                })
            }

            // 5. Controlador de Tabs Técnicos
            const tabBtns = document.querySelectorAll('.tech-tab-btn')
            const tabPanels = document.querySelectorAll('.tech-tab-panel')

            tabBtns.forEach((btn) => {
                btn.addEventListener('click', () => {
                    const targetTabId = btn.getAttribute('data-tab')

                    tabBtns.forEach((b) => {
                        b.classList.remove('active', 'border-brand-lime', 'text-brand-lime', 'bg-brand-lime/10')
                        b.classList.add('border-transparent', 'text-gray-400', 'bg-transparent')
                    })

                    btn.classList.add('active', 'border-brand-lime', 'text-brand-lime', 'bg-brand-lime/10')
                    btn.classList.remove('border-transparent', 'text-gray-400', 'bg-transparent')

                    tabPanels.forEach((panel) => {
                        panel.classList.add('hidden', 'opacity-0', 'translate-y-4')
                        panel.classList.remove('opacity-100', 'translate-y-0')
                    })

                    const activePanel = document.getElementById(targetTabId)
                    if (activePanel) {
                        activePanel.classList.remove('hidden')
                        setTimeout(() => {
                            activePanel.classList.remove('opacity-0', 'translate-y-4')
                            activePanel.classList.add('opacity-100', 'translate-y-0')
                        }, 20)
                    }

                    if (typeof ScrollTrigger !== 'undefined') {
                        ScrollTrigger.refresh()
                    }
                })
            })
        })
    </script>
</Layout>

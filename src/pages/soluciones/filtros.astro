                            </div>
                            <div class="flex flex-col pb-8">
                                <h3 class="font-saira font-semibold italic text-brand-navy text-3xl md:text-4xl uppercase mb-4">{d.tipos.tabs[4].title}</h3>
                                <p class="text-base text-gray-600 font-light leading-relaxed mb-6 whitespace-pre-wrap">{d.tipos.tabs[4].description}</p>

                                <h4 class="font-saira font-bold text-brand-blue uppercase text-lg mb-3">{d.tipos.tabs[4].etapas.title}</h4>
                                <p class="text-sm text-gray-600 leading-relaxed font-light mb-4 whitespace-pre-wrap">{d.tipos.tabs[4].etapas.description}</p>
                                <ul class="space-y-2 text-gray-600 font-light text-sm mb-6 pl-4 border-l-2 border-brand-lime">
                                    {
                                        d.tipos.tabs[4].etapas.items.map((item) => (
                                            <li class="whitespace-pre-wrap">
                                                <strong class="whitespace-pre-wrap">{item.title}:</strong> {item.description}

---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import { getGeneral } from '../../lib/general.js'
import Footer from '../../components/Footer.astro'
import fallback from '../../data/soluciones/cabinas-pintura.json'

const general = await getGeneral()

// Contenido administrable: se consulta la API del Admin (Laravel) en cada
// visita (SSR). Si la API no responde, se usa el respaldo local (fallback).
const API_URL = import.meta.env.ADMIN_API_URL ?? 'http://127.0.0.1:8000'
let d = fallback
try {
    const res = await fetch(`${API_URL}/api/v1/soluciones/cabinas-pintura`, { signal: AbortSignal.timeout(5000) })
    if (res.ok) d = (await res.json()).data
} catch {
    // API no disponible: la página se sirve con el contenido de respaldo
}

// Logos de certificaciones: contenido compartido del sitio que llega en el
// mismo payload de la API (se editan una sola vez en la página de Inicio).
const certificados = d.certificados ?? fallback.certificados ?? []

// SEO Metadata
const seoTitle = d.seo?.title
const seoDescription = d.seo?.description

// Alturas para alinear tarjetas/textos de la sección Desafíos (diseño fijo)
const desafioCardHeights = ['lg:min-h-[200px]', 'lg:min-h-[200px]', 'lg:min-h-[240px]', 'lg:min-h-[200px]']
const desafioItemHeights = ['lg:min-h-[200px]', 'lg:min-h-[200px]', 'lg:min-h-[240px]', 'lg:min-h-[200px]']
// Iconos (SVG paths) de los items de Desafíos
const desafioIcons = [
    'M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z',
    'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z',
    'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    'M13 10V3L4 14h7v7l9-11h-7z',
]
// Iconos (SVG paths) de las tarjetas de Beneficios (Diferenciadores)
const diferenciadorIcons = [
    'M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z',
    'M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z',
    'M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z',
    'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
    'M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v-4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15',
    'M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15 12a3 3 0 11-6 0 3 3 0 016 0z',
]
// Iconos (SVG paths) de las tarjetas del tab de pintura líquida (Filtro seco / Cortina de agua)
const tipoCardIcons = [
    'M3 4.5h18M6 4.5v6.44a3 3 0 00.879 2.121l3.242 3.242a3 3 0 01.879 2.122V19.5m4-15v6.44a3 3 0 01-.879 2.121l-3.242 3.242a3 3 0 00-.879 2.122V19.5',
    'M12 21c-4.142 0-7.5-3.358-7.5-7.5 0-3.5 4.5-9 7.5-11.5 3 2.5 7.5 8 7.5 11.5 0 4.142-3.358 7.5-7.5 7.5z',
]
// Numeración de las pestañas técnicas visibles (las inactivas se ocultan)
let _tabN = 0
const tabNums = (d.tipos?.tabs ?? []).map((t) => (t.active !== false ? String(++_tabN).padStart(2, '0') : null))
// Un icono puede ser código SVG (se incrusta y hereda el color de la marca) o
// una imagen subida (se muestra tal cual, solo ajustada al tamaño).
const esIconoSvg = (icono) => typeof icono === 'string' && icono.trimStart().startsWith('<svg')

---

<Layout title={seoTitle} description={seoDescription}>
    <main class="bg-industrial-gray min-h-screen text-brand-navy">
        <!-- 01. HEADER / HERO -->
        <section class="relative min-h-[60vh] flex items-center pt-36 pb-20 bg-brand-navy overflow-hidden">
            <!-- Background Image with Overlay -->
            <div class="absolute inset-0 z-0">
                <img src={d.hero.image} alt="Cabinas de Pintura Industrial" class="w-full h-full object-cover opacity-60 scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/85 to-brand-navy/60"></div>
            </div>

            <div class="container mx-auto px-6 relative z-10">
                <div class="max-w-4xl hero-section-text">
                    <!-- Breadcrumbs -->
                    <nav class="flex items-center gap-2 text-xs md:text-sm text-gray-400 font-semibold uppercase tracking-widest mb-6">
                        <a href="/" class="text-gray-300 hover:text-brand-lime transition-colors">Inicio</a>
                        <span>/</span>
                        <span class="text-gray-400">Soluciones</span>
                        <span>/</span>
                        <span class="text-brand-lime">Cabinas de Pintura</span>
                    </nav>

                    <span class="inline-block bg-brand-lime/10 text-brand-lime border border-brand-lime/20 rounded px-3 py-1 text-xs font-semibold uppercase tracking-widest mb-6">{d.hero.badge}</span>
                    <h1 class="text-white font-saira italic font-semibold uppercase text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] mb-6">{d.hero.title}</h1>
                    <p class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed whitespace-pre-wrap">{d.hero.description}</p>
                </div>
            </div>
        </section>

        <!-- 02. INTRODUCCIÓN -->
        <section class="py-16 bg-white px-6 md:px-12 relative overflow-hidden" id="introduccion">
            <div class="container mx-auto">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                    <div class="space-y-8 intro-text">
                        <div>
                            <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.intro.badge}</span>
                            <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4 mb-6 leading-tight">{d.intro.title}</h2>
                            {
                                d.intro.paragraphs.map((p, i) => (
                                    <p class={`${i === 0 ? 'text-gray-600 leading-relaxed font-light text-base md:text-lg' : 'text-gray-600 leading-relaxed font-light text-base md:text-lg mt-4'} whitespace-pre-wrap`}>{p.text}</p>
                                ))
                            }
                            <p class="text-brand-navy font-saira font-bold uppercase italic mt-6 border-l-4 border-brand-lime pl-4 text-base md:text-lg whitespace-pre-wrap">{d.intro.highlight}</p>
                        </div>
                    </div>

                    <!-- Intro Image -->
                    <div class="relative intro-image group">
                        <div class="relative rounded-lg overflow-hidden shadow-2xl">
                            <img src={d.intro.image} alt="Instalación de Cabina de Pintura Industrial" class="w-full h-auto object-cover transform hover:scale-[1.02] transition-transform duration-700" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 03. PROBLEMA / NECESIDAD (PAIN POINTS) -->
        <!-- 03. IMPORTANCIA / NECESIDAD -->
        <section class="py-16 bg-industrial-gray px-6 md:px-12 border-t border-gray-200/50">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 pain-points-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.desafios.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">{d.desafios.title}</h2>
                    <p class="text-gray-600 mt-4 font-light whitespace-pre-wrap">{d.desafios.description}</p>
                </div>

                <div class="flex flex-col lg:flex-row gap-8 lg:min-h-[700px] w-full max-w-7xl mx-auto pain-points-grid items-stretch">
                    <!-- Column 1: Image (45%) -->
                    <div class="w-full lg:w-[45%] relative rounded-3xl overflow-hidden shadow-2xl h-[400px] lg:h-auto shrink-0 group">
                        <img src={d.desafios.image} alt="Importancia de la Cabina de Pintura" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-navy/30 mix-blend-multiply"></div>
                    </div>

                    <!-- Column 2: Cards (20%) -->
                    <div class="w-full lg:w-[20%] flex flex-col justify-between gap-4 shrink-0 h-full">
                        {
                            d.desafios.items.map((t, i) => (
                                <div class={`relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 flex-1 ${desafioCardHeights[i] ?? 'lg:min-h-[200px]'}`}>
                                    <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center whitespace-pre-wrap">{t.text}</p>
                                </div>
                            ))
                        }
                    </div>

                    <!-- Column 3: Content (35%) -->
                    <div class="w-full lg:w-[35%] flex flex-col justify-between space-y-4 shrink-0 lg:pl-2 h-full py-2">
                        {
                            d.desafios.items.map((item, i) => (
                                <div class={`space-y-2 flex-1 flex flex-col justify-start pt-1 ${desafioItemHeights[i] ?? 'lg:min-h-[200px]'}`}>
                                    <div class="flex items-center gap-3">
                                        <div class="text-brand-lime shrink-0">
                                            {item.icon && !esIconoSvg(item.icon) ? (
                                                <img src={item.icon} alt={item.title} class="w-6 h-6 object-contain" />
                                            ) : item.icon ? (
                                                <Fragment set:html={item.icon} />
                                            ) : (
                                                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                                <path stroke-linecap="round" stroke-linejoin="round" d={desafioIcons[i] ?? desafioIcons[0]} />
                                            </svg>
                                            )}
                                        </div>
                                        <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase">{item.title}</h3>
                                    </div>
                                    <p class="text-sm text-gray-600 leading-relaxed font-light whitespace-pre-wrap">{item.description}</p>
                                </div>
                            ))
                        }
                    </div>
                </div>
            </div>
        </section>

        <!-- 04. PRIMER CTA PERSONALIZADO -->
        <section class="py-16 bg-brand-navy relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-brand-navy via-brand-navy to-brand-blue/50 opacity-90"></div>
            <div class="container mx-auto px-6 relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
                <div class="text-left">
                    <h2 class="text-white text-2xl md:text-3xl font-saira italic font-semibold uppercase">{d.cta1.title}</h2>
                    <p class="text-gray-300 text-sm md:text-base font-light mt-2 max-w-xl whitespace-pre-wrap">{d.cta1.description}</p>
                </div>
                <a href={d.cta1.button_url} class="bg-brand-lime text-brand-navy font-bold uppercase tracking-widest px-8 py-4 rounded hover:brightness-110 transition-all shadow-lg shrink-0 text-center">{d.cta1.button_label}</a>
            </div>
        </section>

        <!-- 05. SOLUCIÓN ANAEROBIA (NUESTRA INGENIERÍA) -->
        <section class="py-16 bg-gradient-to-b from-gray-100 to-white px-6 md:px-12 relative overflow-hidden" id="ingenieria">
            <div class="container mx-auto">
                <div class="max-w-5xl mb-10 section-solucion-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.ingenieria.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">{d.ingenieria.title}</h2>
                    <p class="text-gray-600 font-light mt-4 whitespace-pre-wrap">{d.ingenieria.description}</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-10 text-left items-stretch">
                    <!-- Bento Card 1 (Large Left) -->
                    <div class="bg-brand-navy rounded-3xl p-10 lg:p-14 flex flex-col justify-between relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 shadow-2xl min-h-[500px] h-full">
                        <!-- Image background -->
                        <div class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105" style={`background-image: url('${d.ingenieria.cards[0].image}')`}></div>
                        <!-- Overlay azul -->
                        <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                        <!-- Decorative background element -->
                        <div class="absolute -right-20 -top-20 w-64 h-64 bg-brand-lime opacity-20 blur-3xl rounded-full group-hover:scale-150 transition-transform duration-700"></div>

                        <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-20 h-20 bg-brand-lime/20 text-brand-lime rounded-2xl flex items-center justify-center z-20">
                            {d.ingenieria.cards[0].icon && !esIconoSvg(d.ingenieria.cards[0].icon) ? (
                                    <img src={d.ingenieria.cards[0].icon} alt={d.ingenieria.cards[0].title} class="w-10 h-10 object-contain" />
                                ) : d.ingenieria.cards[0].icon ? (
                                    <Fragment set:html={d.ingenieria.cards[0].icon} />
                                ) : (
                                    <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                <polyline points="2 12 12 17 22 12"></polyline>
                                <polyline points="2 17 12 22 22 17"></polyline>
                            </svg>
                                )}
                        </div>
                        <div class="relative z-10 mt-auto">
                            <div>
                                <h3 class="font-saira font-semibold italic text-white text-3xl md:text-4xl uppercase mb-4 leading-tight">{d.ingenieria.cards[0].title}</h3>
                                <p class="text-lg text-gray-200 font-light leading-relaxed whitespace-pre-wrap">
                                    {d.ingenieria.cards[0].description}
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column for Bento Cards 2 & 3 -->
                    <div class="flex flex-col gap-6 h-full">
                        <!-- Bento Card 2 -->
                        <div class="bg-brand-navy rounded-3xl p-8 lg:p-10 flex flex-col justify-center relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 h-full shadow-xl min-h-[250px]">
                            <!-- Image background -->
                            <div class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105" style={`background-image: url('${d.ingenieria.cards[1].image}')`}></div>
                            <!-- Overlay azul -->
                            <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                            <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-14 h-14 bg-brand-lime/20 shadow-sm text-brand-lime rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 z-20">
                                {d.ingenieria.cards[1].icon && !esIconoSvg(d.ingenieria.cards[1].icon) ? (
                                    <img src={d.ingenieria.cards[1].icon} alt={d.ingenieria.cards[1].title} class="w-10 h-10 object-contain" />
                                ) : d.ingenieria.cards[1].icon ? (
                                    <Fragment set:html={d.ingenieria.cards[1].icon} />
                                ) : (
                                    <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                                </svg>
                                )}
                            </div>
                            <div class="relative z-10">
                                <h3 class="font-saira font-semibold italic text-white text-2xl uppercase leading-tight pr-16 mb-6">{d.ingenieria.cards[1].title}</h3>
                                <p class="text-base text-gray-200 font-light leading-relaxed whitespace-pre-wrap">
                                    {d.ingenieria.cards[1].description}
                                </p>
                            </div>
                        </div>

                        <!-- Bento Card 3 -->
                        <div class="bg-brand-navy rounded-3xl p-8 lg:p-10 shadow-xl border border-transparent flex flex-col justify-center relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 h-full min-h-[250px]">
                            <!-- Image background -->
                            <div class="absolute inset-0 bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105" style={`background-image: url('${d.ingenieria.cards[2].image}')`}></div>
                            <!-- Overlay azul -->
                            <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                            <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-14 h-14 bg-brand-lime/20 text-brand-lime rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 z-20">
                                {d.ingenieria.cards[2].icon && !esIconoSvg(d.ingenieria.cards[2].icon) ? (
                                    <img src={d.ingenieria.cards[2].icon} alt={d.ingenieria.cards[2].title} class="w-10 h-10 object-contain" />
                                ) : d.ingenieria.cards[2].icon ? (
                                    <Fragment set:html={d.ingenieria.cards[2].icon} />
                                ) : (
                                    <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                                </svg>
                                )}
                            </div>
                            <div class="relative z-10">
                                <h3 class="font-saira font-semibold italic text-white text-2xl uppercase leading-tight pr-16 mb-6">{d.ingenieria.cards[2].title}</h3>
                                <p class="text-base text-gray-200 font-light leading-relaxed whitespace-pre-wrap">
                                    {d.ingenieria.cards[2].description}
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 06. DIFERENCIADORES ANAEROBIA (BENEFICIOS) -->
        <section class="py-16 bg-white px-6 md:px-12 border-t border-gray-100 relative overflow-hidden" id="diferenciadores">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 diferenciadores-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.extras.diferenciadores.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">{d.extras.diferenciadores.title}</h2>
                    <p class="text-gray-600 font-light mt-4 whitespace-pre-wrap">{d.extras.diferenciadores.description}</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 diferenciadores-grid">
                    {
                        d.extras.diferenciadores.cards.map((card, i) => (
                            <div class="bg-white p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] transition-shadow duration-300 hover:shadow-[0_8px_30px_rgb(0,0,0,0.2)] group flex flex-col justify-between">
                                <div class="space-y-4">
                                    <div class="flex items-center gap-4">
                                        <div class="text-brand-lime flex items-center justify-center shrink-0">
                                            {card.icon && !esIconoSvg(card.icon) ? (
                                                <img src={card.icon} alt={card.title} class="w-6 h-6 object-contain" />
                                            ) : card.icon ? (
                                                <Fragment set:html={card.icon} />
                                            ) : (
                                                <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"> <path stroke-linecap="round" stroke-linejoin="round" d={diferenciadorIcons[i] ?? diferenciadorIcons[0]} /> </svg>
                                            )}
                                        </div>
                                        <h3 class="font-saira font-semibold italic text-brand-navy text-xl uppercase group-hover:text-brand-blue transition-colors leading-tight">{card.title}</h3>
                                    </div>
                                    <p class="text-sm text-gray-500 leading-relaxed font-light whitespace-pre-wrap">{card.description}</p>
                                </div>
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 07. INFORMACIÓN TÉCNICA (SISTEMAS DE CABINAS) -->
        <section class="py-16 bg-brand-lime/5 px-6 md:px-12 border-y border-gray-200/50 relative overflow-hidden" id="datos-tecnicos">
            <!-- Logo de fondo -->
            <img src="/images/soluciones/fondo-seccion.png" alt="" class="absolute top-1/2 -translate-y-1/2 -right-32 lg:-right-20 w-[400px] lg:w-[600px] opacity-10 invert mix-blend-multiply object-contain pointer-events-none z-0" />

            <div class="container mx-auto relative z-10">
                <div class="max-w-5xl mb-10 section-solucion-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.tipos.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">{d.tipos.title}</h2>
                    <p class="text-gray-600 font-light mt-4 whitespace-pre-wrap">
                        {d.tipos.description}
                    </p>
                </div>

                <!-- Tabs Navigation -->
                <div class="flex w-full border-b border-gray-200 mb-8 overflow-x-auto" id="tech-tabs-nav">
                    {d.tipos.tabs[0].active !== false && (
                    <button
                        class="tech-tab-btn active flex-1 py-4 px-2 border-b-2 border-brand-lime bg-brand-lime/10 rounded-t-xl text-brand-lime flex flex-col items-center justify-center gap-1 cursor-pointer select-none font-saira font-semibold italic text-base md:text-lg uppercase tracking-wider transition-colors min-w-[150px]"
                        data-tab="tab-liquida"
                    >
                        <span class="text-3xl font-light not-italic font-sans">{tabNums[0]}</span>
                        <span>{d.tipos.tabs[0].label}</span>
                    </button>
                    )}
                    {d.tipos.tabs[1].active !== false && (
                    <button
                        class="tech-tab-btn flex-1 py-4 px-2 border-b-2 border-transparent bg-transparent rounded-t-xl text-gray-400 hover:text-brand-lime hover:bg-brand-lime/5 flex flex-col items-center justify-center gap-1 cursor-pointer select-none font-saira font-semibold italic text-base md:text-lg uppercase tracking-wider transition-colors min-w-[150px]"
                        data-tab="tab-polvo"
                    >
                        <span class="text-3xl font-light not-italic font-sans">{tabNums[1]}</span>
                        <span>{d.tipos.tabs[1].label}</span>
                    </button>
                    )}
                </div>

                <!-- Tabs Content Panels -->
                <div id="tech-tabs-content" class="relative w-full">
                    <!-- Panel 1: Líquida -->
                    {d.tipos.tabs[0].active !== false && (
                    <div id="tab-liquida" class="tech-tab-panel transition-all duration-500 opacity-100 transform translate-y-0">
                        <!-- Intro Content -->
                        <div class="mb-12">
                            <div class="mb-10">
                                <p class="text-base text-gray-600 font-light leading-relaxed whitespace-pre-wrap">
                                    {d.tipos.tabs[0].description}
                                </p>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                                {
                                    d.tipos.tabs[0].cards.map((card, i) => (
                                        <div class="flex flex-col">
                                            <div class="flex items-center gap-3 mb-4">
                                                <div class="text-brand-lime flex items-center justify-center shrink-0">
                                                    <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d={tipoCardIcons[i] ?? tipoCardIcons[0]} />
                                                    </svg>
                                                </div>
                                                <h4 class="font-saira font-bold text-brand-navy text-xl uppercase italic">{card.title}</h4>
                                            </div>
                                            <p class="text-gray-600 font-light text-sm pl-10 lg:pl-0 whitespace-pre-wrap">{card.description}</p>
                                        </div>
                                    ))
                                }
                            </div>
                        </div>

                        <!-- Image + Design Types -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
                            <!-- Left Column: Image -->
                            <div class="w-full relative rounded-3xl overflow-hidden shadow-2xl h-[300px] md:h-[400px] lg:h-full lg:min-h-[550px]">
                                <img src={d.tipos.tabs[0].image} alt="Cabina de Pintura Líquida Industrial" class="w-full h-full object-cover absolute inset-0" />
                                <div class="absolute inset-0 bg-brand-navy/10 mix-blend-multiply"></div>
                            </div>

                            <!-- Right Column: Design Types -->
                            <div class="flex flex-col gap-4">
                                {
                                    d.tipos.tabs[0].items.map((item, i) => (
                                        <div class={i === 0 ? 'flex flex-col' : 'flex flex-col pt-2'}>
                                            <div class="flex items-center gap-3 mb-2">
                                                <svg class="w-5 h-5 text-brand-lime shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                                </svg>
                                                <h3 class="font-saira font-semibold text-xl text-brand-navy uppercase italic">{item.title}</h3>
                                            </div>
                                            <p class="text-sm font-light leading-relaxed text-gray-600 pl-8 whitespace-pre-wrap">{item.description}</p>
                                        </div>
                                    ))
                                }
                            </div>
                        </div>
                    </div>
                    )}

                    <!-- Panel 2: Polvo -->
                    {d.tipos.tabs[1].active !== false && (
                    <div id="tab-polvo" class="tech-tab-panel hidden transition-all duration-500 opacity-0 transform translate-y-4">
                        <!-- Intro Content -->
                        <div class="mb-12">
                            <p class="text-base text-gray-600 font-light leading-relaxed whitespace-pre-wrap">
                                {d.tipos.tabs[1].description}
                            </p>
                        </div>

                        <!-- Image + Categories -->
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-start">
                            <!-- Left Column: Image -->
                            <div class="w-full relative rounded-3xl overflow-hidden shadow-2xl h-[300px] md:h-[400px] lg:h-full lg:min-h-[550px]">
                                <img src={d.tipos.tabs[1].image} alt="Cabina de Pintura en Polvo Industrial" class="w-full h-full object-cover absolute inset-0" />
                                <div class="absolute inset-0 bg-brand-navy/10 mix-blend-multiply"></div>
                            </div>

                            <!-- Right Column: Categories -->
                            <div class="flex flex-col gap-4">
                                {
                                    d.tipos.tabs[1].items.map((item, i) => (
                                        <div class={i === 0 ? 'flex flex-col' : 'flex flex-col pt-2'}>
                                            <div class="flex items-center gap-3 mb-2">
                                                <svg class="w-5 h-5 text-brand-lime shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                                                </svg>
                                                <h3 class="font-saira font-semibold text-xl text-brand-navy uppercase italic">{item.title}</h3>
                                            </div>
                                            <p class="text-sm font-light leading-relaxed text-gray-600 pl-8 whitespace-pre-wrap">{item.description}</p>
                                        </div>
                                    ))
                                }
                            </div>
                        </div>
                    </div>
                    )}
                </div>
            </div>
        </section>

        <!-- 08. RESULTADOS Y VENTAJAS (CONCLUSIÓN) -->
        <section class="py-20 bg-industrial-gray px-6 md:px-12" id="conclusion">
            <div class="container mx-auto max-w-5xl">
                <div class="bg-gradient-to-br from-brand-navy to-brand-blue/90 text-white rounded-3xl p-8 md:p-12 shadow-2xl relative overflow-hidden border border-white/10">
                    <div class="absolute top-0 right-0 w-64 h-64 bg-brand-lime/10 rounded-full blur-3xl -z-10"></div>
                    <div class="absolute bottom-0 left-0 w-64 h-64 bg-brand-blue/10 rounded-full blur-3xl -z-10"></div>

                    <div class="flex flex-col lg:flex-row items-center gap-8 lg:gap-12 relative z-10">
                        <div class="shrink-0 text-brand-lime">
                            <svg class="w-16 h-16 opacity-80" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path>
                            </svg>
                        </div>
                        <div class="space-y-6">
                            <h3 class="text-brand-lime font-saira font-bold uppercase tracking-widest">{d.extras.conclusion.title}</h3>
                            <p class="text-xl font-light leading-relaxed text-gray-200 whitespace-pre-wrap">
                                {d.extras.conclusion.items[0].text}
                            </p>
                            <p class="text-base md:text-lg font-light leading-relaxed text-gray-300 border-t border-white/10 pt-6 whitespace-pre-wrap">
                                {d.extras.conclusion.items[1].text}
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 09. SEGUNDO CTA -->
        <section class="py-16 relative flex items-center justify-center overflow-hidden px-6">
            <img src={d.cta2.image} alt="Ingenieros interactuando con maquinaria" class="absolute top-1/2 left-0 w-full h-[130%] -translate-y-1/2 object-cover z-0" />
            <div class="absolute inset-0 bg-brand-navy/90 z-10 mix-blend-multiply"></div>

            <div class="container mx-auto max-w-4xl text-center space-y-6 relative z-20">
                <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-white uppercase tracking-wider">{d.cta2.title}</h2>
                <p class="text-gray-300 font-light text-base md:text-lg max-w-2xl mx-auto whitespace-pre-wrap">{d.cta2.description}</p>
                <div class="pt-8">
                    <a href={d.cta2.button_url} class="inline-block bg-brand-lime text-brand-navy font-bold uppercase tracking-widest px-10 py-4 rounded hover:bg-white transition-all duration-300 shadow-lg hover:-translate-y-1">{d.cta2.button_label}</a>
                </div>
            </div>
        </section>

        <!-- 10. NORMATIVIDAD -->
        <section class="py-16 bg-brand-navy text-white px-6 md:px-12" id="normas">
            <div class="container mx-auto max-w-6xl">
                <div class="flex flex-col lg:flex-row items-center justify-between gap-12">
                    <div class="lg:w-1/2 space-y-6 norms-text">
                        <div>
                            <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{general.normas?.badge}</span>
                            <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-white uppercase mt-4 leading-tight">{general.normas?.title}</h2>
                            <p class="text-gray-300 font-light leading-relaxed mt-4 whitespace-pre-wrap">
                                {general.normas?.description}
                            </p>
                        </div>

                        <p class="text-gray-400 font-light text-xs border-t border-white/10 pt-4 whitespace-pre-wrap">
                            {general.normas?.text}
                        </p>
                    </div>

                    <div class="lg:w-1/2 w-full">
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 norms-grid">
                            {
                                certificados.map((cert) => (
                                    <div class="bg-white rounded-xl p-4 flex flex-col items-center justify-center shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group border border-transparent hover:border-brand-lime">
                                        <div class="h-14 w-full flex items-center justify-center mb-2">
                                            <img src={cert.logo} alt={`Certificación ${cert.name}`} class="max-h-full max-w-full object-contain transition-all duration-300" />
                                        </div>
                                    </div>
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 11. ALIANZAS / PARTNERS -->
        <section class="bg-white py-4 border-y border-gray-200 overflow-hidden flex items-center">
            <div class="container mx-auto px-6 flex flex-col md:flex-row items-center gap-6">
                <span class="text-gray-500 font-medium whitespace-nowrap text-sm mt-1 uppercase tracking-wide"> {general.aliados?.title} </span>
                <div class="swiper marquee-swiper w-full">
                    <div class="swiper-wrapper items-center">
                        {[...(general.aliados?.logos ?? []), ...(general.aliados?.logos ?? [])].map((aliado) => (
                            <div class="swiper-slide !w-auto px-8 flex items-center justify-center">
                                <img src={aliado.image} alt={aliado.name} class="h-auto max-h-9 w-auto max-w-full object-contain opacity-60 grayscale hover:grayscale-0 transition-all" />
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <!-- 12. PREGUNTAS FRECUENTES -->
        <section class="py-16 bg-industrial-gray px-6 md:px-12 border-t border-gray-200/50" id="faq">
            <div class="container mx-auto max-w-4xl">
                <div class="text-center mb-16 faq-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.faqs.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">{d.faqs.title}</h2>
                </div>

                <div class="space-y-4">
                    {
                        d.faqs.items.map((faq, i) => (
                            <details name="faq" class="group border border-gray-300/80 rounded-xl bg-white overflow-hidden transition-all duration-300 open:shadow-md" open={i === 0}>
                                <summary class="flex justify-between items-center px-6 py-5 font-saira font-semibold italic text-brand-navy uppercase text-base md:text-lg cursor-pointer hover:bg-gray-50 transition-colors list-none select-none">
                                    <span>{faq.question}</span>
                                    <span class="w-6 h-6 rounded-full bg-brand-navy/5 flex items-center justify-center text-brand-navy font-bold text-xl after:content-['+'] group-open:after:content-['-']" />
                                </summary>
                                <div class="px-6 pb-6 pt-2 border-t border-gray-100 text-gray-600 font-light text-base leading-relaxed details-content-reveal whitespace-pre-wrap">{faq.answer}</div>
                            </details>
                        ))
                    }
                </div>
            </div>
        </section>

        <!-- 13. GALERÍA DE PROYECTOS -->
        <section class="py-16 bg-white px-6 md:px-12" id="galeria">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 gallery-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">{d.galeria.badge}</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">{d.galeria.title}</h2>
                    <p class="text-gray-600 mt-4 font-light whitespace-pre-wrap">{d.galeria.description}</p>
                </div>

                <!-- Grid layout -->
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6 gallery-grid">
                    {
                        d.galeria.images.map((img) => (
                            <div class="relative overflow-hidden rounded-lg shadow group border border-gray-200">
                                <img src={img.image} alt={img.alt} class="w-full h-64 object-cover transform group-hover:scale-105 transition-transform duration-500" />
                            </div>
                        ))
                    }
                </div>
            </div>
        </section>
    </main>

    <!-- CDNs y Configuración de Animación Scroll / Lenis -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            // 1. Inicializar Lenis (Smooth Scroll)
            const lenis = new Lenis({
                duration: 1.2,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                smoothWheel: true,
            })
            function raf(time) {
                lenis.raf(time)
                requestAnimationFrame(raf)
            }
            requestAnimationFrame(raf)

            // 2. Conectar GSAP con Lenis y animar
            if (typeof gsap !== 'undefined') {
                gsap.ticker.add((time) => {
                    lenis.raf(time * 1000)
                })
                gsap.ticker.lagSmoothing(0)

                // Actualizar ScrollTrigger con Lenis scroll
                if (typeof ScrollTrigger !== 'undefined') {
                    lenis.on('scroll', ScrollTrigger.update)
                }

                // Animación Hero al cargar
                gsap.from('.hero-section-text > *', {
                    y: 35,
                    opacity: 0,
                    duration: 1,
                    stagger: 0.15,
                    ease: 'power3.out',
                })

                // Animaciones al hacer scroll con ScrollTrigger
                if (typeof ScrollTrigger !== 'undefined') {
                    // Animación Introducción
                    gsap.from('.intro-text > *', {
                        scrollTrigger: { trigger: '#introduccion', start: 'top 80%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.8,
                        stagger: 0.12,
                        ease: 'power2.out',
                    })
                    gsap.from('.intro-image', {
                        scrollTrigger: { trigger: '#introduccion', start: 'top 80%' },
                        x: 40,
                        opacity: 0,
                        duration: 0.9,
                        ease: 'power2.out',
                    })

                    // Pain points grid
                    gsap.from('.pain-points-grid > div', {
                        scrollTrigger: { trigger: '.pain-points-grid', start: 'top 85%' },
                        y: 40,
                        opacity: 0,
                        duration: 0.8,
                        stagger: 0.15,
                        ease: 'power2.out',
                    })

                    // Ingeniería grid
                    gsap.from('#ingenieria .grid > div', {
                        scrollTrigger: { trigger: '#ingenieria', start: 'top 80%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.7,
                        stagger: 0.15,
                        ease: 'power2.out',
                        clearProps: 'all',
                    })

                    // Diferenciadores grid
                    gsap.from('.diferenciadores-grid > div', {
                        scrollTrigger: {
                            trigger: '.diferenciadores-grid',
                            start: 'top 85%',
                        },
                        y: 30,
                        opacity: 0,
                        duration: 0.7,
                        stagger: 0.15,
                        ease: 'power2.out',
                    })

                    // Especificaciones
                    gsap.from('#datos-tecnicos table, #datos-tecnicos .grid > div', {
                        scrollTrigger: { trigger: '#datos-tecnicos', start: 'top 80%' },
                        y: 40,
                        opacity: 0,
                        duration: 0.8,
                        stagger: 0.15,
                        ease: 'power2.out',
                    })

                    // Conclusión
                    gsap.from('#conclusion > div', {
                        scrollTrigger: { trigger: '#conclusion', start: 'top 85%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.8,
                        ease: 'power2.out',
                    })

                    // Normativas text
                    gsap.from('.norms-text > *', {
                        scrollTrigger: { trigger: '#normas', start: 'top 80%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.8,
                        stagger: 0.12,
                        ease: 'power2.out',
                    })

                    // Normativas grid items
                    gsap.from('.norms-grid > div', {
                        scrollTrigger: { trigger: '.norms-grid', start: 'top 85%' },
                        y: 20,
                        opacity: 0,
                        duration: 0.6,
                        stagger: 0.1,
                        ease: 'power2.out',
                        clearProps: 'opacity,transform',
                    })

                    // FAQ list
                    gsap.from('#faq details', {
                        scrollTrigger: { trigger: '#faq', start: 'top 80%' },
                        y: 20,
                        opacity: 0,
                        duration: 0.6,
                        stagger: 0.1,
                        ease: 'power2.out',
                        clearProps: 'opacity,transform',
                    })

                    // Gallery grid
                    gsap.from('.gallery-grid > div', {
                        scrollTrigger: { trigger: '.gallery-grid', start: 'top 85%' },
                        y: 30,
                        opacity: 0,
                        duration: 0.7,
                        stagger: 0.12,
                        ease: 'power2.out',
                        clearProps: 'opacity,transform',
                    })
                }
            }

            // 3. Inicializar Marquee Swiper
            if (typeof Swiper !== 'undefined') {
                new Swiper('.marquee-swiper', {
                    loop: true,
                    speed: 3000,
                    autoplay: {
                        delay: 0,
                        disableOnInteraction: false,
                    },
                    slidesPerView: 'auto',
                    spaceBetween: 10,
                    allowTouchMove: false,
                    freeMode: true,
                })
            }

            // 5. Controlador de Tabs Técnicos
            const tabBtns = document.querySelectorAll('.tech-tab-btn')
            const tabPanels = document.querySelectorAll('.tech-tab-panel')

            tabBtns.forEach((btn) => {
                btn.addEventListener('click', () => {
                    const targetTabId = btn.getAttribute('data-tab')

                    tabBtns.forEach((b) => {
                        b.classList.remove('active', 'border-brand-lime', 'text-brand-lime', 'bg-brand-lime/10')
                        b.classList.add('border-transparent', 'text-gray-400', 'bg-transparent')
                    })

                    btn.classList.add('active', 'border-brand-lime', 'text-brand-lime', 'bg-brand-lime/10')
                    btn.classList.remove('border-transparent', 'text-gray-400', 'bg-transparent')

                    tabPanels.forEach((panel) => {
                        panel.classList.add('hidden', 'opacity-0', 'translate-y-4')
                        panel.classList.remove('opacity-100', 'translate-y-0')
                    })

                    const activePanel = document.getElementById(targetTabId)
                    if (activePanel) {
                        activePanel.classList.remove('hidden')
                        setTimeout(() => {
                            activePanel.classList.remove('opacity-0', 'translate-y-4')
                            activePanel.classList.add('opacity-100', 'translate-y-0')
                        }, 20)
                    }

                    if (typeof ScrollTrigger !== 'undefined') {
                        ScrollTrigger.refresh()
                    }
                })
            })
        })

        // 4. Refrescar ScrollTrigger al cargar completamente la página (imágenes, fuentes, etc.)
        window.addEventListener('load', () => {
            if (typeof ScrollTrigger !== 'undefined') {
                ScrollTrigger.refresh()
            }
        })
    
    // Si la primera pestaña técnica está inactiva, activar la primera visible
    document.addEventListener('DOMContentLoaded', () => {
        const techBtns = document.querySelectorAll('.tech-tab-btn')
        if (techBtns.length && !document.querySelector('.tech-tab-btn.active')) {
            techBtns[0].click()
        }
    })
</script>
</Layout>

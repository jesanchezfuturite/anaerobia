---
import Layout from "../../layouts/Layout.astro";
import Footer from "../../components/Footer.astro";
import { getEntry } from "astro:content";

// Obtener datos de la página de inicio para reutilizar logos de normativas
const homepageEntry = await getEntry("homepage", "index");
const homepageData = homepageEntry?.data || {};
const certificados = homepageData.normativas?.certificados || [
  { name: "NFPA", logo: "/images/home/certificaciones/nfpa.png" },
  { name: "EPA", logo: "/images/home/certificaciones/epa.svg" },
  { name: "ETL", logo: "/images/home/certificaciones/etl.png" },
  { name: "ICC", logo: "/images/home/certificaciones/icc.png" },
  { name: "OSHA", logo: "/images/home/certificaciones/osha.png" },
];

// SEO Metadata
const seoTitle = "Cabinas de Pintura Industriales | Anaerobia";
const seoDescription =
  "Diseñadas para la aplicación de pintura de alta tecnología, bajo los más altos estándares de calidad y protección ambiental.";
---

<Layout title={seoTitle} description={seoDescription}>
  <main class="bg-industrial-gray min-h-screen text-brand-navy">
    <!-- 01. HEADER / HERO -->
    <section
      class="relative min-h-[60vh] flex items-center pt-36 pb-20 bg-brand-navy overflow-hidden"
    >
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0 z-0">
        <img
          src="/images/home/soluciones/cards/3/image.webp"
          alt="Cabinas de Pintura Industrial"
          class="w-full h-full object-cover opacity-60 scale-105"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/85 to-brand-navy/60"
        >
        </div>
      </div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl hero-section-text">
          <!-- Breadcrumbs -->
          <nav
            class="flex items-center gap-2 text-xs md:text-sm text-gray-400 font-semibold uppercase tracking-widest mb-6"
          >
            <a href="/" class="text-gray-300 hover:text-brand-lime transition-colors"
              >Inicio</a
            >
            <span>/</span>
            <span class="text-gray-400">Soluciones</span>
            <span>/</span>
            <span class="text-brand-lime">Cabinas de Pintura</span>
          </nav>

          <span
            class="inline-block bg-brand-lime/10 text-brand-lime border border-brand-lime/20 rounded px-3 py-1 text-xs font-semibold uppercase tracking-widest mb-6"
          >
            INTEGRACIÓN DE SISTEMAS DE ACABADOS SUPERFICIALES
          </span>
          <h1
            class="text-white font-saira italic font-semibold uppercase text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] mb-6"
          >
            Cabinas de Pintura
          </h1>
          <p
            class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed"
          >
            Diseñadas para la aplicación de pintura de alta tecnología, bajo los más altos estándares de calidad y protección ambiental.
          </p>
        </div>
      </div>
    </section>

    <!-- 02. INTRODUCCIÓN -->
    <section
      class="py-16 bg-white px-6 md:px-12 relative overflow-hidden"
      id="introduccion"
    >
      <div class="container mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div class="space-y-8 intro-text">
            <div>
              <span
                class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full"
                >Ingeniería y Tecnología</span
              >
              <h2
                class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4 mb-6 leading-tight"
              >
                ¿Por qué es importante una cabina de pintura?
              </h2>
              <p
                class="text-gray-600 leading-relaxed font-light text-base md:text-lg"
              >
                La cabina de pintura es fundamental en los procesos industriales de acabado, y su importancia se manifiesta en varios aspectos clave, como la calidad y precisión en el acabado, la seguridad para los operadores y el cumplimiento de normativas ambientales y de seguridad. Al tener un espacio controlado y optimizado para el pintado, se mejora la eficiencia operativa, permitiendo obtener resultados consistentes.
              </p>
            </div>

            <!-- Key pillars (Experiencia, Soporte local, Normativa) -->
            <div
              class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-4 border-t border-gray-100"
            >
              <div class="space-y-2">
                <div
                  class="flex items-center justify-center w-10 h-10 rounded bg-brand-lime/10 text-brand-lime"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    ></path>
                  </svg>
                </div>
                <h3
                  class="font-saira font-semibold italic text-brand-navy text-base uppercase"
                >
                  Experiencia
                </h3>
                <p class="text-xs text-gray-500 leading-relaxed">
                  Nuestro equipo cuenta con la preparación y experiencia
                  necesaria para afrontar los desafíos de la industria.
                </p>
              </div>

              <div class="space-y-2">
                <div
                  class="flex items-center justify-center w-10 h-10 rounded bg-brand-blue/10 text-brand-blue"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                    ></path>
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  </svg>
                </div>
                <h3
                  class="font-saira font-semibold italic text-brand-navy text-base uppercase"
                >
                  Soporte Nacional
                </h3>
                <p class="text-xs text-gray-500 leading-relaxed">
                  Estamos presentes en los centros industriales del país para
                  dar acompañamiento cercano y puntual a nuestros clientes.
                </p>
              </div>

              <div class="space-y-2">
                <div
                  class="flex items-center justify-center w-10 h-10 rounded bg-brand-navy/10 text-brand-navy"
                >
                  <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    ></path>
                  </svg>
                </div>
                <h3
                  class="font-saira font-semibold italic text-brand-navy text-base uppercase"
                >
                  Normativa
                </h3>
                <p class="text-xs text-gray-500 leading-relaxed">
                  Nuestros equipos cumplen con normativas internacionales y
                  nacionales.
                </p>
              </div>
            </div>
          </div>

          <!-- Intro Image -->
          <div class="relative intro-image group">
            <div
              class="relative rounded-lg overflow-hidden shadow-2xl"
            >
              <img
                src="/images/soluciones/pintura_liquida_2.webp"
                alt="Proceso de Pintura Líquida Automatizada"
                class="w-full h-auto object-cover transform hover:scale-[1.02] transition-transform duration-700"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 03. PROBLEMA / NECESIDAD (PAIN POINTS) -->
    <section
      class="py-16 bg-industrial-gray px-6 md:px-12 border-t border-gray-200/50"
    >
      <div class="container mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 pain-points-header">
          <span
            class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full"
            >Desafíos</span
          >
          <h2
            class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4"
          >
            Puntos de Inflexión Comunes en la Línea de Pintura
          </h2>
          <p class="text-gray-600 mt-4 font-light">
            Las operaciones de manufactura de alto volumen a menudo enfrentan
            ineficiencias críticas que elevan el costo por pieza y afectan la
            calidad estética final.
          </p>
        </div>

                <div class="flex flex-col lg:flex-row gap-8 lg:h-[600px] w-full max-w-7xl mx-auto pain-points-grid items-stretch">
          <!-- Column 1: Image (45%) -->
          <div class="w-full lg:w-[45%] relative rounded-3xl overflow-hidden shadow-2xl h-[400px] lg:h-auto shrink-0 group">
             <img src="/images/soluciones/pintura_liquida_2.webp" alt="Puntos de Inflexión" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
             <div class="absolute inset-0 bg-brand-navy/30 mix-blend-multiply"></div>
          </div>
          
          <!-- Column 2: Cards (20%) -->
          <div class="w-full lg:w-[20%] flex flex-col justify-between gap-4 shrink-0 h-full">
<!-- Card 1 -->
            <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 lg:h-[32%] min-h-[100px]">
              <p class="text-lg lg:text-xl font-saira font-bold italic text-brand-blue leading-snug text-center">Desperdicio de pintura de hasta un 60%</p>
            </div>

            <!-- Card 2 -->
            <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 lg:h-[36%] min-h-[120px]">
              <p class="text-lg lg:text-xl font-saira font-bold italic text-brand-blue leading-snug text-center">Sobrecosto térmico e ineficiencia eléctrica</p>
            </div>

            <!-- Card 3 -->
            <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 lg:h-[32%] min-h-[100px]">
              <p class="text-lg lg:text-xl font-saira font-bold italic text-brand-blue leading-snug text-center">Tasa de rechazo y retrabajos elevados</p>
            </div>
          </div>

          <!-- Column 3: Content (35%) -->
          <div class="w-full lg:w-[35%] flex flex-col justify-center space-y-10 shrink-0 lg:pl-2">
            <!-- Item 1 -->
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <div class="text-brand-lime shrink-0">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                  </svg>
                </div>
                <h3 class="font-saira font-bold italic text-brand-navy text-xl md:text-2xl uppercase">
                  Baja Eficiencia de Transferencia
                </h3>
              </div>
              <p class="text-base text-gray-600 leading-relaxed font-light">
                El exceso de pintura desperdiciada (overspray) no solo eleva los
                costos operativos de materia prima, sino que satura los filtros
                rápidamente e incrementa los desechos químicos.
              </p>
            </div>

            <!-- Item 2 -->
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <div class="text-brand-lime shrink-0">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                </div>
                <h3 class="font-saira font-bold italic text-brand-navy text-xl md:text-2xl uppercase">
                  Altos Costos de Energía
                </h3>
              </div>
              <p class="text-base text-gray-600 leading-relaxed font-light">
                El curado o secado térmico ineficiente en hornos que no retienen
                el calor o cabinas con exceso de ventilación desbalanceada
                dispara el consumo eléctrico y de gas natural.
              </p>
            </div>

            <!-- Item 3 -->
            <div class="space-y-3">
              <div class="flex items-center gap-3">
                <div class="text-brand-lime shrink-0">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 13v-8a1 1 0 0 0 -1 -1h-2a1 1 0 0 0 -1 1v7a1 1 0 0 0 1 1h3a4 4 0 0 1 4 4v1a2 2 0 0 0 4 0v-5h3a2 2 0 0 0 2 -2l-1 -5a2 3 0 0 0 -2 -2h-7a3 3 0 0 0 -3 3"></path>
                  </svg>
                </div>
                <h3 class="font-saira font-bold italic text-brand-navy text-xl md:text-2xl uppercase">
                  Defectos de Acabado (Clase A)
                </h3>
              </div>
              <p class="text-base text-gray-600 leading-relaxed font-light">
                Variación de espesor, ojos de pescado por grasa remanente, y
                desprendimientos por pretratamientos mal controlados derivan en
                altos porcentajes de rechazo y retrabajos costosos.
              </p>
            </div>
          </div>          </div>
        </div>

      </div>
    </section>

    <!-- 04. PRIMER CTA PERSONALIZADO -->
    <section class="py-16 bg-brand-navy relative overflow-hidden">
      <div
        class="absolute inset-0 bg-gradient-to-r from-brand-navy via-brand-navy to-brand-blue/50 opacity-90"
      >
      </div>
      <div
        class="container mx-auto px-6 relative z-10 flex flex-col md:flex-row items-center justify-between gap-8"
      >
        <div class="text-left">
          <h2
            class="text-white text-2xl md:text-3xl font-saira italic font-semibold uppercase"
          >
            ¿Requieres automatizar o diseñar tu línea de pintura líquida?
          </h2>
          <p
            class="text-gray-300 text-sm md:text-base font-light mt-2 max-w-xl"
          >
            Diseñamos un sistema a la medida adaptado a los alcances específicos
            de tu producción.
          </p>
        </div>
        <a
          href="/contacto?solucion=pintura-liquida"
          class="bg-brand-lime text-brand-navy font-bold uppercase tracking-widest px-8 py-4 rounded hover:brightness-110 transition-all shadow-lg shrink-0 text-center"
        >
          Solicitar Cotización
        </a>
      </div>
    </section>

        
    <!-- 03. BENEFICIOS / IMPORTANCIA -->
    <section
      class="py-16 bg-industrial-gray px-6 md:px-12 border-t border-gray-200/50"
    >
      <div class="container mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-16 pain-points-header">
          <span
            class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full"
            >Beneficios</span
          >
          <h2
            class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4"
          >
            ¿Por qué es importante una cabina de pintura?
          </h2>
          <p class="text-gray-600 mt-4 font-light">
            La cabina de pintura es fundamental en los procesos industriales de acabado, y su importancia se manifiesta en varios aspectos clave.
          </p>
        </div>

        <div class="flex flex-col lg:flex-row gap-8 lg:h-[750px] w-full max-w-7xl mx-auto pain-points-grid items-stretch">
          <!-- Column 1: Image (45%) -->
          <div class="w-full lg:w-[45%] relative rounded-3xl overflow-hidden shadow-2xl h-[400px] lg:h-auto shrink-0 group">
             <img src="/images/soluciones/cabinas-pintura/MiConv.com__DSC_2370-scaled.jpg" alt="Importancia de la Cabina de Pintura" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
             <div class="absolute inset-0 bg-brand-navy/10 mix-blend-multiply"></div>
          </div>
          
          <!-- Column 2: Cards (20%) -->
          <div class="w-full lg:w-[20%] flex flex-col justify-between gap-4 shrink-0 h-full">
            <!-- Card 1 -->
            <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-4 lg:h-[25%] min-h-[100px]">
              <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Acabados uniformes, duraderos y de alta adherencia</p>
            </div>

            <!-- Card 2 -->
            <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-4 lg:h-[25%] min-h-[100px]">
              <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Extracción controlada de vapores y productos tóxicos</p>
            </div>

            <!-- Card 3 -->
            <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-4 lg:h-[25%] min-h-[100px]">
              <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Cumplimiento normativo (OSHA, NFPA, EPA)</p>
            </div>

            <!-- Card 4 -->
            <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-4 lg:h-[25%] min-h-[100px]">
              <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Reducción de procesos por defectos en el acabado</p>
            </div>
          </div>

          <!-- Column 3: Content (35%) -->
          <div class="w-full lg:w-[35%] flex flex-col justify-center space-y-6 shrink-0 lg:pl-2">
            
            <!-- Item 1 -->
            <div class="space-y-2">
              <div class="flex items-center gap-3">
                <div class="text-brand-lime shrink-0">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                  </svg>
                </div>
                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase leading-tight">
                  Calidad y precisión en el acabado
                </h3>
              </div>
              <p class="text-sm lg:text-base text-gray-600 leading-relaxed font-light">
                Las cabinas de pintura protegen las superficies de agentes externos, como polvo y partículas, lo que permite obtener acabados uniformes y duraderos. La pintura aplicada en condiciones controladas tiene mejor adherencia, lo que incrementa la resistencia de la capa de pintura a factores ambientales y mecánicos.
              </p>
            </div>

            <!-- Item 2 -->
            <div class="space-y-2">
              <div class="flex items-center gap-3">
                <div class="text-brand-lime shrink-0">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                  </svg>
                </div>
                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase leading-tight">
                  Seguridad para los operadores
                </h3>
              </div>
              <p class="text-sm lg:text-base text-gray-600 leading-relaxed font-light">
                Durante el proceso de pintura, los trabajadores pueden exponerse a vapores y productos químicos tóxicos, especialmente si se trabaja con solventes. La cabina permite contener y extraer estos vapores de forma controlada, minimizando el riesgo de intoxicación o daños a la salud.
              </p>
            </div>

            <!-- Item 3 -->
            <div class="space-y-2">
              <div class="flex items-center gap-3">
                <div class="text-brand-lime shrink-0">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                  </svg>
                </div>
                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase leading-tight">
                  Cumplimiento de normativas ambientales y de seguridad
                </h3>
              </div>
              <p class="text-sm lg:text-base text-gray-600 leading-relaxed font-light">
                Las cabinas de pintura permiten cumplir con regulaciones industriales de seguridad, como las de la Administración de Seguridad y Salud Ocupacional (OSHA), National Fire Protection Association (NFPA) y Environmental Protection Agency (EPA) en Estados Unidos y de otras normativas internacionales, que exigen condiciones de trabajo seguras y limpias.
              </p>
            </div>

            <!-- Item 4 -->
            <div class="space-y-2">
              <div class="flex items-center gap-3">
                <div class="text-brand-lime shrink-0">
                  <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                  </svg>
                </div>
                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase leading-tight">
                  Eficiencia en el proceso
                </h3>
              </div>
              <p class="text-sm lg:text-base text-gray-600 leading-relaxed font-light">
                Al tener un espacio controlado y optimizado para el pintado, se mejora la eficiencia operativa, permitiendo obtener resultados consistentes y minimizando la repetición de procesos por defectos o imperfecciones en el acabado.
              </p>
            </div>

          </div>
        </div>

      </div>
    </section>

    <!-- 05\. SOLUCIONES DE CABINAS DE PINTURA \(TABS\) -->

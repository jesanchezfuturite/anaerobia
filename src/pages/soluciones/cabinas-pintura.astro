---
import Layout from '../../layouts/Layout.astro'
import Footer from '../../components/Footer.astro'
import { getEntry } from 'astro:content'

// Obtener datos de la página de inicio para reutilizar logos de normativas
const homepageEntry = await getEntry('homepage', 'index')
const homepageData = homepageEntry?.data || {}
const certificados = homepageData.normativas?.certificados || [
    { name: 'NFPA', logo: '/images/home/certificaciones/nfpa.png' },
    { name: 'EPA', logo: '/images/home/certificaciones/epa.svg' },
    { name: 'ETL', logo: '/images/home/certificaciones/etl.png' },
    { name: 'ICC', logo: '/images/home/certificaciones/icc.png' },
    { name: 'OSHA', logo: '/images/home/certificaciones/osha.png' },
]

// SEO Metadata
const seoTitle = 'Cabinas de Pintura Industriales | Anaerobia'
const seoDescription = 'Nuestras cabinas de pintura integran tecnología de vanguardia para garantizar una buena calidad en el acabado, optimizando el consumo de material y asegurando el cumplimiento estricto de las normativas de protección ambiental más exigentes del mercado internacional.'
---

<Layout title={seoTitle} description={seoDescription}>
    <main class="bg-industrial-gray min-h-screen text-brand-navy">
        <!-- 01. HEADER / HERO -->
        <section class="relative min-h-[60vh] flex items-center pt-36 pb-20 bg-brand-navy overflow-hidden">
            <!-- Background Image with Overlay -->
            <div class="absolute inset-0 z-0">
                <img src="/images/soluciones/cabinas-pintura/cabina-pintura-7.webp" alt="Cabinas de Pintura Industrial" class="w-full h-full object-cover opacity-60 scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/85 to-brand-navy/60"></div>
            </div>

            <div class="container mx-auto px-6 relative z-10">
                <div class="max-w-4xl hero-section-text">
                    <!-- Breadcrumbs -->
                    <nav class="flex items-center gap-2 text-xs md:text-sm text-gray-400 font-semibold uppercase tracking-widest mb-6">
                        <a href="/" class="text-gray-300 hover:text-brand-lime transition-colors">Inicio</a>
                        <span>/</span>
                        <span class="text-gray-400">Soluciones</span>
                        <span>/</span>
                        <span class="text-brand-lime">Cabinas de Pintura</span>
                    </nav>

                    <span class="inline-block bg-brand-lime/10 text-brand-lime border border-brand-lime/20 rounded px-3 py-1 text-xs font-semibold uppercase tracking-widest mb-6"> INTEGRACIÓN DE SISTEMAS DE ACABADOS SUPERFICIALES </span>
                    <h1 class="text-white font-saira italic font-semibold uppercase text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] mb-6">Cabinas de Pintura</h1>
                    <p class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed">Nuestras cabinas de pintura integran tecnología de vanguardia para garantizar una buena calidad en el acabado, optimizando el consumo de material y asegurando el cumplimiento estricto de las normativas de protección ambiental más exigentes del mercado internacional.</p>
                </div>
            </div>
        </section>

        <!-- 02. INTRODUCCIÓN -->
        <section class="py-16 bg-white px-6 md:px-12 relative overflow-hidden" id="introduccion">
            <div class="container mx-auto">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                    <div class="space-y-8 intro-text">
                        <div>
                            <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Ingeniería y Tecnología</span>
                            <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4 mb-6 leading-tight">¿Qué es una cabina de pintura?</h2>
                            <p class="text-gray-600 leading-relaxed font-light text-base md:text-lg">
                                Las cabinas de pintura son instalaciones especializadas diseñadas para proporcionar un entorno controlado y seguro durante la aplicación de pintura en diversas ramas industriales, tales como la automotriz, aeronáutica, metalúrgica, de electrodomésticos, mobiliarios, etc.
                            </p>
                            <p class="text-gray-600 leading-relaxed font-light text-base md:text-lg mt-4">
                                Estas cabinas integran sistemas avanzados de filtración, ventilación mecánica y control térmico. Su función principal es mover el flujo de aire de forma calculada a través de una cámara de trabajo y un sistema de escape para capturar eficazmente la sobre pulverización y los vapores nocivos generados durante el proceso.
                            </p>
                            <p class="text-brand-navy font-saira font-bold uppercase italic mt-6 border-l-4 border-brand-lime pl-4 text-base md:text-lg">Mejoramos la industria del mundo con ingeniería especializada y alta tecnología.</p>
                        </div>
                    </div>

                    <!-- Intro Image -->
                    <div class="relative intro-image group">
                        <div class="relative rounded-lg overflow-hidden shadow-2xl">
                            <img src="/images/soluciones/cabinas-pintura/cabina-pintura-20.webp" alt="Instalación de Cabina de Pintura Industrial" class="w-full h-auto object-cover transform hover:scale-[1.02] transition-transform duration-700" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 03. PROBLEMA / NECESIDAD (PAIN POINTS) -->
        <!-- 03. IMPORTANCIA / NECESIDAD -->
        <section class="py-16 bg-industrial-gray px-6 md:px-12 border-t border-gray-200/50">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 pain-points-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Desafíos</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Desafíos en el área de pintura</h2>
                    <p class="text-gray-600 mt-4 font-light">Cuando un proceso industrial de acabado opera sin una cabina de pintura de alta ingeniería, se enfrenta a riesgos que impactan directamente en la calidad de la pieza final</p>
                </div>

                <div class="flex flex-col lg:flex-row gap-8 lg:min-h-[700px] w-full max-w-7xl mx-auto pain-points-grid items-stretch">
                    <!-- Column 1: Image (45%) -->
                    <div class="w-full lg:w-[45%] relative rounded-3xl overflow-hidden shadow-2xl h-[400px] lg:h-auto shrink-0 group">
                        <img src="/images/soluciones/cabinas-pintura/cabina-pintura-2.webp" alt="Importancia de la Cabina de Pintura" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-navy/30 mix-blend-multiply"></div>
                    </div>

                    <!-- Column 2: Cards (20%) -->
                    <div class="w-full lg:w-[20%] flex flex-col justify-between gap-4 shrink-0 h-full">
                        <!-- Card 1 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 flex-1 lg:min-h-[200px]">
                            <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Defectos superficiales y poca precisión en el acabado</p>
                        </div>

                        <!-- Card 2 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 flex-1 lg:min-h-[200px]">
                            <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Exposición y riesgos para los operadores</p>
                        </div>

                        <!-- Card 3 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 flex-1 lg:min-h-[240px]">
                            <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Sanciones por incumplimiento normativo</p>
                        </div>

                        <!-- Card 4 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 flex-1 lg:min-h-[200px]">
                            <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Riesgo de incendios</p>
                        </div>
                    </div>

                    <!-- Column 3: Content (35%) -->
                    <div class="w-full lg:w-[35%] flex flex-col justify-between space-y-4 shrink-0 lg:pl-2 h-full py-2">
                        <!-- Item 1 -->
                        <div class="space-y-2 flex-1 flex flex-col justify-start pt-1 lg:min-h-[200px]">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase">Defectos superficiales y poca precisión en el acabado</h3>
                            </div>
                            <p class="text-sm text-gray-600 leading-relaxed font-light">
                                La falta de un entorno aislado expone las piezas a agentes externos como polvo y partículas que afectan la uniformidad del acabado, debilitan el desempeño del recubrimiento y comprometen la resistencia de la capa de pintura a factores ambientales y mecánicos.
                            </p>
                        </div>

                        <!-- Item 2 -->
                        <div class="space-y-2 flex-1 flex flex-col justify-start pt-1 lg:min-h-[200px]">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase">Exposición y riesgos para los operadores</h3>
                            </div>
                            <p class="text-sm text-gray-600 leading-relaxed font-light">
                                Durante la aplicación, el personal queda expuesto directamente a vapores y productos químicos tóxicos especialmente en sistemas con solventes. La ausencia de una extracción controlada y dirigida eleva drásticamente los riesgos de intoxicación o daños en la salud de los trabajadores.
                            </p>
                        </div>

                        <!-- Item 3 -->
                        <div class="space-y-2 flex-1 flex flex-col justify-start pt-1 lg:min-h-[240px]">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase">Sanciones por incumplimiento de normativas ambientales y de seguridad</h3>
                            </div>
                            <p class="text-sm text-gray-600 leading-relaxed font-light">
                                Operar sin el cumplimiento de regulaciones industriales de seguridad como la de Administración de Seguridad y Salud Ocupacional (OSHA), National Fire Protection Association (NFPA), Environmental Protection Agency (EPA) en estados Unidos y otras normativas internacionales, coloca a la empresa en una posición vulnerable a costosas sanciones, multas o clausuras de líneas de producción.
                            </p>
                        </div>

                        <!-- Item 4 -->
                        <div class="space-y-2 flex-1 flex flex-col justify-start pt-1 lg:min-h-[200px]">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase">Riesgo de incendios</h3>
                            </div>
                            <p class="text-sm text-gray-600 leading-relaxed font-light">
                                Sin un sistema de ventilación efectivo, la planta en general queda expuesta a siniestros, incendios o explosiones que ponen en peligro no solo el área de acabado, sino toda la infraestructura y continuidad del negocio.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 04. PRIMER CTA PERSONALIZADO -->
        <section class="py-16 bg-brand-navy relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-brand-navy via-brand-navy to-brand-blue/50 opacity-90"></div>
            <div class="container mx-auto px-6 relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
                <div class="text-left">
                    <h2 class="text-white text-2xl md:text-3xl font-saira italic font-semibold uppercase">¿Buscas optimizar tu producción con cabinas de pintura de alta ingeniería?</h2>
                    <p class="text-gray-300 text-sm md:text-base font-light mt-2 max-w-xl">Diseñamos, fabricamos e instalamos sistemas industriales a la medida, adaptados por completo a los alcances específicos y volumen de su producción bajo normativas internacionales.</p>
                </div>
                <a href="/contacto?solucion=cabinas-pintura" class="bg-brand-lime text-brand-navy font-bold uppercase tracking-widest px-8 py-4 rounded hover:brightness-110 transition-all shadow-lg shrink-0 text-center"> Solicitar Ingeniería a la Medida </a>
            </div>
        </section>

        <!-- 05. SOLUCIÓN ANAEROBIA (NUESTRA INGENIERÍA) -->
        <section class="py-16 bg-gradient-to-b from-gray-100 to-white px-6 md:px-12 relative overflow-hidden" id="ingenieria">
            <div class="container mx-auto">
                <div class="max-w-5xl mb-10 section-solucion-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Integrador Especializado</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Nuestra Solución en Ingeniería de Cabinas de Pintura</h2>
                    <p class="text-gray-600 font-light mt-4">Diseñamos, fabricamos e instalamos cabinas de aplicación a la medida, garantizando la contención eficiente de partículas, flujos de aire controlados y cumplimiento estricto de normativas internacionales</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-10 text-left items-stretch">
                    <!-- Bento Card 1 (Large Left) -->
                    <div class="bg-brand-navy rounded-3xl p-10 lg:p-14 flex flex-col justify-between relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 shadow-2xl min-h-[500px] h-full">
                        <!-- Image background -->
                        <div class="absolute inset-0 bg-[url('/images/soluciones/cabinas-pintura/cabina-pintura-3.webp')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"></div>
                        <!-- Overlay azul -->
                        <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                        <!-- Decorative background element -->
                        <div class="absolute -right-20 -top-20 w-64 h-64 bg-brand-lime opacity-20 blur-3xl rounded-full group-hover:scale-150 transition-transform duration-700"></div>

                        <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-20 h-20 bg-brand-lime/20 text-brand-lime rounded-2xl flex items-center justify-center z-20">
                            <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                <polyline points="2 12 12 17 22 12"></polyline>
                                <polyline points="2 17 12 22 22 17"></polyline>
                            </svg>
                        </div>
                        <div class="relative z-10 mt-auto">
                            <div>
                                <h3 class="font-saira font-semibold italic text-white text-3xl md:text-4xl uppercase mb-4 leading-tight">Diseño y Dimensionamiento a la Medida</h3>
                                <p class="text-lg text-gray-200 font-light leading-relaxed">
                                    Configuramos las dimensiones de la cabina según la geometría de tus productos y tu volumen de producción. Desde equipos tipo batch para procesos manuales hasta sistemas completamente automatizados integrados a líneas de transporte continuo.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column for Bento Cards 2 & 3 -->
                    <div class="flex flex-col gap-6 h-full">
                        <!-- Bento Card 2 -->
                        <div class="bg-brand-navy rounded-3xl p-8 lg:p-10 flex flex-col justify-center relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 h-full shadow-xl min-h-[250px]">
                            <!-- Image background -->
                            <div class="absolute inset-0 bg-[url('/images/soluciones/cabinas-pintura/cabina-pintura-4.webp')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"></div>
                            <!-- Overlay azul -->
                            <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                            <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-14 h-14 bg-brand-lime/20 shadow-sm text-brand-lime rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 z-20">
                                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                                </svg>
                            </div>
                            <div class="relative z-10">
                                <h3 class="font-saira font-semibold italic text-white text-2xl uppercase leading-tight pr-16 mb-6">Sistemas de Filtración Avanzada</h3>
                                <p class="text-base text-gray-200 font-light leading-relaxed">
                                    Integramos etapas de filtrado en seco o por cortina de agua de alta eficiencia. Capturamos la sobre pulverización (overspray) de forma óptima para mantener un entorno limpio y cumplir con normativas ambientales de emisiones
                                </p>
                            </div>
                        </div>

                        <!-- Bento Card 3 -->
                        <div class="bg-brand-navy rounded-3xl p-8 lg:p-10 shadow-xl border border-transparent flex flex-col justify-center relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 h-full min-h-[250px]">
                            <!-- Image background -->
                            <div class="absolute inset-0 bg-[url('/images/soluciones/cabinas-pintura/cabina-pintura-5.webp')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"></div>
                            <!-- Overlay azul -->
                            <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                            <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-14 h-14 bg-brand-lime/20 text-brand-lime rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 z-20">
                                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                                </svg>
                            </div>
                            <div class="relative z-10">
                                <h3 class="font-saira font-semibold italic text-white text-2xl uppercase leading-tight pr-16 mb-6">Distribución y gestión del flujo de aire</h3>
                                <p class="text-base text-gray-200 font-light leading-relaxed">
                                    Administrar el flujo de aire es probablemente el elemento más importante de una cabina de pintura y su diseño.
                                    Calculamos rigurosamente los sistemas de ventilación para crear una envoltura de flujo de aire laminar en el área de pulverización a una velocidad de ingeniería exacta.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 06. DIFERENCIADORES ANAEROBIA (BENEFICIOS) -->
        <section class="py-16 bg-white px-6 md:px-12 border-t border-gray-100 relative overflow-hidden" id="diferenciadores">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 diferenciadores-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Beneficios</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Beneficios o ventajas de las cabinas de pintura</h2>
                    <p class="text-gray-600 font-light mt-4">Invertir en una cabina de pintura de alta ingeniería no es solo un requerimiento operativo; es una solución necesaria en todos los procesos de acabado para garantizar la rentabilidad de su planta.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 diferenciadores-grid">
                    <!-- Card 1 -->
                    <div class="bg-white p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] transition-shadow duration-300 hover:shadow-[0_8px_30px_rgb(0,0,0,0.2)] group flex flex-col justify-between">
                        <div class="space-y-4">
                            <div class="flex items-center gap-4">
                                <div class="text-brand-lime flex items-center justify-center shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.745 3.745 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z"
                                        ></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-semibold italic text-brand-navy text-xl uppercase group-hover:text-brand-blue transition-colors leading-tight">Mayor control de calidad</h3>
                            </div>
                            <p class="text-sm text-gray-500 leading-relaxed font-light">
                                Al proporcionar un entorno libre de polvo y contaminantes, las cabinas de pintura garantizan que la pintura se aplique de manera uniforme y sin imperfecciones, mejorando significativamente la apariencia y durabilidad del acabado.
                            </p>
                        </div>
                    </div>

                    <!-- Card 2 -->

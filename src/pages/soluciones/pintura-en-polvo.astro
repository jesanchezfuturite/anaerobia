---
import Layout from '../../layouts/Layout.astro'
import Footer from '../../components/Footer.astro'
import { getEntry } from 'astro:content'

// Obtener datos de la página de inicio para reutilizar logos de normativas
const homepageEntry = await getEntry('homepage', 'index')
const homepageData = homepageEntry?.data || {}
const certificados = homepageData.normativas?.certificados || [
    { name: 'NFPA', logo: '/images/home/certificaciones/nfpa.png' },
    { name: 'EPA', logo: '/images/home/certificaciones/epa.svg' },
    { name: 'ETL', logo: '/images/home/certificaciones/etl.png' },
    { name: 'ICC', logo: '/images/home/certificaciones/icc.png' },
    { name: 'OSHA', logo: '/images/home/certificaciones/osha.png' },
]

// SEO Metadata
const seoTitle = 'Sistemas de Pintura en Polvo | Sistemas de pintura industrial'
const seoDescription = 'Sistemas de pintura en polvo: soluciones eficientes y sostenibles para acabados duraderos y de alta calidad. ¡Solicita cotización!'
---

<Layout title={seoTitle} description={seoDescription}>
    <main class="bg-industrial-gray min-h-screen text-brand-navy">
        <!-- 01. HEADER / HERO -->
        <section class="relative min-h-[60vh] flex items-center pt-36 pb-20 bg-brand-navy overflow-hidden">
            <!-- Background Image with Overlay -->
            <div class="absolute inset-0 z-0">
                <img src="/images/soluciones/pintura-polvo/pintura-polvo-1.webp" alt="Sistema de Pintura en Polvo" class="w-full h-full object-cover opacity-60 scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/85 to-brand-navy/60"></div>
            </div>

            <div class="container mx-auto px-6 relative z-10">
                <div class="max-w-4xl hero-section-text">
                    <!-- Breadcrumbs -->
                    <nav class="flex items-center gap-2 text-xs md:text-sm text-gray-400 font-semibold uppercase tracking-widest mb-6">
                        <a href="/" class="text-gray-300 hover:text-brand-lime transition-colors">Inicio</a>
                        <span>/</span>
                        <span class="text-gray-400">Soluciones</span>
                        <span>/</span>
                        <span class="text-brand-lime">Pintura en Polvo</span>
                    </nav>

                    <span class="inline-block bg-brand-lime/10 text-brand-lime border border-brand-lime/20 rounded px-3 py-1 text-xs font-semibold uppercase tracking-widest mb-6"> INTEGRACIÓN DE SISTEMAS DE ACABADOS SUPERFICIALES </span>
                    <h1 class="text-white font-saira italic font-semibold uppercase text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] mb-6">Sistemas de Pintura en Polvo</h1>
                    <p class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed mb-8">
                        Eleve la eficiencia de su planta con sistemas avanzados de pintura en polvo. Diseñamos, fabricamos e instalamos soluciones de alta ingeniería a la medida para la industria de manufactura en México y Estados Unidos. Desde cabinas en cuarto limpio con tecnología de recuperación tipo ciclón, hasta hornos de curado de alta precisión, desarrollamos infraestructura robusta que garantiza acabados impecables y el cumplimiento estricto de normativas internacionales.
                    </p>
                </div>
            </div>
        </section>

        <!-- 02. INTRODUCCIÓN -->
        <section class="py-16 bg-white px-6 md:px-12 relative overflow-hidden" id="introduccion">
            <div class="container mx-auto">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                    <div class="space-y-8 intro-text">
                        <div>
                            <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Ingeniería y Tecnología</span>
                            <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4 mb-6 leading-tight">Mejoramos la industria del mundo con ingeniería especializada y alta tecnología</h2>
                            <p class="text-gray-600 leading-relaxed font-light text-base md:text-lg">
                                Un sistema de pintura en polvo consiste en un conjunto de equipos, procesos y tecnologías integrados para la aplicación de recubrimientos electrostáticos sobre superficies metálicas y otros materiales preparados. Estos sistemas permiten crear un acabado de alta durabilidad y resistencia a la corrosión bajo un proceso sustentable, optimizando el desempeño y la vida útil del recubrimiento final en la industria.
                            </p>
                        </div>
                    </div>

                    <!-- Intro Image -->
                    <div class="relative intro-image group">
                        <div class="relative rounded-lg overflow-hidden shadow-2xl">
                            <img src="/images/soluciones/pintura-polvo/pintura-polvo-3.webp" alt="Sistema de Pintura en Polvo" class="w-full h-auto object-cover transform hover:scale-[1.02] transition-transform duration-700" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 03. PROBLEMA / NECESIDAD (PAIN POINTS) -->
        <section class="py-16 bg-industrial-gray px-6 md:px-12 border-t border-gray-200/50">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 pain-points-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Desafíos</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Puntos de Inflexión Comunes en la Línea de Pintura</h2>
                    <p class="text-gray-600 mt-4 font-light">Las operaciones de manufactura de alto volumen a menudo enfrentan ineficiencias críticas que elevan el costo por pieza y comprometen la consistencia y el acabado final del producto.</p>
                </div>

                <div class="flex flex-col lg:flex-row gap-8 lg:h-[600px] w-full max-w-7xl mx-auto pain-points-grid items-stretch">
                    <!-- Column 1: Image (45%) -->
                    <div class="w-full lg:w-[45%] relative rounded-3xl overflow-hidden shadow-2xl h-[400px] lg:h-auto shrink-0 group">
                        <img src="/images/soluciones/pintura-polvo/pintura-polvo-14.webp" alt="Puntos de Inflexión" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-navy/30 mix-blend-multiply"></div>
                    </div>

                    <!-- Column 2: Cards (20%) -->
                    <div class="w-full lg:w-[20%] flex flex-col justify-between gap-4 shrink-0 h-full">
                        <!-- Card 1 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 lg:h-[32%] min-h-[100px]">
                            <p class="text-lg lg:text-xl font-saira font-bold italic text-brand-blue leading-snug text-center">Tiempos excesivos en cambio de color</p>
                        </div>

                        <!-- Card 2 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 lg:h-[36%] min-h-[120px]">
                            <p class="text-lg lg:text-xl font-saira font-bold italic text-brand-blue leading-snug text-center">Efecto jaula de Faraday y cobertura irregular</p>
                        </div>

                        <!-- Card 3 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 lg:h-[32%] min-h-[100px]">
                            <p class="text-lg lg:text-xl font-saira font-bold italic text-brand-blue leading-snug text-center">Desperdicio por mala recuperación</p>
                        </div>
                    </div>

                    <!-- Column 3: Content (35%) -->
                    <div class="w-full lg:w-[35%] flex flex-col justify-center space-y-10 shrink-0 lg:pl-2">
                        <!-- Item 1 -->
                        <div class="space-y-3">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-xl md:text-2xl uppercase">Tiempos Excesivos en Cambio de Color</h3>
                            </div>
                            <p class="text-base text-gray-600 leading-relaxed font-light">La transición entre diferentes tonos de polvo en sistemas obsoletos puede tomar horas, generando cuellos de botella críticos y contaminación cruzada que arruina lotes enteros de producción.</p>
                        </div>

                        <!-- Item 2 -->
                        <div class="space-y-3">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-xl md:text-2xl uppercase">Efecto Jaula de Faraday y Cobertura Irregular</h3>
                            </div>
                            <p class="text-base text-gray-600 leading-relaxed font-light">La dificultad de penetrar esquinas y geometrías complejas durante la aplicación electrostática genera zonas sin protección, obligando a realizar lentos retoques manuales o comprometiendo la resistencia.</p>
                        </div>

                        <!-- Item 3 -->
                        <div class="space-y-3">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 13v-8a1 1 0 0 0 -1 -1h-2a1 1 0 0 0 -1 1v7a1 1 0 0 0 1 1h3a4 4 0 0 1 4 4v1a2 2 0 0 0 4 0v-5h3a2 2 0 0 0 2 -2l-1 -5a2 3 0 0 0 -2 -2h-7a3 3 0 0 0 -3 3"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-xl md:text-2xl uppercase">Desperdicio por Mala Fluidización y Recuperación</h3>
                            </div>
                            <p class="text-base text-gray-600 leading-relaxed font-light">Si el equipo de recuperación (ciclón) o las tolvas no están optimizados, el polvo se apelmaza o no recircula adecuadamente. Esto provoca pérdidas drásticas de materia prima virgen y acabados imperfectos.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 04. PRIMER CTA PERSONALIZADO -->
        <section class="py-16 bg-brand-navy relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-brand-navy via-brand-navy to-brand-blue/50 opacity-90"></div>
            <div class="container mx-auto px-6 relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
                <div class="text-left">
                    <h2 class="text-white text-2xl md:text-3xl font-saira italic font-semibold uppercase">¿Buscas ingeniería a la medida para tu línea de pintura en polvo?</h2>
                    <p class="text-gray-300 text-sm md:text-base font-light mt-2 max-w-xl">Desde el diseño conceptual hasta la puesta en marcha, creamos el sistema de pintura en polvo exacto para los objetivos de su operación.</p>
                </div>
                <a href="/contacto?solucion=pintura-en-polvo" class="bg-brand-lime text-brand-navy font-bold uppercase tracking-widest px-8 py-4 rounded hover:brightness-110 transition-all shadow-lg shrink-0 text-center"> Solicitar propuesta técnica </a>
            </div>
        </section>

        <!-- 05. SOLUCIÓN ANAEROBIA (NUESTRA INGENIERÍA) -->
        <section class="py-16 bg-gradient-to-b from-gray-100 to-white px-6 md:px-12 relative overflow-hidden" id="ingenieria">
            <div class="container mx-auto">
                <div class="max-w-5xl mb-10 section-solucion-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Integrador Especializado</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Nuestra Solución en Ingeniería de Pintura en Polvo</h2>
                    <p class="text-gray-600 font-light mt-4">Diseñamos y fabricamos soluciones llave en mano adaptadas a los requisitos físicos de tu planta, la geometría de tus piezas y los estándares químicos del recubrimiento.</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-10 text-left items-stretch">
                    <!-- Bento Card 1 (Large Left) -->
                    <div class="bg-brand-navy rounded-3xl p-10 lg:p-14 flex flex-col justify-between relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 shadow-2xl min-h-[500px] h-full">
                        <!-- Image background -->
                        <div class="absolute inset-0 bg-[url('/images/soluciones/pintura-polvo/pintura-polvo-7.webp')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"></div>
                        <!-- Overlay azul -->
                        <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                        <!-- Decorative background element -->
                        <div class="absolute -right-20 -top-20 w-64 h-64 bg-brand-lime opacity-20 blur-3xl rounded-full group-hover:scale-150 transition-transform duration-700"></div>

                        <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-20 h-20 bg-brand-lime/20 text-brand-lime rounded-2xl flex items-center justify-center z-20">
                            <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                <polyline points="2 12 12 17 22 12"></polyline>
                                <polyline points="2 17 12 22 22 17"></polyline>
                            </svg>
                        </div>
                        <div class="relative z-10 mt-auto">
                            <div>
                                <h3 class="font-saira font-semibold italic text-white text-3xl md:text-4xl uppercase mb-4 leading-tight">Sistemas Automatizados Llave en Mano</h3>
                                <p class="text-lg text-gray-200 font-light leading-relaxed">
                                    Diseñamos e integramos líneas de alta ingeniería completamente automatizadas. Proveemos cabinas de última generación, reciprocadores de alta velocidad y transportadores aéreos sincronizados (Overhead Conveyors) configurados de manera integral para optimizar y estandarizar los más altos volúmenes de producción.
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column for Bento Cards 2 & 3 -->
                    <div class="flex flex-col gap-6 h-full">
                        <!-- Bento Card 2 -->
                        <div class="bg-brand-navy rounded-3xl p-8 lg:p-10 flex flex-col justify-center relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 h-full shadow-xl min-h-[250px]">
                            <!-- Image background -->
                            <div class="absolute inset-0 bg-[url('/images/soluciones/pintura-polvo/pintura-polvo-8.webp')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"></div>
                            <!-- Overlay azul -->
                            <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                            <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-14 h-14 bg-brand-lime/20 shadow-sm text-brand-lime rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 z-20">
                                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                                </svg>
                            </div>
                            <div class="relative z-10">
                                <h3 class="font-saira font-semibold italic text-white text-2xl uppercase leading-tight pr-16 mb-6">Clean Rooms y Recuperación Inteligente</h3>
                                <p class="text-base text-gray-200 font-light leading-relaxed">
                                    Nuestras instalaciones integran cuartos limpios presurizados y tecnología avanzada de recuperación por ciclones. Esta ingeniería garantiza hasta un 98% de aprovechamiento del polvo, previniendo la contaminación cruzada entre lotes y asegurando cambios de color ultrarrápidos para minimizar los tiempos muertos.
                                </p>
                            </div>
                        </div>

                        <!-- Bento Card 3 -->
                        <div class="bg-brand-navy rounded-3xl p-8 lg:p-10 shadow-xl border border-transparent flex flex-col justify-center relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 h-full min-h-[250px]">
                            <!-- Image background -->
                            <div class="absolute inset-0 bg-[url('/images/soluciones/pintura-polvo/pintura-polvo-9.webp')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"></div>
                            <!-- Overlay azul -->
                            <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                            <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-14 h-14 bg-brand-lime/20 text-brand-lime rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 z-20">
                                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                                </svg>
                            </div>
                            <div class="relative z-10">
                                <h3 class="font-saira font-semibold italic text-white text-2xl uppercase leading-tight pr-16 mb-6">Sistema de pintura en Polvo y Aplicación de Precisión</h3>
                                <p class="text-base text-gray-200 font-light leading-relaxed">
                                    Equipamos las líneas con tecnología electrostática de recuperación manual hasta en digital, disponibles en configuraciones que van desde manuales hasta sistemas totalmente automatizados. Logramos penetrar geometrías críticas para eliminar el efecto Jaula de Faraday, asegurando un espesor de capa exacto y una adherencia inmejorable lote tras lote.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 06. DIFERENCIADORES ANAEROBIA -->
        <section class="py-16 bg-white px-6 md:px-12 border-t border-gray-100 relative overflow-hidden" id="diferenciadores">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 diferenciadores-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Ventajas Competitivas</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Diferenciadores de Anaerobia en Pintura en Polvo</h2>
                    <p class="text-gray-600 font-light mt-4">Nuestras líneas destacan con un enfoque integral incorporando un muy alto nivel de ingeniería capaz de resolver los desafíos más exigentes en acabados industriales.</p>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 lg:grid-cols-3 gap-8 diferenciadores-grid">
                    <!-- Card 1 -->
                    <div class="bg-white p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] transition-shadow duration-300 hover:shadow-[0_8px_30px_rgb(0,0,0,0.2)] group flex flex-col justify-between">
                        <div class="space-y-4">
                            <div class="flex items-center gap-4">
                                <div class="text-brand-lime flex items-center justify-center shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-semibold italic text-brand-navy text-xl uppercase group-hover:text-brand-blue transition-colors leading-tight">Integración Personalizada</h3>
                            </div>
                            <p class="text-sm text-gray-500 leading-relaxed font-light">Desde soluciones estándar hasta líneas completas de pintura en polvo. Diseñadas a la medida de tu layout optimizando el flujo de piezas para maximizar la productividad.</p>
                        </div>
                    </div>

                    <!-- Card 2 -->
                    <div class="bg-white p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] transition-shadow duration-300 hover:shadow-[0_8px_30px_rgb(0,0,0,0.2)] group flex flex-col justify-between">
                        <div class="space-y-4">
                            <div class="flex items-center gap-4">
                                <div class="text-brand-lime flex items-center justify-center shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            stroke-width="1.5"
                                            d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
                                        ></path>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-semibold italic text-brand-navy text-xl uppercase group-hover:text-brand-blue transition-colors leading-tight">Tiempos de inactividad mínimos</h3>
                            </div>
                            <p class="text-sm text-gray-500 leading-relaxed font-light">Garantizamos respuesta técnica en sitio y un amplio stock de refacciones críticas. Tu línea de pintura siempre disponible gracias a nuestro equipo experto y mantenimientos programados.</p>
                        </div>
                    </div>

                    <!-- Card 3 -->
                    <div class="bg-white p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] transition-shadow duration-300 hover:shadow-[0_8px_30px_rgb(0,0,0,0.2)] group flex flex-col justify-between">
                        <div class="space-y-4">
                            <div class="flex items-center gap-4">
                                <div class="text-brand-lime flex items-center justify-center shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">

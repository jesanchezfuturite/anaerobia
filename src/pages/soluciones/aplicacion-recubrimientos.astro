---
import Layout from '../../layouts/Layout.astro'
import Footer from '../../components/Footer.astro'
import { getEntry } from 'astro:content'

// Obtener datos de la página de inicio para reutilizar logos de normativas
const homepageEntry = await getEntry('homepage', 'index')
const homepageData = homepageEntry?.data || {}
const certificados = homepageData.normativas?.certificados || [
    { name: 'NFPA', logo: '/images/home/certificaciones/nfpa.png' },
    { name: 'EPA', logo: '/images/home/certificaciones/epa.svg' },
    { name: 'ETL', logo: '/images/home/certificaciones/etl.png' },
    { name: 'ICC', logo: '/images/home/certificaciones/icc.png' },
    { name: 'OSHA', logo: '/images/home/certificaciones/osha.png' },
]

// SEO Metadata
const seoTitle = 'Sistemas de Aplicación de Recubrimientos | Anaerobia'
const seoDescription = 'Nos especializamos en ofrecer soluciones en aplicación de recubrimientos, equipos para suministro y aplicación de fluidos para la industria.'
---

<Layout title={seoTitle} description={seoDescription}>
    <main class="bg-industrial-gray min-h-screen text-brand-navy">
        <!-- 01. HEADER / HERO -->
        <section class="relative min-h-[60vh] flex items-center pt-36 pb-20 bg-brand-navy overflow-hidden">
            <!-- Background Image with Overlay -->
            <div class="absolute inset-0 z-0">
                <img src="/images/soluciones/aplicacion-recubrimientos/recubrimientos-1.webp" alt="Sistemas de Aplicación de Recubrimientos" class="w-full h-full object-cover opacity-60 scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/85 to-brand-navy/60"></div>
            </div>

            <div class="container mx-auto px-6 relative z-10">
                <div class="max-w-4xl hero-section-text">
                    <!-- Breadcrumbs -->
                    <nav class="flex items-center gap-2 text-xs md:text-sm text-gray-400 font-semibold uppercase tracking-widest mb-6">
                        <a href="/" class="text-gray-300 hover:text-brand-lime transition-colors">Inicio</a>
                        <span>/</span>
                        <span class="text-gray-400">Soluciones</span>
                        <span>/</span>
                        <span class="text-brand-lime">Aplicación de Recubrimientos</span>
                    </nav>

                    <span class="inline-block bg-brand-lime/10 text-brand-lime border border-brand-lime/20 rounded px-3 py-1 text-xs font-semibold uppercase tracking-widest mb-6"> INTEGRACIÓN DE SISTEMAS DE ACABADOS SUPERFICIALES </span>
                    <h1 class="text-white font-saira italic font-semibold uppercase text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] mb-6">Sistemas de Aplicación de Recubrimientos</h1>
                    <p class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed">Nos especializamos en ofrecer soluciones en aplicación de recubrimientos, equipos para suministro y aplicación de fluidos para diferentes sectores de la industria de acabados.</p>
                </div>
            </div>
        </section>

        <!-- 02. INTRODUCCIÓN -->
        <section class="py-16 bg-white px-6 md:px-12 relative overflow-hidden" id="introduccion">
            <div class="container mx-auto">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
                    <div class="space-y-8 intro-text">
                        <div>
                            <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Tecnología de Fluidos</span>
                            <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4 mb-6 leading-tight">¿Qué es un sistema de aplicación de recubrimientos?</h2>
                            <p class="text-gray-600 leading-relaxed font-light text-base md:text-lg">
                                Un sistema de aplicación de recubrimientos consiste en un conjunto de tecnologías, herramientas y procesos que se utilizan para aplicar diferentes tipos de recubrimientos, como pinturas, barnices, esmaltes, adhesivos, entre otros, sobre una amplia gama de superficies
                                y materiales. Nuestras soluciones también permiten trasvasar fluidos, lubricar, aplicar adhesivos, sellar o pintar.
                            </p>
                            <p class="text-gray-600 leading-relaxed font-light text-base md:text-lg mt-4">
                                El diseño de un sistema para aplicación de recubrimientos depende de las características particulares de cada producto. Tomar en cuenta estas condiciones es importante para una correcta aplicación, ya que nos dará distintos beneficios, que van desde mejorar el
                                rendimiento, reducir el desperdicio de material, evitar la repetición de trabajos y proporcionar una aplicación uniforme.
                            </p>
                            <p class="text-gray-600 leading-relaxed font-light text-base md:text-lg mt-4">ANAEROBIA integra equipos para aplicación de recubrimientos de las principales marcas del mercado, tanto para sistemas manuales como sistemas automáticos.</p>
                            <p class="text-brand-navy font-saira font-bold uppercase italic mt-6 border-l-4 border-brand-lime pl-4">Mejoramos la industria del mundo con ingeniería especializada y alta tecnología.</p>
                        </div>
                    </div>

                    <!-- Intro Image -->
                    <div class="relative intro-image group">
                        <div class="relative rounded-lg overflow-hidden shadow-2xl">
                            <img src="/images/soluciones/aplicacion-recubrimientos/recubrimientos-2.webp" alt="Instalación de Sistemas de Recubrimiento" class="w-full h-auto object-cover transform hover:scale-[1.02] transition-transform duration-700" />
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 03. IMPORTANCIA / BENEFICIOS CLAVE -->
        <section class="py-16 bg-industrial-gray px-6 md:px-12 border-t border-gray-200/50">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 pain-points-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Importancia</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">¿Por qué es importante un sistema de aplicación de recubrimientos?</h2>
                    <p class="text-gray-600 mt-4 font-light">El diseño de un sistema para aplicación de recubrimientos depende de las características particulares de cada producto. Tomar en cuenta estas condiciones es importante para una correcta aplicación, ya que nos dará distintos beneficios:</p>
                </div>

                <div class="flex flex-col lg:flex-row gap-8 lg:h-[700px] w-full max-w-7xl mx-auto pain-points-grid items-stretch">
                    <!-- Column 1: Image (45%) -->
                    <div class="w-full lg:w-[45%] relative rounded-3xl overflow-hidden shadow-2xl h-[400px] lg:h-auto shrink-0 group">
                        <img src="/images/soluciones/aplicacion-recubrimientos/recubrimientos-3.webp" alt="Ventajas del Sistema de Recubrimiento" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                        <div class="absolute inset-0 bg-brand-navy/30 mix-blend-multiply"></div>
                    </div>

                    <!-- Column 2: Cards (20%) -->
                    <div class="w-full lg:w-[20%] flex flex-col justify-between gap-4 shrink-0 h-full">
                        <!-- Card 1 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 flex-1 min-h-[100px]">
                            <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Calidad y precisión en el acabado</p>
                        </div>

                        <!-- Card 2 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 flex-1 min-h-[100px]">
                            <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Seguridad para los operadores</p>
                        </div>

                        <!-- Card 3 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 flex-1 min-h-[100px]">
                            <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Cumplimiento de normativas</p>
                        </div>

                        <!-- Card 4 -->
                        <div class="relative bg-white rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] flex flex-col justify-center p-4 lg:p-5 flex-1 min-h-[100px]">
                            <p class="text-base lg:text-lg font-saira font-bold italic text-brand-blue leading-snug text-center">Eficiencia en el proceso</p>
                        </div>
                    </div>

                    <!-- Column 3: Content (35%) -->
                    <div class="w-full lg:w-[35%] flex flex-col justify-between space-y-4 shrink-0 lg:pl-2 h-full py-2">
                        <!-- Item 1 -->
                        <div class="space-y-2 flex-1 flex flex-col justify-center">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase">Calidad y precisión en el acabado</h3>
                            </div>
                            <p class="text-sm text-gray-600 leading-relaxed font-light">
                                Las cabinas y sistemas de aplicación protegen las superficies de agentes externos, como polvo y partículas, lo que permite obtener acabados uniformes y duraderos. La pintura aplicada en condiciones controladas tiene mejor adherencia, lo que incrementa la resistencia
                                contra factores ambientales y mecánicos.
                            </p>
                        </div>

                        <!-- Item 2 -->
                        <div class="space-y-2 flex-1 flex flex-col justify-center">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase">Seguridad para los operadores</h3>
                            </div>
                            <p class="text-sm text-gray-600 leading-relaxed font-light">
                                Durante el proceso de pintura, los trabajadores pueden exponerse a vapores y productos químicos tóxicos, especialmente si se trabaja con solventes. La cabina de pintura permite contener y extraer estos vapores de forma controlada, minimizando el riesgo de intoxicación
                                o daños a la salud.
                            </p>
                        </div>

                        <!-- Item 3 -->
                        <div class="space-y-2 flex-1 flex flex-col justify-center">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase">Cumplimiento de normativas ambientales</h3>
                            </div>
                            <p class="text-sm text-gray-600 leading-relaxed font-light">
                                Nuestras soluciones permiten cumplir de forma ágil con las regulaciones industriales de seguridad, como las de la Administración de Seguridad y Salud Ocupacional (OSHA), National Fire Protection Association (NFPA) y Environmental Protection Agency (EPA), garantizando
                                condiciones limpias.
                            </p>
                        </div>

                        <!-- Item 4 -->
                        <div class="space-y-2 flex-1 flex flex-col justify-center">
                            <div class="flex items-center gap-3">
                                <div class="text-brand-lime shrink-0">
                                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                    </svg>
                                </div>
                                <h3 class="font-saira font-bold italic text-brand-navy text-lg md:text-xl uppercase">Eficiencia en el proceso</h3>
                            </div>
                            <p class="text-sm text-gray-600 leading-relaxed font-light">
                                Al tener un espacio controlado y optimizado para la aplicación, se mejora notablemente la eficiencia operativa, permitiendo obtener resultados consistentes lote tras lote y minimizando la repetición de procesos por imperfecciones en el acabado.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 04. PRIMER CTA PERSONALIZADO -->
        <section class="py-16 bg-brand-navy relative overflow-hidden">
            <div class="absolute inset-0 bg-gradient-to-r from-brand-navy via-brand-navy to-brand-blue/50 opacity-90"></div>
            <div class="container mx-auto px-6 relative z-10 flex flex-col md:flex-row items-center justify-between gap-8">
                <div class="text-left">
                    <h2 class="text-white text-2xl md:text-3xl font-saira italic font-semibold uppercase">¿Requieres optimizar tus procesos con sistemas de aplicación a la medida?</h2>
                    <p class="text-gray-300 text-sm md:text-base font-light mt-2 max-w-xl">Diseñamos un sistema adaptado a la viscosidad y alcances específicos de tu producción.</p>
                </div>
                <a href="/contacto?solucion=aplicacion-recubrimientos" class="bg-brand-lime text-brand-navy font-bold uppercase tracking-widest px-8 py-4 rounded hover:brightness-110 transition-all shadow-lg shrink-0 text-center"> Solicitar Cotización </a>
            </div>
        </section>

        <!-- 05. SOLUCIÓN ANAEROBIA (NUESTRA INGENIERÍA - BENTO GRID) -->
        <section class="py-16 bg-gradient-to-b from-gray-100 to-white px-6 md:px-12 relative overflow-hidden" id="ingenieria">
            <div class="container mx-auto">
                <div class="max-w-5xl mb-10 section-solucion-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Integrador Especializado</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Nuestra Solución en Ingeniería de Suministro y Aplicación</h2>
                    <p class="text-gray-600 font-light mt-4">Diseñamos y fabricamos sistemas modulares de aplicación, combinando tecnologías de bombeo de precisión, control electrostático y automatización llave en mano.</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mt-10 text-left items-stretch">
                    <!-- Bento Card 1 (Large Left) -->
                    <div class="bg-brand-navy rounded-3xl p-10 lg:p-14 flex flex-col justify-between relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 shadow-2xl min-h-[500px] h-full">
                        <!-- Image background -->
                        <div class="absolute inset-0 bg-[url('/images/soluciones/aplicacion-recubrimientos/recubrimientos-hero.png')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"></div>
                        <!-- Overlay azul -->
                        <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                        <!-- Decorative background element -->
                        <div class="absolute -right-20 -top-20 w-64 h-64 bg-brand-lime opacity-20 blur-3xl rounded-full group-hover:scale-150 transition-transform duration-700"></div>

                        <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-20 h-20 bg-brand-lime/20 text-brand-lime rounded-2xl flex items-center justify-center z-20">
                            <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                                <polyline points="2 12 12 17 22 12"></polyline>
                                <polyline points="2 17 12 22 22 17"></polyline>
                            </svg>
                        </div>
                        <div class="relative z-10 mt-auto">
                            <div>
                                <h3 class="font-saira font-semibold italic text-white text-3xl md:text-4xl uppercase mb-4 leading-tight">Sistemas de Aspersión Manual y Automática</h3>
                                <p class="text-lg text-gray-200 font-light leading-relaxed">Proveemos equipos con tecnologías Airless, Air Assisted Airless y sistemas de aspersión con aire HVLP y convencionales. Adecuados para la integración en líneas continuas o cabinas batch.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column for Bento Cards 2 & 3 -->
                    <div class="flex flex-col gap-6 h-full">
                        <!-- Bento Card 2 -->
                        <div class="bg-brand-navy rounded-3xl p-8 lg:p-10 flex flex-col justify-center relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 h-full shadow-xl min-h-[250px]">
                            <!-- Image background -->
                            <div class="absolute inset-0 bg-[url('/images/soluciones/aplicacion-recubrimientos/recubrimientos-manual.png')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"></div>
                            <!-- Overlay azul -->
                            <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                            <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-14 h-14 bg-brand-lime/20 shadow-sm text-brand-lime rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 z-20">
                                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon>
                                </svg>
                            </div>
                            <div class="relative z-10">
                                <h3 class="font-saira font-semibold italic text-white text-2xl uppercase leading-tight pr-16 mb-6">Dosificación y Dispensado de Fluidos</h3>
                                <p class="text-base text-gray-200 font-light leading-relaxed">Equipos para trasvasar fluidos, lubricar, dosificar adhesivos, ceras o selladores con tolerancias exactas y alta repetibilidad para todo tipo de componentes.</p>
                            </div>
                        </div>

                        <!-- Bento Card 3 -->
                        <div class="bg-brand-navy rounded-3xl p-8 lg:p-10 shadow-xl border border-transparent flex flex-col justify-center relative overflow-hidden group hover:-translate-y-1 transition-transform duration-300 h-full min-h-[250px]">
                            <!-- Image background -->
                            <div class="absolute inset-0 bg-[url('/images/soluciones/aplicacion-recubrimientos/recubrimientos-intro.png')] bg-cover bg-center bg-no-repeat transition-transform duration-700 group-hover:scale-105"></div>
                            <!-- Overlay azul -->
                            <div class="absolute inset-0 bg-[#003141]/85 group-hover:bg-[#003141]/75 transition-colors duration-500"></div>

                            <div class="absolute top-6 right-6 lg:top-8 lg:right-8 w-14 h-14 bg-brand-lime/20 text-brand-lime rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform duration-300 z-20">
                                <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                                </svg>
                            </div>
                            <div class="relative z-10">
                                <h3 class="font-saira font-semibold italic text-white text-2xl uppercase leading-tight pr-16 mb-6">Integración Multimarca de Alta Gama</h3>
                                <p class="text-base text-gray-200 font-light leading-relaxed">Integramos componentes originales de marcas líderes en el mercado (Graco, Nordson, Binks, etc.), garantizando la compatibilidad con tus procesos y fácil acceso a refacciones.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- 06. DIFERENCIADORES / TIPOS DE APLICACIÓN -->
        <section class="py-16 bg-white px-6 md:px-12 border-t border-gray-100 relative overflow-hidden" id="diferenciadores">
            <div class="container mx-auto">
                <div class="text-center max-w-3xl mx-auto mb-16 diferenciadores-header">
                    <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">Procesos</span>
                    <h2 class="text-3xl md:text-4xl font-saira italic font-semibold text-brand-navy uppercase mt-4">Tipos de aplicaciones y fluidos</h2>
                    <p class="text-gray-600 font-light mt-4">Nos especializamos en ofrecer soluciones para aplicación de recubrimientos, equipos para suministro de pintura y aplicación de fluidos para diferentes sectores de la industria:</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-6 diferenciadores-grid">
                    {
                        [
                            { title: 'Airless', desc: 'Sistemas sin aire a alta presión, ideales para viscosidades elevadas y altos micrajes.', icon: '/images/soluciones/aplicacion-recubrimientos/icon-Airless.svg' },
                            { title: 'Air Assisted Airless', desc: 'Combinación de bombeo a alta presión y asistencia neumática para acabados finos.', icon: '/images/soluciones/aplicacion-recubrimientos/icon-Air-Assisted.svg' },
                            { title: 'HVLP / LVLP / Convencional', desc: 'Tecnologías de atomización por aire para un control de espesor preciso y uniforme.', icon: '/images/soluciones/aplicacion-recubrimientos/icon-HVLP.svg' },
                            { title: 'Electroestático Líquido', desc: 'Pulverización con carga electrostática para máxima transferencia y nulo overspray.', icon: '/images/soluciones/aplicacion-recubrimientos/icon-Electrostatic.svg' },
                            { title: 'Aspersión de Poliuretano', desc: 'Mezcla y aspersión exacta de poliuretanos y espumas bicomponentes.', icon: '/images/soluciones/aplicacion-recubrimientos/icon-Poliuretano.svg' },
                            { title: 'Adhesivos', desc: 'Dosificación exacta de adhesivos líquidos y hot melt en líneas de ensamble.', icon: '/images/soluciones/aplicacion-recubrimientos/icon-Adhesivos.webp' },
                            { title: 'Sello', desc: 'Aplicación automatizada o manual de cordones y selladores industriales.', icon: '/images/soluciones/aplicacion-recubrimientos/icon-Sellos.webp' },
                            { title: 'Cera', desc: 'Suministro y rociado de ceras protectoras contra la corrosión de metales.', icon: '/images/soluciones/aplicacion-recubrimientos/icon-Cera.webp' },
                            { title: 'Lubricantes y Gasolina', desc: 'Sistemas de llenado y lubricación precisa en líneas de producción continua.', icon: '/images/soluciones/aplicacion-recubrimientos/icon-Lubricantes.webp' },
                            { title: 'Dosificación y Dispensado', desc: 'Equipos para dosificar fluidos simples o multicomponentes (2K/3K).', icon: '/images/soluciones/aplicacion-recubrimientos/icon-Dosificacion.webp' },
                        ].map((app, index) => (
                            <div class="bg-white p-6 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.06)] border border-gray-100 flex flex-col justify-between hover:shadow-md transition-shadow duration-300">
                                <div>
                                    <div class="flex items-center justify-between mb-4">
                                        <div class="w-10 h-10 rounded-xl bg-brand-navy/5 flex items-center justify-center p-2">

---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";

// Obtener datos de la página de inicio para reutilizar logos de normativas
const homepageEntry = await getEntry("homepage", "index");
const homepageData = homepageEntry?.data || {};
const certificados = homepageData.normativas?.certificados || [
  { name: "NFPA", logo: "/images/home/certificaciones/nfpa.png" },
  { name: "EPA", logo: "/images/home/certificaciones/epa.svg" },
  { name: "ETL", logo: "/images/home/certificaciones/etl.png" },
  { name: "ICC", logo: "/images/home/certificaciones/icc.png" },
  { name: "OSHA", logo: "/images/home/certificaciones/osha.png" },
];

const seoTitle = "Nosotros | Anaerobia Surface Finishing";
const seoDescription = "Nuestra especialidad es el diseño, fabricación e instalación de sistemas de pintura y acabado en general. Mejoramos la industria del mundo con ingeniería especializada.";
---

<Layout title={seoTitle} description={seoDescription}>
  <main class="bg-industrial-gray min-h-screen text-brand-navy">
    <!-- 01. HEADER / HERO -->
    <section class="relative min-h-[60vh] flex items-center pt-36 pb-20 bg-brand-navy overflow-hidden">
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0 z-0">
        <img src="/images/nosotros/bg_hero_nosotros.webp" alt="Acerca de Anaerobia" class="w-full h-full object-cover object-top opacity-60 scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/85 to-brand-navy/60"></div>
      </div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl hero-section-text">
          <!-- Breadcrumbs -->
          <nav class="flex items-center gap-2 text-xs md:text-sm text-gray-400 font-semibold uppercase tracking-widest mb-6">
            <a href="/" class="hover:text-brand-lime transition-colors">Inicio</a>
            <span>/</span>
            <span class="text-brand-lime">Nosotros</span>
          </nav>

          <span class="inline-block bg-brand-lime/10 text-brand-lime border border-brand-lime/20 rounded px-3 py-1 text-xs font-semibold uppercase tracking-widest mb-6">
            Conoce a Anaerobia
          </span>
          <h1 class="text-white font-saira italic font-semibold uppercase text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] mb-6">
            Nosotros
          </h1>
          <p class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed">
            Nuestra especialidad es el diseño, fabricación e instalación de sistemas de pintura y acabado en general. Tenemos una división especializada en manejo de fluidos, equipos para suministro y aplicación en la industria.
          </p>
          <p class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed mt-4">
            Contamos con un área de servicio posventa para atenderte y con nuestro centro de distribución que permite entregar todo tipo de componentes utilizados en nuestros sistemas de manera directa o a través de nuestros distribuidores.
          </p>
        </div>
      </div>
    </section>

    <!-- 02. INTRODUCCIÓN Y PILARES -->
    <section class="py-16 bg-white px-6 md:px-12 relative overflow-hidden" id="introduccion">
      <div class="container mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <!-- Images Left -->
          <div class="relative intro-image group order-2 lg:order-1 h-[350px] sm:h-[450px] lg:h-[550px] w-full">
            <!-- Decorative dots -->
            <div class="absolute -top-6 -right-6 w-32 h-32 bg-[radial-gradient(#cbd5e1_2px,transparent_2px)] [background-size:12px_12px] opacity-70 z-0 hidden sm:block"></div>
            
            <!-- Back Image (Top Left) -->
            <img src="/images/nosotros/img_1_nosotros.webp" alt="Equipo Anaerobia" class="absolute top-0 left-0 w-[75%] h-[75%] object-cover rounded-lg shadow-md z-10" />
            
            <!-- Front Image (Bottom Right) -->
            <div class="absolute -bottom-4 -right-4 w-[85%] h-auto bg-white rounded-xl shadow-2xl z-20 p-4 flex items-center justify-center">
              <img src="/images/nosotros/image_valores_anaerobia.png" alt="Valores Anaerobia" class="w-full h-auto object-contain" />
            </div>
          </div>

          <!-- Text Right -->
          <div class="space-y-8 intro-text order-1 lg:order-2">
            <div>
              <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">
                Nuestro Propósito
              </span>
              <h2 class="text-3xl md:text-4xl lg:text-[2.5rem] font-saira italic font-bold text-brand-navy uppercase mt-4 mb-10 leading-tight">
                Mejoramos la industria del mundo con ingeniería especializada y alta tecnología
              </h2>
              
              <div class="space-y-10">
                <!-- Misión -->
                <div class="flex items-start gap-5">
                  <div class="flex-shrink-0 mt-1">
                    <svg class="w-10 h-10 text-brand-lime" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                      <!-- Flag icon -->
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"></path>
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-saira font-bold text-brand-navy text-2xl mb-2">
                      Misión
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-base">
                      Ejecutar proyectos con un alto contenido de ingeniería y tecnología para la industria, integrando un equipo de colaboradores dinámico y experimentado, contribuyendo con el crecimiento de la empresa y la satisfacción de nuestros clientes.
                    </p>
                  </div>
                </div>

                <!-- Nuestros Valores -->
                <div class="flex items-start gap-5">
                  <div class="flex-shrink-0 mt-1">
                    <svg class="w-10 h-10 text-brand-lime" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                      <!-- Star icon for values -->
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                    </svg>
                  </div>
                  <div class="w-full">
                    <h3 class="font-saira font-bold text-brand-navy text-2xl mb-4">
                      NUESTROS VALORES
                    </h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-gray-600 leading-relaxed font-light text-base">
                      <!-- Column 1 -->
                      <ul class="space-y-3">
                        <li class="flex items-start gap-2">
                          <svg class="w-5 h-5 text-brand-lime flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                          <span><strong class="font-medium text-brand-navy">La familia</strong> es base</span>
                        </li>
                        <li class="flex items-start gap-2">
                          <svg class="w-5 h-5 text-brand-lime flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                          <span>Crecimiento de <strong class="font-medium text-brand-navy">talento humano</strong></span>
                        </li>
                        <li class="flex items-start gap-2">
                          <svg class="w-5 h-5 text-brand-lime flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                          <span><strong class="font-medium text-brand-navy">Respeto al individuo</strong><br class="hidden sm:block"/> y a la organización</span>
                        </li>
                      </ul>
                      <!-- Column 2 -->
                      <ul class="space-y-3">
                        <li class="flex items-start gap-2">
                          <svg class="w-5 h-5 text-brand-lime flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                          <span><strong class="font-medium text-brand-navy">La integridad</strong> nos importa</span>
                        </li>
                        <li class="flex items-start gap-2">
                          <svg class="w-5 h-5 text-brand-lime flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                          <span><strong class="font-medium text-brand-navy">La lealtad</strong> se demuestra</span>
                        </li>
                        <li class="flex items-start gap-2">
                          <svg class="w-5 h-5 text-brand-lime flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path></svg>
                          <span><strong class="font-medium text-brand-navy">Trabajando en equipo</strong><br class="hidden sm:block"/> llegamos lejos</span>
                        </li>
                      </ul>
                    </div>
                  </div>
                </div>
              </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 04. CTA CONTACTO -->
    <section class="relative min-h-[350px] flex items-center py-20 overflow-hidden">
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0 z-0">
        <img src="/img/parallax_bg.webp" alt="Ingeniero en planta industrial" class="w-full h-full object-cover scale-[1.02]" />
        <div class="absolute inset-0 bg-brand-navy/85 mix-blend-multiply"></div>
        <div class="absolute inset-0 bg-[#001c29]/75"></div>
      </div>

      <div class="container mx-auto px-6 relative z-10 text-center max-w-5xl">
        <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-[2.5rem] font-saira italic font-bold text-white uppercase mb-5 tracking-wider">
          ENVÍANOS LAS ESPECIFICACIONES DE TUS PIEZAS Y PRODUCCIÓN
        </h2>
        <p class="text-base md:text-lg text-gray-300 mb-10 max-w-3xl mx-auto font-light leading-relaxed">
          Nuestros ingenieros estructurarán la propuesta técnica con los diagramas y<br class="hidden md:block" /> capacidades de flujo de aire que optimicen la aplicación de pintura en tu planta.
        </p>
        <div class="flex justify-center">
          <a href="/contacto" class="inline-flex items-center justify-center px-10 py-4 font-bold text-brand-navy text-sm md:text-base uppercase tracking-widest bg-brand-lime hover:bg-[#8da31c] transition-colors rounded-sm shadow-xl">
            SOLICITAR PROPUESTA TÉCNICA
          </a>
        </div>
      </div>
    </section>

    <!-- 05. NORMAS -->
    <section class="py-16 bg-brand-navy text-white px-6 md:px-12" id="normas">
      <div class="container mx-auto max-w-6xl">
        <div
          class="flex flex-col lg:flex-row items-center justify-between gap-12"
        >
          <div class="lg:w-1/2 space-y-6 norms-text">
            <div>
              <span
                class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full"
                >Cumplimiento Legal y de Seguridad</span
              >
              <h2
                class="text-3xl md:text-4xl font-saira italic font-semibold text-white uppercase mt-4 leading-tight"
              >
                Cumplimiento Riguroso de Estándares de Seguridad e Impacto
                Ambiental
              </h2>
              <p class="text-gray-300 font-light leading-relaxed mt-4">
                Nuestros productos cumplen o exceden todos los códigos y normativas relacionados con el equipo, además nuestra empresa trabaja bajo los lineamientos de seguridad industrial y protección ambiental que nuestros clientes exigen.
              </p>
            </div>

            <p
              class="text-gray-400 font-light text-xs border-t border-white/10 pt-4"
            >
              Contamos con un equipo de ingenieros calificados y Project
              Managers certificados por **IPMA (International Project Management
              Association)** para liderar la instalación y puesta en marcha de
              manera segura y puntual.
            </p>
          </div>

          <div class="lg:w-1/2 w-full">
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 norms-grid">
              {
                certificados.map((cert) => (
                  <div class="bg-white rounded-xl p-4 flex flex-col items-center justify-center shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group border border-transparent hover:border-brand-lime">
                    <div class="h-14 w-full flex items-center justify-center mb-2">
                      <img
                        src={cert.logo}
                        alt={`Certificación ${cert.name}`}
                        class="max-h-full max-w-full object-contain transition-all duration-300"
                      />
                    </div>
                    <span class="font-saira font-semibold text-[10px] tracking-wider text-brand-navy opacity-60 group-hover:opacity-100 transition-opacity uppercase">
                      {cert.name}
                    </span>
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 06. ALIANZAS / PARTNERS -->
    <section class="bg-white py-4 border-y border-gray-200 overflow-hidden flex items-center">
      <div class="container mx-auto px-6 flex flex-col md:flex-row items-center gap-6">
        <span class="text-gray-500 font-medium whitespace-nowrap text-sm mt-1 uppercase tracking-wide">
          Tecnología respaldada por aliados globales:
        </span>
        <div class="swiper marquee-swiper w-full">
          <div class="swiper-wrapper items-center">
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/fanuc.png" alt="FANUC" class="h-4 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\\'text-2xl font-bold text-gray-400\\'>FANUC</span>'" /></div>
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/graco.png" alt="GRACO" class="h-4 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\\'text-2xl font-bold text-gray-400\\'>GRACO</span>'" /></div>
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/binks.png" alt="BINKS" class="h-4 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\\'text-2xl font-bold text-gray-400\\'>BINKS</span>'" /></div>
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/gfs.png" alt="GFS" class="h-9 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\\'text-2xl font-bold text-gray-400\\'>GFS</span>'" /></div>
            
            <!-- Duplicate for loop -->
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/fanuc.png" alt="FANUC" class="h-4 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\\'text-2xl font-bold text-gray-400\\'>FANUC</span>'" /></div>
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/graco.png" alt="GRACO" class="h-4 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\\'text-2xl font-bold text-gray-400\\'>GRACO</span>'" /></div>
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/binks.png" alt="BINKS" class="h-4 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\\'text-2xl font-bold text-gray-400\\'>BINKS</span>'" /></div>
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/gfs.png" alt="GFS" class="h-9 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\\'text-2xl font-bold text-gray-400\\'>GFS</span>'" /></div>
          </div>
        </div>
      </div>
    </section>
    <!-- 07. RECURSOS / OTRAS SOLUCIONES (SEO) -->
    <section
      class="py-16 bg-industrial-gray px-6 md:px-12 border-t border-gray-200/50"
    >
      <div class="container mx-auto">
        <h3
          class="font-saira font-semibold italic text-brand-navy text-xl uppercase mb-8 text-center md:text-left"
        >
          Explora otras Especialidades de Ingeniería
        </h3>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          <a
            href="/#soluciones"
            class="bg-white p-6 rounded-lg border border-gray-200 text-center hover:border-brand-lime transition-all group shadow-sm hover:shadow"
          >
            <h4
              class="font-saira font-semibold text-brand-navy uppercase text-sm group-hover:text-brand-lime transition-colors"
            >
              Pintura en Polvo
            </h4>
            <span class="text-xs text-gray-400 mt-2 block"
              >Sistemas electrostáticos eficientes</span
            >
          </a>

          <a
            href="/#soluciones"
            class="bg-white p-6 rounded-lg border border-gray-200 text-center hover:border-brand-lime transition-all group shadow-sm hover:shadow"
          >
            <h4
              class="font-saira font-semibold text-brand-navy uppercase text-sm group-hover:text-brand-lime transition-colors"
            >
              Cabinas de Pintura
            </h4>
            <span class="text-xs text-gray-400 mt-2 block"
              >Flujos de aire y filtros premium</span
            >
          </a>

          <a
            href="/#soluciones"
            class="bg-white p-6 rounded-lg border border-gray-200 text-center hover:border-brand-lime transition-all group shadow-sm hover:shadow"
          >
            <h4
              class="font-saira font-semibold text-brand-navy uppercase text-sm group-hover:text-brand-lime transition-colors"
            >
              Hornos Industriales
            </h4>
            <span class="text-xs text-gray-400 mt-2 block"
              >Curado de alta eficiencia térmica</span
            >
          </a>

          <a
            href="/#soluciones"
            class="bg-white p-6 rounded-lg border border-gray-200 text-center hover:border-brand-lime transition-all group shadow-sm hover:shadow"
          >
            <h4
              class="font-saira font-semibold text-brand-navy uppercase text-sm group-hover:text-brand-lime transition-colors"
            >
              Sistemas Overhead
            </h4>
            <span class="text-xs text-gray-400 mt-2 block"
              >Conveyors y transportadores aéreos</span
            >
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .clip-path-slant {
    clip-path: polygon(20% 0, 100% 0, 100% 100%, 0% 100%);
  }
</style>

<script>
  // Simple GSAP animations for the page elements
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
      
      gsap.from('.hero-section-text > *', {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.1,
        ease: 'power3.out',
        delay: 0.2
      });

      gsap.from('.intro-text > *', {
        scrollTrigger: {
          trigger: '#introduccion',
          start: 'top 80%',
        },
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.1,
        ease: 'power3.out'
      });
      
      gsap.from('.intro-image', {
        scrollTrigger: {
          trigger: '#introduccion',
          start: 'top 80%',
        },
        x: 50,
        opacity: 0,
        duration: 1,
        ease: 'power3.out'
      });
      
      gsap.from('.pain-points-header > *', {
        scrollTrigger: {
          trigger: '.pain-points-header',
          start: 'top 85%',
        },
        y: 20,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1
      });
    }
  });
</script>

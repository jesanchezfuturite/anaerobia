---
import Layout from "../layouts/Layout.astro";
import { getEntry } from "astro:content";

// Obtener datos de la página de inicio para reutilizar logos de normativas
const homepageEntry = await getEntry("homepage", "index");
const homepageData = homepageEntry?.data || {};
const certificados = homepageData.normativas?.certificados || [
  { name: "NFPA", logo: "/images/home/certificaciones/nfpa.png" },
  { name: "EPA", logo: "/images/home/certificaciones/epa.svg" },
  { name: "ETL", logo: "/images/home/certificaciones/etl.png" },
  { name: "ICC", logo: "/images/home/certificaciones/icc.png" },
  { name: "OSHA", logo: "/images/home/certificaciones/osha.png" },
];

const seoTitle = "Nosotros | Anaerobia Surface Finishing";
const seoDescription = "Nuestra especialidad es el diseño, fabricación e instalación de sistemas de pintura y acabado en general. Mejoramos la industria del mundo con ingeniería especializada.";
---

<Layout title={seoTitle} description={seoDescription}>
  <main class="bg-industrial-gray min-h-screen text-brand-navy">
    <!-- 01. HEADER / HERO -->
    <section class="relative min-h-[60vh] flex items-center pt-36 pb-20 bg-brand-navy overflow-hidden">
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0 z-0">
        <img src="/images/nosotros/bg_hero_nosotros.webp" alt="Acerca de Anaerobia" class="w-full h-full object-cover object-top opacity-60 scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/85 to-brand-navy/60"></div>
      </div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl hero-section-text">
          <!-- Breadcrumbs -->
          <nav class="flex items-center gap-2 text-xs md:text-sm text-gray-400 font-semibold uppercase tracking-widest mb-6">
            <a href="/" class="hover:text-brand-lime transition-colors">Inicio</a>
            <span>/</span>
            <span class="text-brand-lime">Nosotros</span>
          </nav>

          <span class="inline-block bg-brand-lime/10 text-brand-lime border border-brand-lime/20 rounded px-3 py-1 text-xs font-semibold uppercase tracking-widest mb-6">
            Conoce a Anaerobia
          </span>
          <h1 class="text-white font-saira italic font-semibold uppercase text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] mb-6">
            Tu aliado en proyectos de acabado superficial
          </h1>
          <p class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed">
            Nuestra especialidad es el diseño, fabricación e instalación de sistemas de pintura y acabado en general. Tenemos una división especializada en manejo de fluidos, equipos para suministro y aplicación en la industria.
          </p>
          <p class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed mt-4">
            Contamos con un área de servicio posventa para atenderte y con nuestro centro de distribución que permite entregar todo tipo de componentes utilizados en nuestros sistemas de manera directa o a través de nuestros distribuidores.
          </p>
        </div>
      </div>
    </section>

    <!-- 02. INTRODUCCIÓN Y PILARES -->
    <section class="pt-16 pb-4 bg-white px-6 md:px-12 relative overflow-hidden" id="introduccion">
      <div class="container mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-stretch">
          <!-- Images Left -->
          <div class="relative intro-image group order-2 lg:order-1 w-full h-full min-h-[400px]">
            <!-- Back Image (Top Left) -->
            <img src="/images/nosotros/img_1_nosotros.webp" alt="Equipo Anaerobia" class="absolute inset-0 w-full h-full object-cover rounded-lg shadow-md z-10" />
          </div>

          <!-- Text Right -->
          <div class="space-y-8 intro-text order-1 lg:order-2">
            <div>
              <span class="text-brand-lime font-bold tracking-widest text-xs mb-2 uppercase inline-block bg-brand-lime/10 px-4 py-1.5 rounded-full">
                Nuestro Propósito
              </span>
              <h2 class="text-3xl md:text-4xl lg:text-[2.5rem] font-saira italic font-bold text-brand-navy uppercase mt-4 mb-10 leading-tight">
                MEJORAMOS LA INDUSTRIA DEL MUNDO CON INGENIERÍA ESPECIALIZADA Y ALTA TECNOLOGÍA
              </h2>
              
              <div class="space-y-10">
                <!-- Misión -->
                <div class="flex items-start gap-5">
                  <div>
                    <h3 class="font-saira font-bold text-brand-navy text-2xl mb-2 uppercase">
                      NUESTRA MISIÓN
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-base">
                      Ejecutar proyectos con un alto contenido de ingeniería y tecnología para la industria, integrando un equipo de colaboradores dinámico y experimentado, contribuyendo con el crecimiento de la empresa y la satisfacción de nuestros clientes.
                    </p>
                  </div>
                </div>

                </div>

            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- 03. LOS PILARES DE NUESTRO TRABAJO -->
    <section class="pt-12 pb-16 bg-white px-6 md:px-12 relative overflow-hidden" id="pilares">
      <div class="container mx-auto max-w-6xl">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl lg:text-[2.5rem] font-saira italic font-bold text-brand-navy uppercase mb-4 leading-tight">
            LOS PILARES DE NUESTRO TRABAJO
          </h2>
          <p class="text-gray-600 leading-relaxed font-light text-base max-w-2xl mx-auto">
            Nuestros fundamentos que garantizan el éxito en cada proyecto de principio a fin.
          </p>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Pilar 1 -->
          <div class="bg-white p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] hover:shadow-[0_8px_30px_rgb(0,0,0,0.2)] hover:-translate-y-2 transition-all duration-300 text-center flex flex-col items-center border border-gray-100">
            <div class="w-16 h-16 bg-brand-navy/5 text-brand-navy rounded-full flex items-center justify-center mb-4">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
            </div>
            <h3 class="font-saira font-bold text-brand-navy text-xl">Gestión Integral</h3>
          </div>
          <!-- Pilar 2 -->
          <div class="bg-white p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] hover:shadow-[0_8px_30px_rgb(0,0,0,0.2)] hover:-translate-y-2 transition-all duration-300 text-center flex flex-col items-center border border-gray-100">
            <div class="w-16 h-16 bg-brand-navy/5 text-brand-navy rounded-full flex items-center justify-center mb-4">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"></path></svg>
            </div>
            <h3 class="font-saira font-bold text-brand-navy text-xl">Ingeniería a la medida</h3>
          </div>
          <!-- Pilar 3 -->
          <div class="bg-white p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] hover:shadow-[0_8px_30px_rgb(0,0,0,0.2)] hover:-translate-y-2 transition-all duration-300 text-center flex flex-col items-center border border-gray-100">
            <div class="w-16 h-16 bg-brand-navy/5 text-brand-navy rounded-full flex items-center justify-center mb-4">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
            </div>
            <h3 class="font-saira font-bold text-brand-navy text-xl">Cumplimiento normativo</h3>
          </div>
          <!-- Pilar 4 -->
          <div class="bg-white p-8 rounded-2xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] hover:shadow-[0_8px_30px_rgb(0,0,0,0.2)] hover:-translate-y-2 transition-all duration-300 text-center flex flex-col items-center border border-gray-100">
            <div class="w-16 h-16 bg-brand-navy/5 text-brand-navy rounded-full flex items-center justify-center mb-4">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
            </div>
            <h3 class="font-saira font-bold text-brand-navy text-xl">Presencia nacional</h3>
          </div>
        </div>
      </div>
    </section>

    
    <!-- 04. NUESTROS VALORES -->
    <section class="py-16 bg-gray-50 px-6 md:px-12 relative overflow-hidden" id="valores">
      <!-- Decorative background element -->
      <div class="absolute top-0 right-0 w-[40rem] h-[40rem] bg-brand-navy/5 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>
      
      <div class="container mx-auto max-w-6xl relative z-10">
        <div class="text-center mb-8 lg:mb-12">
          <h2 class="text-3xl md:text-4xl lg:text-[2.5rem] font-saira italic font-bold text-brand-navy uppercase mb-4 leading-tight">
            NUESTROS VALORES
          </h2>
        </div>
        
        <div class="grid grid-cols-1 lg:grid-cols-[1fr_auto_1fr] gap-8 lg:gap-12 items-center">
          
          <!-- LEFT COLUMN -->
          <div class="flex flex-col gap-8 lg:gap-20 order-2 lg:order-1">
            <!-- Item 1 (Top Left) -->
            <div class="valor-card group relative z-10 bg-white/80 backdrop-blur border border-gray-100 p-6 rounded-2xl flex flex-row lg:flex-row-reverse items-center gap-4 hover:shadow-2xl hover:-translate-y-1 hover:border-brand-lime/30 transition-all duration-300">
              <div class="w-14 h-14 rounded-full bg-brand-lime/10 text-brand-lime flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:bg-brand-lime group-hover:text-white transition-all duration-300 shadow-inner">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
              </div>
              <div class="text-left lg:text-right">
                <h3 class="font-saira font-bold text-brand-navy text-lg uppercase tracking-wide leading-tight group-hover:text-brand-lime transition-colors">La familia<br/><span class="font-light text-gray-500">es base</span></h3>
              </div>
              <!-- Connector Line -->
              <div class="hidden lg:block absolute top-1/2 left-full z-0 pointer-events-none w-0 h-0">
                <div class="absolute top-0 left-0 w-8 h-[2px] bg-[#94a3b8]"></div>
                <div class="absolute top-0 left-8 w-[40px] h-[2px] bg-[#94a3b8] origin-left rotate-[35deg]">
                   <div class="absolute -top-[5px] -right-[5px] w-3 h-3 rounded-full bg-brand-navy"></div>
                </div>
              </div>
            </div>

            <!-- Item 2 (Middle Left) -->
            <div class="valor-card group relative z-10 bg-white/80 backdrop-blur border border-gray-100 p-6 rounded-2xl flex flex-row lg:flex-row-reverse items-center gap-4 hover:shadow-2xl hover:-translate-y-1 hover:border-brand-lime/30 transition-all duration-300 lg:-translate-x-8">
              <div class="w-14 h-14 rounded-full bg-brand-navy/10 text-brand-navy flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:bg-brand-navy group-hover:text-white transition-all duration-300 shadow-inner">
                <svg class="w-7 h-7" fill="currentColor" stroke="none" viewBox="0 0 59.82 59.86">
                  <path d="M51.84,58.54c-.1.36-.62,1.48-.83,1.3l-1.19-.99v-18.01s.82-.98.82-.98c.24-.29,1.09.68,1.19.99v17.7Z"/>
                  <path d="M45.86,58.48c0,.37-.56,1.2-.8,1.35-.31.2-1.2-.75-1.2-1.2v-9.59c0-.35.56-1.1.8-1.26.31-.21,1.19.74,1.19,1.11v9.59Z"/>
                  <path d="M39.88,58.54c0,.3-.58,1.13-.81,1.29-.31.21-1.19-.74-1.19-1.12v-5.77c0-.28.58-.99.8-1.16.3-.23,1.19.73,1.19,1.15v5.62Z"/>
                  <path d="M27.92,58.55c0,.3-.56,1.13-.81,1.26-.33.18-1.18-.7-1.18-1.08v-3.87c0-.28.55-.94.79-1.09.32-.2,1.19.67,1.19,1.03l.02,3.74Z"/>
                  <path d="M33.01,59.61c-1.62.22-1.71-3.69-.07-3.73,1.29-.03,1.54,3.53.07,3.73Z"/>
                  <path d="M2.48,17.85c10.21-5.5,12.95-5.19,24.35-3.84,1.67,1.13,3.54,2.74,5.29,4.28l5.08-2.67c1.18-.62,3.01-.06,3.75,1s.61,3.37-.73,4.1l-7.89,4.3c-1.45-.34-3.45-1.44-4.7-2.17l-.88-.73c-.19-.16-.28-.92-.07-1.05.31-.2,1.34-.26,1.68-.06l3.61,2.08,6.71-3.67c.32-.18.77-1.02.86-1.34.11-.42-1.23-.89-1.65-.66l-5.86,3.14-5.66-4.63c-3.97-.35-7.93-1.01-11.87-.79-3.66.21-6.84,2.76-10.37,4.02l-2.11,8.08c-.09.34.23,1.28.37,1.55.19.35,1.46-.15,1.58-.6l2.02-7.59c2.99-.96,5.28-1.67,8.42-2.32l-2.14,12.86c-.47,2.81,2.08,4.49,4.65,4.61l9.68.48-3.36,9.54c-.26.75-.04,2.44.48,3.03s2.22,1.16,3.08,1.1l3.38-.24c.92-1.81,2.55-2.28,4.5-1.27l7.07-4.71c.22-1.99.86-3.7,3.28-3.92l9.73-24.32c-.65-1.28-1.14-2.89-.62-3.88.66-1.27,2.36-1.9,3.73-1.45,1.04.34,2.02,1.84,1.96,2.99-.08,1.5-1.32,2.56-3.17,2.88l-9.79,24.51c1.01,1.43,1.22,2.95.48,4.03-.89,1.3-2.51,1.55-4.25.75l-7.25,4.85c-.03,1.7-.7,3.1-1.9,3.5-1.53.51-2.81-.16-3.91-1.73l-6.61-.13-7.05,8.01h-6.41c-3.34,0-5.56-3.03-4.84-6.22l3.97-15.52,1.09-.88c.26-.21.78.87.84,1.15l-4.13,16.07c-.16,1.09.95,3.3,1.99,3.32l6.59.12,6.78-7.75c-.75-1.19-1.4-3.24-.93-4.58l2.67-7.57-6.67-.29-6.06,17.45c-.07.16-1.01,1.04-1.13.78l-.7-1.46,5.92-16.96c-3.02-.6-5.49-3.43-4.99-6.53l1.64-10.15-4.48,1.29-1.6,6.32c-.41,1.62-2.06,2.64-3.54,2.36S-.34,28.71.08,27.09l2.39-9.24Z"/>
                  <rect x="55.82" y="23.95" width="1.99" height="35.78"/>
                  <path d="M27.33,46.84c-.17.33-.99.87-1.24.98-.34.14-.78-1.21-.58-1.6l5.35-10.38c.66-1.28-.19-2.83-1.3-3.02l-9.09-1.6,3.55-12.21.67-.77c.21-.24,1.3.52,1.19.92l-2.98,10.59,6.58,1.08c1.07.18,2.53,1.07,2.99,1.86.58.99.69,2.87.18,3.86l-5.31,10.3Z"/>
                  <path d="M27.87,5.95c0,3.29-2.66,5.95-5.95,5.95s-5.95-2.66-5.95-5.95S18.64,0,21.92,0s5.95,2.66,5.95,5.95ZM25.92,5.95c0-2.2-1.79-3.99-3.99-3.99s-3.99,1.79-3.99,3.99,1.79,3.99,3.99,3.99,3.99-1.79,3.99-3.99Z"/>
                </svg>
              </div>
              <div class="text-left lg:text-right">
                <h3 class="font-saira font-bold text-brand-navy text-lg uppercase tracking-wide leading-tight group-hover:text-brand-lime transition-colors">Crecimiento de<br/><span class="font-light text-gray-500">talento humano</span></h3>
              </div>
              <!-- Connector Line -->
              <div class="hidden lg:block absolute top-1/2 left-full z-0 pointer-events-none w-0 h-0">
                <div class="absolute top-0 left-0 w-[50px] h-[2px] bg-[#94a3b8]">
                   <div class="absolute -top-[5px] -right-[5px] w-3 h-3 rounded-full bg-brand-navy"></div>
                </div>
              </div>
            </div>

            <!-- Item 3 (Bottom Left) -->
            <div class="valor-card group relative z-10 bg-white/80 backdrop-blur border border-gray-100 p-6 rounded-2xl flex flex-row lg:flex-row-reverse items-center gap-4 hover:shadow-2xl hover:-translate-y-1 hover:border-brand-lime/30 transition-all duration-300">
              <div class="w-14 h-14 rounded-full bg-brand-lime/10 text-brand-lime flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:bg-brand-lime group-hover:text-white transition-all duration-300 shadow-inner">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
              </div>
              <div class="text-left lg:text-right">
                <h3 class="font-saira font-bold text-brand-navy text-lg uppercase tracking-wide leading-tight group-hover:text-brand-lime transition-colors">Respeto al individuo<br/><span class="font-light text-gray-500">y a la organización</span></h3>
              </div>
              <!-- Connector Line -->
              <div class="hidden lg:block absolute top-1/2 left-full z-0 pointer-events-none w-0 h-0">
                <div class="absolute top-0 left-0 w-8 h-[2px] bg-[#94a3b8]"></div>
                <div class="absolute top-0 left-8 w-[40px] h-[2px] bg-[#94a3b8] origin-left -rotate-[35deg]">
                   <div class="absolute -top-[5px] -right-[5px] w-3 h-3 rounded-full bg-brand-navy"></div>
                </div>
              </div>
            </div>
          </div>

          <!-- CENTER LOGO -->
          <div class="flex justify-center items-center order-1 lg:order-2 relative z-20 py-8 lg:py-0">
            <div class="w-64 h-64 md:w-80 md:h-80 lg:w-[400px] lg:h-[400px] relative flex items-center justify-center filter drop-shadow-2xl hover:scale-105 transition-transform duration-700">
              <img src="/images/nosotros/icono_principal_logo.png" alt="Valores Anaerobia" class="w-full h-full object-contain" />
            </div>
          </div>

          <!-- RIGHT COLUMN -->
          <div class="flex flex-col gap-8 lg:gap-20 order-3">
            <!-- Item 4 (Top Right) -->
            <div class="valor-card group relative z-10 bg-white/80 backdrop-blur border border-gray-100 p-6 rounded-2xl flex items-center gap-4 hover:shadow-2xl hover:-translate-y-1 hover:border-brand-lime/30 transition-all duration-300">
              <!-- Connector Line -->
              <div class="hidden lg:block absolute top-1/2 right-full z-0 pointer-events-none w-0 h-0">
                <div class="absolute top-0 right-0 w-8 h-[2px] bg-[#94a3b8]"></div>
                <div class="absolute top-0 right-8 w-[40px] h-[2px] bg-[#94a3b8] origin-right -rotate-[35deg]">
                   <div class="absolute -top-[5px] -left-[5px] w-3 h-3 rounded-full bg-brand-navy"></div>
                </div>
              </div>
              
              <div class="w-14 h-14 rounded-full bg-brand-navy/10 text-brand-navy flex items-center justify-center flex-shrink-0 group-hover:scale-110 group-hover:bg-brand-navy group-hover:text-white transition-all duration-300 shadow-inner">
                <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
              </div>
              <div>
                <h3 class="font-saira font-bold text-brand-navy text-lg uppercase tracking-wide leading-tight group-hover:text-brand-lime transition-colors">La integridad<br/><span class="font-light text-gray-500">nos importa</span></h3>
              </div>
            </div>

            <!-- Item 5 (Middle Right) -->
            <div class="valor-card group relative z-10 bg-white/80 backdrop-blur border border-gray-100 p-6 rounded-2xl flex items-center gap-4 hover:shadow-2xl hover:-translate-y-1 hover:border-brand-lime/30 transition-all duration-300 lg:translate-x-8">
              <!-- Connector Line -->
              <div class="hidden lg:block absolute top-1/2 right-full z-0 pointer-events-none w-0 h-0">

<style>
  .clip-path-slant {
    clip-path: polygon(20% 0, 100% 0, 100% 100%, 0% 100%);
  }
</style>

<script>
  // Simple GSAP animations for the page elements
  document.addEventListener('DOMContentLoaded', () => {
    // Marquee Swiper
    if (typeof Swiper !== 'undefined') {
      new Swiper('.marquee-swiper', {
        loop: true,
        speed: 3000,
        autoplay: {
          delay: 0,
          disableOnInteraction: false,
        },
        slidesPerView: 'auto',
        spaceBetween: 10,
        allowTouchMove: false,
        freeMode: true,
      });
    }
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.registerPlugin(ScrollTrigger);
      
      gsap.from('.hero-section-text > *', {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.1,
        ease: 'power3.out',
        delay: 0.2
      });

      gsap.from('.intro-text > *', {
        scrollTrigger: {
          trigger: '#introduccion',
          start: 'top 80%',
        },
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.1,
        ease: 'power3.out'
      });
      
      gsap.from('.intro-image', {
        scrollTrigger: {
          trigger: '#introduccion',
          start: 'top 80%',
        },
        x: 50,
        opacity: 0,
        duration: 1,
        ease: 'power3.out'
      });
      

      gsap.from('.pain-points-header > *', {
        scrollTrigger: {
          trigger: '.pain-points-header',
          start: 'top 85%',
        },
        y: 20,
        opacity: 0,
        duration: 0.6,
        stagger: 0.1
      });
    }
  });
</script>

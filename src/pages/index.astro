---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';

import { getEntry } from 'astro:content';

const homepageEntry = await getEntry('homepage', 'index');
// Datos por defecto en caso de que Keystatic no haya generado el archivo aún
const data = homepageEntry?.data || {
  hero: {
    title: "Ingeniería Inteligente en Sistemas de Pintura y Acabado.",
    subtitle: "Diseñamos e integramos proyectos 'llave en mano' para manufactura de clase mundial.",
    buttons: [
      { label: "Hablar con un Ingeniero", url: "#contacto" },
      { label: "Ver Proyectos", url: "#proyectos" }
    ]
  },
  soluciones: {
    sectionTitle: "Soluciones Industriales Altamente Especializadas en Acabados Superficiales",
    sectionSubtitle: "Integramos tecnologías de punta para maximizar la calidad y el rendimiento en la línea de producción de tu planta.",
    cards: [
      { title: "Pintura en Polvo", description: "Cabinas y sistemas eficientes para recubrimientos impecables de piezas metálicas con alta durabilidad.", image: "https://loremflickr.com/800/600/industry,factory?lock=1" },
      { title: "Pintura Líquida", description: "Acabados estéticos de clase A con sistemas automatizados robotizados para la industria automotriz.", image: "https://loremflickr.com/800/600/industry,robot?lock=2" },
      { title: "Pretratamiento", description: "Equipos de lavado de etapas múltiples asegurando la adherencia ideal antes del recubrimiento.", image: "https://loremflickr.com/600/800/industry,welding?lock=3" },
      { title: "Hornos de Curado y Secado", description: "Hornos de convección e infrarrojos diseñados térmicamente para eficiencia energética superlativa.", image: "https://loremflickr.com/800/600/industry,oven,metal?lock=4" },
      { title: "Transportadores / Conveyors", description: "Desde sistemas overhead hasta floor conveyors. Movimiento exacto y fluido para tus piezas.", image: "https://loremflickr.com/800/600/industry,conveyor?lock=5" },
      { title: "Partes y Filtros", description: "Suministro de componentes críticos, refacciones y consumibles de alto rendimiento para tus equipos.", image: "https://loremflickr.com/800/600/industrial,engine,part?lock=45" }
    ]

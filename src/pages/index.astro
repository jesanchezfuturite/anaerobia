---

<Layout title="Anaerobia | Ingeniería Inteligente en Sistemas de Pintura y Acabado">
  <main>
    <!-- A. Hero Section Cinematográfico -->
    <section class="relative min-h-screen overflow-hidden flex items-center pt-40 pb-12 landscape:pt-48 landscape:pb-20">
      <!-- Background Video Local -->
      <div class="absolute inset-0 w-full h-full z-0 overflow-hidden bg-[var(--color-brand-navy)]">
        <video 
           class="absolute inset-0 w-full h-full object-cover opacity-60 mix-blend-luminosity" 
           autoplay loop muted playsinline>
          <source src={data.hero.backgroundVideo || "/videos/home.mp4"} type="video/mp4" />
        </video>
      </div>
      
      <!-- Overlay -->
      <div class="absolute inset-0 bg-[var(--color-brand-navy)]/80 mix-blend-multiply z-10"></div>
      
      <!-- Contenido -->
      <div class="relative z-20 container mx-auto px-6 md:px-12 w-full">
        <div class="w-full lg:max-w-6xl hero-content">
          <span class="inline-block text-[var(--color-brand-lime)] font-semibold tracking-widest text-sm md:text-base mb-4 uppercase">
            Líderes en integración industrial
          </span>
          <h1 class="text-white font-saira italic font-semibold uppercase text-4xl md:text-5xl lg:text-6xl xl:text-[5.5rem] leading-[1.1] mb-6 w-full">
            <Fragment set:html={data.hero.title.toUpperCase().replace(' INTELIGENTE EN S', ' INTELIGENTE<br/>EN S').replace('PINTURA Y A', 'PINTURA Y A')} />
          </h1>
          <p class="text-gray-300 text-lg md:text-xl font-light max-w-2xl mb-8 whitespace-pre-line">
            {data.hero.subtitle}
          </p>
          <div class="flex flex-wrap gap-4">
            {data.hero.buttons.length > 0 && (
              <a href={data.hero.buttons[0]?.url || "#"} class="bg-[var(--color-brand-lime)] text-[var(--color-brand-navy)] font-semibold px-8 py-4 rounded hover:brightness-110 transition-all duration-300 transform hover:-translate-y-1">
                {data.hero.buttons[0]?.label}
              </a>
            )}
            {data.hero.buttons.length > 1 && (
              <a href={data.hero.buttons[1]?.url || "#"} class="flex items-center gap-2 border border-white text-white font-medium px-8 py-4 rounded hover:bg-white/10 transition-all duration-300 backdrop-blur-sm group">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white group-hover:text-[var(--color-brand-lime)] transition-colors" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M11.596 8.697l-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z"/>
                </svg>
                {data.hero.buttons[1]?.label}
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- C. Bento Grid Dinámico -->
    <section id="soluciones" class="scroll-mt-24 md:scroll-mt-28 bg-[var(--color-industrial-gray)] py-16 bento-grid-container px-6 md:px-12">
      <div class="container mx-auto">
        <div class="mb-16">
          <h2 class="text-3xl md:text-5xl font-saira font-semibold italic text-[var(--color-brand-navy)]">
            {
              data.soluciones.sectionTitle.includes("Altamente Especializadas") ? (
                <>
                  {data.soluciones.sectionTitle.split("Altamente Especializadas")[0]}
                  <span class="text-[var(--color-brand-lime)]">Altamente Especializadas</span>
                  {data.soluciones.sectionTitle.split("Altamente Especializadas")[1]}
                </>
              ) : (
                data.soluciones.sectionTitle
              )
            }
          </h2>
          <p class="mt-4 text-gray-600 max-w-2xl text-lg whitespace-pre-line">{data.soluciones.sectionSubtitle}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[480px]">
          {data.soluciones.cards.map((card, index) => (
            <div class={`bento-card group overflow-hidden relative rounded-xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] cursor-pointer bg-white ${index === 5 ? '-translate-y-4 md:translate-y-0' : ''}`}>
              <img src={card.image || "https://loremflickr.com/800/600/industry?lock=" + index} alt={card.title} class={`object-cover h-full w-full transform transition-transform duration-700 group-hover:scale-110 ${index === 4 || index === 5 ? 'object-center' : ''}`} />
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-brand-navy)]/95 via-[var(--color-brand-navy)]/40 to-transparent"></div>
              <div class="absolute bottom-0 left-0 p-8 pb-16 w-full">
                <h3 class="text-2xl font-semibold italic font-saira translate-y-4 group-hover:translate-y-0 transition-transform duration-300 text-white">{card.title}</h3>
                <div class="grid grid-rows-[0fr] group-hover:grid-rows-[1fr] transition-all duration-300 ease-in-out">

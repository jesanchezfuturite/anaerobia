  mantenimiento: {
    sectionTitle: "Servicio Industrial",
    sectionSubtitle: "Garantizamos el funcionamiento ininterrumpido en tu inversión, mediante inspecciones detalladas, intervenciones programadas y respuesta inmediata a necesidades de servicio industrial.",

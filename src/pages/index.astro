                   <div class="group">
                     <label class="block text-xs font-bold text-gray-500 mb-2 uppercase tracking-widest group-focus-within:text-[var(--color-brand-navy)] transition-colors">Nombre Completo</label>
                     <input type="text" class="w-full px-4 py-3 border-b-2 border-gray-200 bg-gray-50/50 rounded-t-md focus:outline-none focus:border-[var(--color-brand-lime)] focus:bg-white transition-all" placeholder="Ej. Juan Pérez">
                   </div>
                   <div class="group">
                     <label class="block text-xs font-bold text-gray-500 mb-2 uppercase tracking-widest group-focus-within:text-[var(--color-brand-navy)] transition-colors">Empresa</label>
                     <input type="text" class="w-full px-4 py-3 border-b-2 border-gray-200 bg-gray-50/50 rounded-t-md focus:outline-none focus:border-[var(--color-brand-lime)] focus:bg-white transition-all" placeholder="Razón Social">
                   </div>
                 </div>
                 <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                   <div class="group">
                     <label class="block text-xs font-bold text-gray-500 mb-2 uppercase tracking-widest group-focus-within:text-[var(--color-brand-navy)] transition-colors">Correo Corporativo</label>
                     <input type="email" class="w-full px-4 py-3 border-b-2 border-gray-200 bg-gray-50/50 rounded-t-md focus:outline-none focus:border-[var(--color-brand-lime)] focus:bg-white transition-all" placeholder="hola@empresa.com">
                   </div>
                   <div class="group">
                     <label class="block text-xs font-bold text-gray-500 mb-2 uppercase tracking-widest group-focus-within:text-[var(--color-brand-navy)] transition-colors">Teléfono</label>
                     <input type="tel" class="w-full px-4 py-3 border-b-2 border-gray-200 bg-gray-50/50 rounded-t-md focus:outline-none focus:border-[var(--color-brand-lime)] focus:bg-white transition-all" placeholder="+52 81 0000 0000">
                   </div>
                 </div>
                 <div class="group">
                   <label class="block text-xs font-bold text-gray-500 mb-2 uppercase tracking-widest group-focus-within:text-[var(--color-brand-navy)] transition-colors">Requerimiento Técnico</label>
                   <textarea rows="3" class="w-full px-4 py-3 border-b-2 border-gray-200 bg-gray-50/50 rounded-t-md focus:outline-none focus:border-[var(--color-brand-lime)] focus:bg-white transition-all resize-none" placeholder="Describe brevemente tus necesidades de producción, integración o servicios..."></textarea>
                 </div>
                 <div class="pt-2">
                   <button type="submit" class="w-full bg-[var(--color-brand-navy)] text-white font-bold uppercase tracking-widest py-4 rounded hover:bg-[var(--color-brand-lime)] hover:text-[var(--color-brand-navy)] transition-all duration-300 shadow-md group overflow-hidden relative">
                     <span class="relative z-10 flex items-center justify-center gap-2">
                        Solicitar Asesoría
                        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                     </span>
                   </button>
                 </div>
               </form>
            </div>
        </div>
      </div>
    </section>

    <!-- FOOTER NAVEGABLE (SEO) -->
    <Footer />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      // 1. Inicializar Lenis (Smooth Scroll)
      const lenis = new Lenis({ 
        duration: 1.2, 
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
        smoothWheel: true
      });
      function raf(time) { 
        lenis.raf(time); 
        requestAnimationFrame(raf); 
      }
      requestAnimationFrame(raf);

      // 2. Conectar GSAP con Lenis solo si están cargados
      if (typeof gsap !== 'undefined') {
        gsap.ticker.add((time) => { lenis.raf(time * 1000) });
        gsap.ticker.lagSmoothing(0);

        // 3. Animación Hero
        gsap.from(".hero-content > *", { 
          y: 40, 
          opacity: 0, 
          duration: 1, 
          stagger: 0.2, 
          ease: "power3.out", 
          delay: 0.5 
        });

        // 4. ScrollTriggers
        if (typeof ScrollTrigger !== 'undefined') {
          // Bento Grid Reveal
          gsap.from(".bento-card", {
            scrollTrigger: { 
              trigger: ".bento-grid-container", 
              start: "top 80%" 
            },
            y: 50, 
            opacity: 0, 
            duration: 0.8, 
            stagger: 0.15, 
            ease: "power2.out"
          });


          // Main Services Grid
          gsap.from(".main-services-grid > div", {
            scrollTrigger: { trigger: "#mantenimiento", start: "top 80%" },
            y: 40, opacity: 0, duration: 0.7, stagger: 0.2, ease: "back.out(1.7)",
            clearProps: "transform"
          });

          // Parallax Footer
          gsap.fromTo(".parallax-bg", 
            { yPercent: -15 },
            {
              yPercent: 15,
              ease: "none",
              scrollTrigger: {
                trigger: ".parallax-footer",
                start: "top bottom", 
                end: "bottom top",
                scrub: true
              }
            }
          );
        }
      }

      // Marquee Swiper
      if (typeof Swiper !== 'undefined') {
        new Swiper('.marquee-swiper', {
          loop: true,
          speed: 3000,
          autoplay: {
            delay: 0,
            disableOnInteraction: false,
          },
          slidesPerView: 'auto',
          spaceBetween: 10,
          allowTouchMove: false,
          freeMode: true,
        });
      }

      // 5. Infografía Interactiva (Desktop & Mobile Sync)
      const desktopInfographic = document.getElementById("desktop-infographic");
      if (desktopInfographic) {
        const cards = desktopInfographic.querySelectorAll(".info-card");
        const hotspots = desktopInfographic.querySelectorAll(".desktop-hotspot");
        const lines = desktopInfographic.querySelectorAll(".line-active-path");

        const getColorValue = (colorName) => {
          switch (colorName) {
            case 'lime': return 'var(--color-brand-lime)';
            case 'blue': return 'var(--color-brand-blue)';
            case 'navy': return 'var(--color-brand-navy)';
            default: return 'var(--color-brand-lime)';
          }
        };

        const highlightElement = (index) => {
          const card = desktopInfographic.querySelector(`.info-card[data-index="${index}"]`);
          const hotspot = desktopInfographic.querySelector(`.desktop-hotspot[data-index="${index}"]`);
          const activeLine = document.getElementById(`line-active-${index}`);

          if (card) {
            const color = card.getAttribute("data-color");
            const colorVal = getColorValue(color);
            card.style.borderColor = colorVal;
            card.style.boxShadow = `0 10px 15px -3px rgba(0, 0, 0, 0.05), 0 4px 6px -2px ${colorVal}20`;
            card.classList.remove("bg-[#f8fafc]");
            card.classList.add("bg-white", "scale-[1.02]");
            card.style.zIndex = "40";

            const anchor = card.querySelector(".anchor-dot");
            if (anchor) {
              anchor.style.backgroundColor = colorVal;
              anchor.style.borderColor = colorVal;
            }
          }

          if (hotspot) {
            const color = hotspot.getAttribute("data-color");
            const colorVal = getColorValue(color);
            const ping = hotspot.querySelector(".hotspot-ping");
            const core = hotspot.querySelector(".hotspot-core");
            if (ping) {
              ping.classList.remove("bg-gray-400/80");
              ping.style.backgroundColor = colorVal;
              ping.classList.add("scale-125");
            }
            if (core) {
              core.classList.remove("bg-gray-400");
              core.style.backgroundColor = colorVal;
              core.classList.add("scale-125");
            }
          }

          if (activeLine) {
            const colorVal = activeLine.getAttribute("data-color");
            activeLine.style.stroke = colorVal;
            activeLine.style.opacity = "1";
            activeLine.setAttribute("stroke-width", "0.35");
            activeLine.classList.add("active");
          }
        };

        const resetAllElements = () => {
          cards.forEach(card => {
            card.style.borderColor = "";
            card.style.boxShadow = "";
            card.style.zIndex = "";
            card.classList.add("bg-[#f8fafc]");
            card.classList.remove("bg-white", "scale-[1.02]");
            const anchor = card.querySelector(".anchor-dot");
            if (anchor) {
              anchor.style.backgroundColor = "";
              anchor.style.borderColor = "";
            }
          });

          hotspots.forEach(hotspot => {
            const ping = hotspot.querySelector(".hotspot-ping");
            const core = hotspot.querySelector(".hotspot-core");
            if (ping) {
              ping.classList.add("bg-gray-400/80");
              ping.style.backgroundColor = "";
              ping.classList.remove("scale-125");
            }
            if (core) {
              core.classList.add("bg-gray-400");
              core.style.backgroundColor = "";
              core.classList.remove("scale-125");
            }
          });

          lines.forEach(line => {
            line.style.stroke = "";
            line.style.opacity = "";
            line.setAttribute("stroke-width", "0.25");
            line.classList.remove("active");
          });
        };

        cards.forEach(card => {
          card.addEventListener("pointerenter", () => {
            resetAllElements();
            highlightElement(card.getAttribute("data-index"));
          });
          card.addEventListener("pointerleave", resetAllElements);
        });

        hotspots.forEach(hotspot => {
          hotspot.addEventListener("pointerenter", () => {
            resetAllElements();
            highlightElement(hotspot.getAttribute("data-index"));
          });
          hotspot.addEventListener("pointerleave", resetAllElements);
        });
      }

      // Mobile Hotspot interaction: clicking scrolling down/highlighting card
      const mobileHotspots = document.querySelectorAll(".mobile-hotspot");
      const mobileCards = document.querySelectorAll(".mobile-sol-card");

      mobileHotspots.forEach(hotspot => {
        hotspot.addEventListener("click", () => {
          const targetId = hotspot.getAttribute("data-target");
          const targetCard = document.getElementById(targetId);
          if (targetCard) {
            // Reset mobile cards
            mobileCards.forEach(c => {
              c.classList.remove("border-[var(--color-brand-lime)]", "bg-white", "shadow-md");
              c.classList.add("bg-gray-50");
            });

            // Highlight target
            targetCard.classList.add("border-[var(--color-brand-lime)]", "bg-white", "shadow-md");
            targetCard.classList.remove("bg-gray-50");

            // Scroll to card
            targetCard.scrollIntoView({ behavior: "smooth", block: "center" });
          }
        });
      });

      mobileCards.forEach(card => {
        card.addEventListener("click", () => {
          const cardId = card.getAttribute("id");
          const hotspot = document.querySelector(`.mobile-hotspot[data-target="${cardId}"]`);
          
          // Reset cards
          mobileCards.forEach(c => {
            c.classList.remove("border-[var(--color-brand-lime)]", "bg-white", "shadow-md");
            c.classList.add("bg-gray-50");
          });
          
          // Highlight card
          card.classList.add("border-[var(--color-brand-lime)]", "bg-white", "shadow-md");
          card.classList.remove("bg-gray-50");

          if (hotspot) {
            // Scroll to the image container
            hotspot.parentElement.scrollIntoView({ behavior: "smooth", block: "center" });
            // Add custom dynamic pulse animation to the clicked hotspot
            hotspot.classList.add("scale-125");
            setTimeout(() => hotspot.classList.remove("scale-125"), 1000);
          }
        });
      });

    });
  </script>

  <style>
    .step-card-outer {
      clip-path: polygon(24px 0%, 100% 0%, 100% 100%, 0% 100%, 0% 24px);
    }
    .step-card-inner {
      clip-path: polygon(21px 0%, 100% 0%, 100% 100%, 0% 100%, 0% 21px);
    }
    @media (min-width: 768px) and (max-width: 1023px) {
      .step-card-outer {
        clip-path: polygon(16px 0%, 100% 0%, 100% 100%, 0% 100%, 0% 16px);
      }
      .step-card-inner {
        clip-path: polygon(14px 0%, 100% 0%, 100% 100%, 0% 100%, 0% 14px);
      }
    }

    /* Active dynamic pulse line flow */
    .line-active-path {
      transition: stroke-width 0.4s ease, opacity 0.4s ease, stroke-dashoffset 0.4s ease;
      stroke-dasharray: 4 2;
      stroke-dashoffset: 0;
    }
    .line-active-path.active {
      animation: linePulseFlow 1.5s linear infinite;
    }
    @keyframes linePulseFlow {
      to {
        stroke-dashoffset: -12;
      }
    }
    .desktop-hotspot .hotspot-ping, .desktop-hotspot .hotspot-core {
      transition: background-color 0.3s ease, transform 0.3s ease;
    }

    /* Watermark Map styling (static, no hover animations) */
    .mexico-map-watermark {
      filter: brightness(0) invert(1);
      transform: translate(3rem, 6rem) rotate(6deg);
    }
    @media (max-width: 767px) {
      .mexico-map-watermark {
        transform: translate(0, 5rem) rotate(4deg) scale(1) !important;
      }
    }

    /* Text styling and active animations for the banner (hover-only) */
    .banner-text-container {
      transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .coverage-banner:hover .banner-text-container {
      transform: scale(1.08);
    }
    .banner-text-shine {
      background: linear-gradient(
        to right,
        var(--color-brand-navy) 20%,
        #0284c7 40%,
        #06b6d4 50%,
        #0284c7 60%,
        var(--color-brand-navy) 80%
      );
      background-size: 200% auto;
      color: transparent;
      -webkit-background-clip: text;
      background-clip: text;
      transition: background-position 0.5s ease;
      background-position: 0% center;
      padding-right: 0.15em; /* Evita que la letra cursiva se corte al final por el background-clip */
    }
    .coverage-banner:hover .banner-text-shine {
      animation: textShine 2.5s linear infinite;
    }
    .banner-icon-animated {
      transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }
    .coverage-banner:hover .banner-icon-animated {
      animation: iconWiggle 2s ease-in-out infinite;
    }

    @keyframes textShine {
      to {
        background-position: 200% center;
      }
    }
    @keyframes iconWiggle {
      0%, 100% {
        transform: rotate(0deg) scale(1);
      }
      25% {
        transform: rotate(-10deg) scale(1.15);
      }
      75% {
        transform: rotate(10deg) scale(1.15);
      }
    }
  </style>
</Layout>

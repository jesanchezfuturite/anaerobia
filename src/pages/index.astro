---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import { getEntry } from 'astro:content';

const homepageEntry = await getEntry('homepage', 'index');
// Datos por defecto en caso de que Keystatic no haya generado el archivo aún
const data = homepageEntry?.data || {
  hero: {
    title: "Ingeniería Inteligente en Sistemas de Pintura y Acabado.",
    subtitle: "Diseñamos e integramos proyectos 'llave en mano' para manufactura de alto volumen.",
    buttons: [
      { label: "Hablar con un Ingeniero", url: "#contacto" },
      { label: "Ver Proyectos", url: "#proyectos" }
    ]
  },
  soluciones: {
    sectionTitle: "Soluciones Industriales Altamente Especializadas en Acabados Superficiales",
    sectionSubtitle: "Integramos tecnologías de punta para maximizar la calidad y el rendimiento en la línea de producción de tu planta.",
    cards: [
      { title: "Pintura en Polvo", description: "Cabinas y sistemas eficientes para recubrimientos impecables de piezas metálicas con alta durabilidad.", image: "https://loremflickr.com/800/600/industry,factory?lock=1" },
      { title: "Pintura Líquida", description: "Acabados estéticos de clase A con sistemas automatizados robotizados para la industria automotriz.", image: "https://loremflickr.com/800/600/industry,robot?lock=2" },
      { title: "Pretratamiento", description: "Equipos de lavado de etapas múltiples asegurando la adherencia ideal antes del recubrimiento.", image: "https://loremflickr.com/600/800/industry,welding?lock=3" },
      { title: "Hornos de Curado y Secado", description: "Hornos de convección e infrarrojos diseñados térmicamente para eficiencia energética superlativa.", image: "https://loremflickr.com/800/600/industry,oven,metal?lock=4" },
      { title: "Transportadores / Conveyors", description: "Desde sistemas overhead hasta floor conveyors. Movimiento exacto y fluido para tus piezas.", image: "https://loremflickr.com/800/600/industry,conveyor?lock=5" },
      { title: "Partes y Filtros", description: "Suministro de componentes críticos, refacciones y consumibles de alto rendimiento para tus equipos.", image: "https://loremflickr.com/800/600/industrial,engine,part?lock=45" }
    ]
  },
  mantenimiento: {
    sectionTitle: "Mantenimiento Preventivo",
    sectionSubtitle: "Garantizamos el funcionamiento ininterrumpido de tu inversión técnica mediante inspecciones detalladas e intervenciones programadas.",
    backgroundVideo: "/videos/mantenimiento.mp4",
    cards: [
      { title: "Inspección Técnica", description: "Auditorías a cabinas, hornos, conveyors y sistemas de pretratamiento para prever desgaste de piezas." },
      { title: "Pólizas de Mantenimiento", description: "Contratos programados mensuales o anuales para prolongar la vida útil y evitar paros de línea inesperados." },
      { title: "Refacciones Originales", description: "Asesoría e integración rápida de partes críticas de marcas como GRACO, FANUC, NORDSON y asociadas." }
    ]
  },
  contacto: {
    heading: "¿Listo para mejorar tu capacidad productiva?",
    description: "Nuestro equipo de ingeniería está listo para diseñar la solución exacta que tu línea de producción requiere.",
    phone: "+52 (81) 1234 5678",
    email: "contacto@anaerobia.com"
  },
  gestion360: {
    sectionTitle: "Gestión 360°",
    sectionSubtitle: "Acompañamiento total en cada etapa del proyecto",
    steps: ["Alcances y Necesidades", "Propuesta Técnico-Comercial", "Fabricación e Instalación", "Puesta en Marcha y Entrega Final", "Servicio Post-Venta"]
  },
  industrias: {
    sectionTitle: "Industrias",
    sectionSubtitle: "Soluciones especializadas para diversos sectores",
    items: [
      { name: "Ferroviaria", icon: "" },
      { name: "Tractocamión y equipo pesado", icon: "" },
      { name: "Automotriz", icon: "" },
      { name: "Aeroespacial", icon: "" },
      { name: "Agricultura y construcción", icon: "" },
      { name: "Metalmecánica", icon: "" },
      { name: "Electrodomésticos", icon: "" },
      { name: "Eléctrica y energía", icon: "" },
      { name: "Recreational vehicles", icon: "" },
      { name: "Industria en general", icon: "" }
    ]
  },
  normativas: {
    sectionTitle: "Normativas",
    certificados: [
      { name: "NFPA", logo: "/images/home/certificaciones/nfpa.png" },
      { name: "EPA", logo: "/images/home/certificaciones/epa.svg" },
      { name: "ETL", logo: "/images/home/certificaciones/etl.png" },
      { name: "ICC", logo: "/images/home/certificaciones/icc.png" },
      { name: "OSHA", logo: "/images/home/certificaciones/osha.png" }
    ]
  },
  mapa: {
    sectionTitle: "Proceso de Pintura",
    mapImage: "/images/home/mapa/presencia.svg"
  }
};

const defaultIcons = [
  `<svg class="w-12 h-12 stroke-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M12 18v-3m0 0a5 5 0 1 0 0-10 5 5 0 0 0 0 10Zm0 0v3m-3.75.75h7.5m-6 3h4.5" />
  </svg>`,
  `<svg class="w-12 h-12 stroke-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
  </svg>`,
  `<svg class="w-12 h-12 stroke-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065Z" />
    <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
  </svg>`,
  `<svg class="w-12 h-12 stroke-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M15.59 14.37a6 6 0 0 1-5.84 7.38v-4.8m5.84-2.58a14.98 14.98 0 0 0 6.16-12.12A14.98 14.98 0 0 0 9.59 8.37m6 6-6-6m0 0a14.99 14.99 0 0 1-6.16 12.12A14.99 14.99 0 0 1 9.59 8.37m0 0H4.8m4.79 0v4.8" />
  </svg>`,
  `<svg class="w-12 h-12 stroke-current" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.57-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
  </svg>`
];

const borderColors = [
  "bg-[var(--color-brand-lime)]",
  "bg-gradient-to-r from-[var(--color-brand-lime)] to-[var(--color-brand-blue)]",
  "bg-[var(--color-brand-blue)]",
  "bg-gradient-to-r from-[var(--color-brand-blue)] to-[var(--color-brand-navy)]",
  "bg-[var(--color-brand-navy)]"
];

const badgeColors = [
  "bg-[var(--color-brand-lime)]",
  "bg-[var(--color-brand-blue)]",
  "bg-[var(--color-brand-blue)]",
  "bg-[var(--color-brand-navy)]",
  "bg-[var(--color-brand-navy)]"
];

const textColors = [
  "text-[var(--color-brand-lime)]",
  "text-[var(--color-brand-blue)]",
  "text-[var(--color-brand-blue)]",
  "text-[var(--color-brand-navy)]",
  "text-[var(--color-brand-navy)]"
];

const arrowColors = [
  "text-[var(--color-brand-lime)]",
  "text-[var(--color-brand-blue)]",
  "text-[var(--color-brand-blue)]",
  "text-[var(--color-brand-navy)]",
  "text-[var(--color-brand-navy)]"
];

const infographicItems = [
  { index: 7, side: "left", cardTop: "8%", anchorY: 15, x: 50, y: 18, color: "lime", num: "01" },
  { index: 4, side: "left", cardTop: "30%", anchorY: 37, x: 35, y: 39, color: "blue", num: "02" },
  { index: 5, side: "left", cardTop: "53%", anchorY: 60, x: 25, y: 48, color: "navy", num: "03" },
  { index: 2, side: "left", cardTop: "76%", anchorY: 83, x: 41, y: 57, color: "blue", num: "04" },
  { index: 3, side: "right", cardTop: "6%", anchorY: 13, x: 53, y: 36, color: "navy", num: "05" },
  { index: 0, side: "right", cardTop: "24%", anchorY: 31, x: 46, y: 43, color: "lime", num: "06" },
  { index: 8, side: "right", cardTop: "42%", anchorY: 49, x: 63, y: 43, color: "blue", num: "07" },
  { index: 1, side: "right", cardTop: "60%", anchorY: 67, x: 50, y: 52, color: "blue", num: "08" },
  { index: 6, side: "right", cardTop: "78%", anchorY: 85, x: 59, y: 66, color: "lime", num: "09" }
];
---

<Layout title="Anaerobia | Ingeniería Inteligente en Sistemas de Pintura y Acabado">
  <main>
    <!-- A. Hero Section Cinematográfico -->
    <section class="relative min-h-screen overflow-hidden flex items-center pt-40 pb-12 landscape:pt-48 landscape:pb-20">
      <!-- Background Video Local -->
      <div class="absolute inset-0 w-full h-full z-0 overflow-hidden bg-[var(--color-brand-navy)]">
        <video 
           class="absolute inset-0 w-full h-full object-cover opacity-60 mix-blend-luminosity" 
           autoplay loop muted playsinline>
          <source src={data.hero.backgroundVideo || "/videos/home.mp4"} type="video/mp4" />
        </video>
      </div>
      
      <!-- Overlay -->
      <div class="absolute inset-0 bg-[var(--color-brand-navy)]/80 mix-blend-multiply z-10"></div>
      
      <!-- Contenido -->
      <div class="relative z-20 container mx-auto px-6 md:px-12 w-full">
        <div class="w-full lg:max-w-6xl hero-content">
          <span class="inline-block text-[var(--color-brand-lime)] font-semibold tracking-widest text-sm md:text-base mb-4 uppercase">
            Líderes en integración industrial
          </span>
          <h1 class="text-white font-saira italic font-semibold uppercase text-4xl md:text-5xl lg:text-6xl xl:text-[5.5rem] leading-[1.1] mb-6 w-full">
            <Fragment set:html={data.hero.title.toUpperCase().replace(' INTELIGENTE EN S', ' INTELIGENTE<br/>EN S').replace('PINTURA Y A', 'PINTURA Y A')} />
          </h1>
          <p class="text-gray-300 text-lg md:text-xl font-light max-w-2xl mb-8 whitespace-pre-line">
            {data.hero.subtitle}
          </p>
          <div class="flex flex-wrap gap-4">
            {data.hero.buttons.length > 0 && (
              <a href={data.hero.buttons[0]?.url || "#"} class="bg-[var(--color-brand-lime)] text-[var(--color-brand-navy)] font-semibold px-8 py-4 rounded hover:brightness-110 transition-all duration-300 transform hover:-translate-y-1">
                {data.hero.buttons[0]?.label}
              </a>
            )}
            {data.hero.buttons.length > 1 && (
              <a href={data.hero.buttons[1]?.url || "#"} class="flex items-center gap-2 border border-white text-white font-medium px-8 py-4 rounded hover:bg-white/10 transition-all duration-300 backdrop-blur-sm group">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-white group-hover:text-[var(--color-brand-lime)] transition-colors" fill="currentColor" viewBox="0 0 16 16">
                  <path d="M11.596 8.697l-6.363 3.692c-.54.313-1.233-.066-1.233-.697V4.308c0-.63.692-1.01 1.233-.696l6.363 3.692a.802.802 0 0 1 0 1.393z"/>
                </svg>
                {data.hero.buttons[1]?.label}
              </a>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- C. Bento Grid Dinámico -->
    <section id="soluciones" class="scroll-mt-24 md:scroll-mt-28 bg-[var(--color-industrial-gray)] py-24 bento-grid-container px-6 md:px-12">
      <div class="container mx-auto">
        <div class="mb-16">
          <h2 class="text-3xl md:text-5xl font-saira font-semibold italic text-[var(--color-brand-navy)]">
            {
              data.soluciones.sectionTitle.includes("Altamente Especializadas") ? (
                <>
                  {data.soluciones.sectionTitle.split("Altamente Especializadas")[0]}
                  <span class="text-[var(--color-brand-lime)]">Altamente Especializadas</span>
                  {data.soluciones.sectionTitle.split("Altamente Especializadas")[1]}
                </>
              ) : (
                data.soluciones.sectionTitle
              )
            }
          </h2>
          <p class="mt-4 text-gray-600 max-w-2xl text-lg whitespace-pre-line">{data.soluciones.sectionSubtitle}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 auto-rows-[480px]">
          {data.soluciones.cards.map((card, index) => (
            <div class={`bento-card group overflow-hidden relative rounded-xl shadow-[0_8px_30px_rgb(0,0,0,0.12)] cursor-pointer bg-white ${index === 5 ? '-translate-y-4 md:translate-y-0' : ''}`}>
              <img src={card.image || "https://loremflickr.com/800/600/industry?lock=" + index} alt={card.title} class={`object-cover h-full w-full transform transition-transform duration-700 group-hover:scale-110 ${index === 4 || index === 5 ? 'object-center' : ''}`} />
              <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-brand-navy)]/95 via-[var(--color-brand-navy)]/40 to-transparent"></div>
              <div class="absolute bottom-0 left-0 p-8 w-full">
                <h3 class="text-2xl font-semibold italic font-saira translate-y-4 group-hover:translate-y-0 transition-transform duration-300 text-white">{card.title}</h3>
                <p class="mt-2 opacity-0 group-hover:opacity-100 transition-opacity duration-300 delay-100 text-sm text-gray-200">{card.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- B. Marquee de Autoridad (Swiper.js) -->
    <section class="bg-white py-4 border-y border-gray-200 overflow-hidden flex items-center">
      <div class="container mx-auto px-6 flex flex-col md:flex-row items-center gap-6">
        <span class="text-gray-500 font-medium whitespace-nowrap text-sm mt-1 uppercase tracking-wide">
          Tecnología respaldada por aliados globales:
        </span>
        <div class="swiper marquee-swiper w-full">
          <div class="swiper-wrapper items-center">
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/fanuc.png" alt="FANUC" class="h-6 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>FANUC</span>'" /></div>
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/graco.png" alt="GRACO" class="h-6 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>GRACO</span>'" /></div>
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/binks.png" alt="BINKS" class="h-6 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>BINKS</span>'" /></div>
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/gfs.png" alt="GFS" class="h-6 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>GFS</span>'" /></div>
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/nordson.png" alt="NORDSON" class="h-6 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>NORDSON</span>'" /></div>
            
            <!-- Duplicate for loop -->
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/fanuc.png" alt="FANUC" class="h-6 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>FANUC</span>'" /></div>
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/graco.png" alt="GRACO" class="h-6 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>GRACO</span>'" /></div>
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/binks.png" alt="BINKS" class="h-6 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>BINKS</span>'" /></div>
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/gfs.png" alt="GFS" class="h-6 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>GFS</span>'" /></div>
            <div class="swiper-slide !w-auto px-8"><img src="/img/logos/nordson.png" alt="NORDSON" class="h-6 opacity-60 grayscale hover:grayscale-0 transition-all object-contain" onerror="this.outerHTML='<span class=\'text-2xl font-bold text-gray-400\'>NORDSON</span>'" /></div>
          </div>
        </div>
      </div>
    </section>



    <!-- NUEVA: E. Sección de Mantenimiento Preventivo -->
    <section id="mantenimiento" class="scroll-mt-24 md:scroll-mt-28 bg-[var(--color-brand-navy)] text-white py-24 px-6 md:px-12 relative overflow-hidden">
      <!-- Background Video Local -->
      <div class="absolute inset-0 w-full h-full z-0 overflow-hidden bg-[var(--color-brand-navy)]">
        {data.mantenimiento.backgroundVideo && (
          <video 
             class="absolute inset-0 w-full h-full object-cover opacity-60 mix-blend-luminosity" 
             autoplay loop muted playsinline>
            <source src={data.mantenimiento.backgroundVideo} type="video/mp4" />
          </video>
        )}
      </div>
      
      <!-- Overlay -->
      <div class="absolute inset-0 bg-[var(--color-brand-navy)]/80 mix-blend-multiply z-10"></div>

      <div class="absolute top-0 right-0 w-64 h-64 bg-[var(--color-brand-blue)] rounded-full blur-3xl opacity-20 transform translate-x-1/2 -translate-y-1/2 z-10"></div>
      <div class="container mx-auto relative z-20">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <img src="/img/logo_anservice_blanco.png" alt="Anservice" class="h-12 md:h-16 mx-auto mb-6 object-contain" />
          <h2 class="text-3xl md:text-5xl font-saira font-semibold italic mb-4">
            {
              data.mantenimiento.sectionTitle.includes("Preventivo") ? (
                <>
                  {data.mantenimiento.sectionTitle.split("Preventivo")[0]}
                  <span class="text-[var(--color-brand-lime)]">Preventivo</span>
                  {data.mantenimiento.sectionTitle.split("Preventivo")[1]}
                </>
              ) : (
                data.mantenimiento.sectionTitle
              )
            }
          </h2>
          <p class="text-gray-300 text-lg whitespace-pre-line">{data.mantenimiento.sectionSubtitle}</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 main-services-grid">
          {data.mantenimiento.cards.map((card, index) => {
            return (
              <div class={
                index === 0 ? "relative rounded-xl shadow-xl transition-transform duration-300 hover:-translate-y-2 flex flex-col bg-gradient-to-br from-[#003141] via-[#0c5b8c] to-[#003141]" :
                index === 1 ? "relative rounded-xl shadow-xl transition-transform duration-300 hover:-translate-y-2 flex flex-col p-[2px] bg-gradient-to-br from-[#9ac31c] via-[#0c5b8c] to-[#003141]" :
                "relative rounded-xl shadow-xl transition-transform duration-300 hover:-translate-y-2 flex flex-col bg-gradient-to-bl from-[#0c5b8c] via-[#003141] to-[#9ac31c]"
              }>
                <div class={
                  index === 1 ? "bg-[#003141] rounded-[10px] relative z-10 flex flex-col h-full p-8" :
                  "relative z-10 flex flex-col h-full p-8"
                }>
                  <div class="w-14 h-14 flex items-center justify-center rounded-lg mb-6 shadow-lg bg-white/10 border border-white/20">
                    {card.icon ? (
                      <Fragment set:html={card.icon} />
                    ) : (
                      <svg class="w-7 h-7 text-[#9ac31c]" fill="none" stroke="currentColor" viewBox="0 0 24 24">

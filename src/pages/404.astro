---
export const prerender = false

import Layout from '../layouts/Layout.astro'
import { withLocale } from '../lib/i18n.js'

// Página de error. Astro la sirve cuando una ruta devuelve un 404 con cuerpo
// vacío (fichas de producto, artículos o casos que no existen) y para
// cualquier URL que no case con ninguna ruta, incluidas las de /en/.
Astro.response.status = 404

const locale = Astro.url.pathname.startsWith('/en') ? 'en' : 'es'

const T = locale === 'en' ? {
  title: 'Page not found | Anaerobia', heading: 'This page does not exist',
  body: 'The link may be old or the page may have moved. These routes will take you to what you are looking for:',
  inicio: 'Home', partes: 'Parts and filters', blog: 'Blog', contacto: 'Contact',
} : {
  title: 'Página no encontrada | Anaerobia', heading: 'Esta página no existe',
  body: 'Puede que el enlace sea antiguo o que la página se haya movido. Estas rutas te llevan a lo que buscas:',
  inicio: 'Inicio', partes: 'Partes y filtros', blog: 'Blog', contacto: 'Contacto',
}
---

<Layout title={T.title} noindex>
  <section class="min-h-screen bg-[var(--color-brand-navy)] flex items-center justify-center pt-24 pb-12 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute top-0 right-0 w-96 h-96 bg-[var(--color-brand-lime)]/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-[var(--color-brand-blue)]/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10 text-center max-w-2xl">
      <p class="font-saira font-bold text-[var(--color-brand-lime)] text-7xl md:text-8xl mb-6">404</p>
      <h1 class="text-3xl md:text-4xl font-saira font-bold text-white mb-6 uppercase tracking-wider">{T.heading}</h1>
      <p class="text-gray-300 text-lg mb-12 font-light leading-relaxed">
        {T.body}
      </p>

      <div class="flex flex-col sm:flex-row flex-wrap justify-center gap-4">
        <a href={withLocale('/', locale)} class="inline-flex items-center justify-center px-8 py-4 font-bold text-[var(--color-brand-navy)] uppercase tracking-widest bg-[var(--color-brand-lime)] hover:bg-white transition-all duration-300 rounded shadow-xl hover:-translate-y-1">
          {T.inicio}
        </a>
        <a href={withLocale('/partes-y-filtros', locale)} class="inline-flex items-center justify-center px-8 py-4 font-bold text-white uppercase tracking-widest border border-white/30 hover:border-[var(--color-brand-lime)] hover:text-[var(--color-brand-lime)] transition-all duration-300 rounded">
          {T.partes}
        </a>
        <a href={withLocale('/blog', locale)} class="inline-flex items-center justify-center px-8 py-4 font-bold text-white uppercase tracking-widest border border-white/30 hover:border-[var(--color-brand-lime)] hover:text-[var(--color-brand-lime)] transition-all duration-300 rounded">
          {T.blog}
        </a>
        <a href={withLocale('/contacto', locale)} class="inline-flex items-center justify-center px-8 py-4 font-bold text-white uppercase tracking-widest border border-white/30 hover:border-[var(--color-brand-lime)] hover:text-[var(--color-brand-lime)] transition-all duration-300 rounded">
          {T.contacto}
        </a>
      </div>
    </div>
  </section>
</Layout>

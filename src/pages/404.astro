---
export const prerender = false

import Layout from '../layouts/Layout.astro'

// Página de error. Astro la sirve cuando una ruta devuelve un 404 con cuerpo
// vacío (fichas de producto, artículos o casos que no existen) y para
// cualquier URL que no case con ninguna ruta.
Astro.response.status = 404
---

<Layout title="Página no encontrada | Anaerobia" noindex>
  <section class="min-h-screen bg-[var(--color-brand-navy)] flex items-center justify-center pt-24 pb-12 relative overflow-hidden">
    <div class="absolute inset-0 z-0">
      <div class="absolute top-0 right-0 w-96 h-96 bg-[var(--color-brand-lime)]/10 rounded-full blur-3xl -translate-y-1/2 translate-x-1/4"></div>
      <div class="absolute bottom-0 left-0 w-96 h-96 bg-[var(--color-brand-blue)]/20 rounded-full blur-3xl translate-y-1/2 -translate-x-1/4"></div>
    </div>

    <div class="container mx-auto px-6 relative z-10 text-center max-w-2xl">
      <p class="font-saira font-bold text-[var(--color-brand-lime)] text-7xl md:text-8xl mb-6">404</p>
      <h1 class="text-3xl md:text-4xl font-saira font-bold text-white mb-6 uppercase tracking-wider">Esta página no existe</h1>
      <p class="text-gray-300 text-lg mb-12 font-light leading-relaxed">
        Puede que el enlace sea antiguo o que la página se haya movido. Estas rutas te llevan a lo que buscas:
      </p>

      <div class="flex flex-col sm:flex-row flex-wrap justify-center gap-4">
        <a href="/" class="inline-flex items-center justify-center px-8 py-4 font-bold text-[var(--color-brand-navy)] uppercase tracking-widest bg-[var(--color-brand-lime)] hover:bg-white transition-all duration-300 rounded shadow-xl hover:-translate-y-1">
          Inicio
        </a>
        <a href="/partes-y-filtros" class="inline-flex items-center justify-center px-8 py-4 font-bold text-white uppercase tracking-widest border border-white/30 hover:border-[var(--color-brand-lime)] hover:text-[var(--color-brand-lime)] transition-all duration-300 rounded">
          Partes y filtros
        </a>
        <a href="/blog" class="inline-flex items-center justify-center px-8 py-4 font-bold text-white uppercase tracking-widest border border-white/30 hover:border-[var(--color-brand-lime)] hover:text-[var(--color-brand-lime)] transition-all duration-300 rounded">
          Blog
        </a>
        <a href="/contacto" class="inline-flex items-center justify-center px-8 py-4 font-bold text-white uppercase tracking-widest border border-white/30 hover:border-[var(--color-brand-lime)] hover:text-[var(--color-brand-lime)] transition-all duration-300 rounded">
          Contacto
        </a>
      </div>
    </div>
  </section>
</Layout>

---
export const prerender = false

import Layout from "../../layouts/Layout.astro";

import fallback from '../../data/caso-ingenieria-alta-precision.json'

// Contenido administrable: se consulta la API del Admin (Laravel) en cada
// visita (SSR). Si la API no responde, se usa el respaldo local.
const API_URL = import.meta.env.ADMIN_API_URL ?? 'http://127.0.0.1:8000'
let d = fallback
try {
  const res = await fetch(`${API_URL}/api/v1/paginas/caso-ingenieria-alta-precision`, { signal: AbortSignal.timeout(5000) })
  if (res.ok) d = (await res.json()).data
} catch {
  // API no disponible: la página se sirve con el contenido de respaldo
}

const seoTitle = d.seo.title;
const seoDescription = d.seo.description;
---

<Layout title={seoTitle} description={seoDescription}>
  <main class="bg-white min-h-screen">

    <!-- Hero Section -->
    <section class="relative min-h-[50vh] flex flex-col justify-center pt-36 pb-12 bg-brand-navy overflow-hidden">
      <!-- Background Image -->
      <div class="absolute inset-0 z-0">
        <img
          src={d.hero.image}
          alt={d.hero.alt}
          class="w-full h-full object-cover object-center opacity-70"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-brand-navy/90 via-brand-navy/70 to-brand-navy/40"></div>
      </div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl mx-auto text-center">
          <span class="inline-block bg-brand-lime text-brand-navy text-xs md:text-sm font-bold uppercase tracking-widest py-1.5 px-4 rounded-full mb-6">
            {d.hero.badge}
          </span>
          <h1 class="text-white font-saira font-bold text-3xl md:text-5xl lg:text-6xl leading-tight mb-8">
            {d.hero.title}
          </h1>
        </div>
      </div>
    </section>

    <!-- Article Content -->
    <section class="py-16 md:py-24 px-6 md:px-12 bg-white text-gray-700">
      <div class="container mx-auto max-w-4xl">

        <!-- Intro -->
        <p class="text-xl md:text-2xl font-light text-brand-navy leading-relaxed mb-12">
          {d.intro.text}
        </p>

        <!-- Image 1 -->
        <div class="mb-12 rounded-2xl overflow-hidden shadow-lg">
          <img src={d.intro.image} alt={d.intro.alt} class="w-full h-auto object-cover max-h-[500px]" />
        </div>

        <!-- Section 1 -->
        <h2 class="text-2xl md:text-3xl font-saira font-bold text-brand-navy mb-6">{d.reto.title}</h2>
        <div class="space-y-6 text-lg font-light mb-12">
          {d.reto.paragraphs.map((p) => (
            <p>
              {p.text}
            </p>
          ))}
        </div>

        <!-- Two Column Images -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
          {d.galeria.images.map((img) => (
            <img src={img.image} alt={img.alt} class="w-full h-64 md:h-80 object-cover rounded-xl shadow-md" />
          ))}
        </div>

        <!-- Section 2 -->
        <h2 class="text-2xl md:text-3xl font-saira font-bold text-brand-navy mb-6">{d.solucion.title}</h2>
        <div class="space-y-6 text-lg font-light mb-12">
          {d.solucion.paragraphs.map((p) => (
            <p>
              {p.text}
            </p>
          ))}
        </div>

        <!-- Section 3 -->
        <div class="bg-gray-50 p-8 md:p-10 rounded-2xl border-l-4 border-brand-lime mb-12 shadow-sm">
          <h2 class="text-2xl md:text-3xl font-saira font-bold text-brand-navy mb-4">{d.resultado.title}</h2>
          {d.resultado.paragraphs.map((p, i) => (
            <p class={i === 0 ? "text-lg font-light mb-4" : "text-lg font-light"}>
              {p.text}
            </p>
          ))}
        </div>

        <!-- Section 4 -->
        <h2 class="text-2xl md:text-3xl font-saira font-bold text-brand-navy mb-6">{d.aprendizajes.title}</h2>
        <div class="space-y-6 text-lg font-light mb-16">
          {d.aprendizajes.paragraphs.map((p) => (
            <p>
              {p.text}
            </p>
          ))}
        </div>

        <!-- CTA Inside Content -->
        <div class="bg-brand-navy text-white rounded-2xl p-8 md:p-12 text-center shadow-xl relative overflow-hidden">
          <div class="absolute inset-0 opacity-10 bg-[url('/images/pattern-dots.svg')]"></div>
          <div class="relative z-10">
            <h2 class="text-2xl md:text-4xl font-saira font-bold mb-6 text-brand-lime">{d.cta.title}</h2>
            <p class="text-lg md:text-xl font-light mb-8 max-w-2xl mx-auto">
              {d.cta.description}
            </p>
            <a href={d.cta.button_url} class="inline-block bg-brand-lime text-brand-navy font-bold uppercase tracking-widest py-3 px-8 rounded hover:bg-white transition-colors duration-300">
              {d.cta.button_label}
            </a>
          </div>
        </div>

        <!-- Back Link -->
        <div class="mt-16 text-center">
          <a href={d.volver.url} class="inline-flex items-center text-brand-navy font-bold uppercase tracking-widest hover:text-brand-lime transition-colors group">
            <svg class="w-5 h-5 mr-2 transform group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
            {d.volver.label}
          </a>
        </div>

      </div>
    </section>
  </main>
</Layout>

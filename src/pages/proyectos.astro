---
export const prerender = false

import Layout from "../layouts/Layout.astro";
import { getUltimosCasos } from '../lib/casos-de-estudio.js'

import fallback from '../data/proyectos.json'

// Contenido administrable: se consulta la API del Admin (Laravel) en cada
// visita (SSR). Si la API no responde, se usa el respaldo local.
const API_URL = import.meta.env.ADMIN_API_URL ?? 'http://127.0.0.1:8000'
let d = fallback
try {
  const res = await fetch(`${API_URL}/api/v1/paginas/proyectos`, { signal: AbortSignal.timeout(5000) })
  if (res.ok) d = (await res.json()).data
} catch {
  // API no disponible: la página se sirve con el contenido de respaldo
}

// SEO Metadata
const seoTitle = d.seo?.title
const seoDescription = d.seo?.description

const industries = d.industrias?.items ?? []

// Los 3 casos de estudio más recientes se administran en su propio módulo
// (Casos de Estudio), no como tarjetas fijas de esta página.
const caseStudies = await getUltimosCasos(3)

---

<Layout title={seoTitle} description={seoDescription}>
  <main class="bg-industrial-gray min-h-screen text-brand-navy">
    <!-- 01. HEADER / HERO -->
    <section class="relative min-h-[50vh] md:min-h-[60vh] flex items-center pt-36 pb-20 bg-brand-navy overflow-hidden">
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0 z-0">
        <img src={d.hero.image} alt={d.hero.alt} class="w-full h-full object-cover object-center opacity-50 scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/80 to-brand-navy/60"></div>
      </div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl hero-section-text">
          <!-- Breadcrumbs -->
          <nav class="flex items-center gap-2 text-xs md:text-sm text-gray-400 font-semibold uppercase tracking-widest mb-6">
            <a href="/" class="hover:text-brand-lime transition-colors">Inicio</a>
            <span>/</span>
            <span class="text-brand-lime">Proyectos</span>
          </nav>

          <h1 class="text-white font-saira italic font-semibold uppercase text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] mb-6">
            {d.hero.title}
          </h1>
          <p class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed whitespace-pre-wrap">
            {d.hero.description}
          </p>
        </div>
      </div>
    </section>


    

    <!-- 02. MASONRY GALLERY (INDUSTRIES) -->
    <section class="py-16 md:py-24 px-6 md:px-12 relative bg-white min-h-screen">
      <div class="container mx-auto">
        <h2 class="text-3xl md:text-5xl font-saira font-bold text-center text-brand-navy mb-12 uppercase">
          {d.industrias.sectionTitle}
        </h2>
        
        <!-- Masonry Grid -->
        <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6" id="masonry-gallery">
          {industries.map((item) => (
            <div class="gallery-item relative group break-inside-avoid rounded-xl overflow-hidden shadow-md cursor-pointer bg-gray-100">
              <img 
                src={item.image} 
                alt={item.title} 
                loading="lazy"
                class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <!-- Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/90 via-brand-navy/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
                <h3 class="text-white font-saira font-bold text-xl md:text-2xl leading-tight transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                  {item.title}
                </h3>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    

    <!-- 03. CASOS DE ESTUDIO -->
    <section class="py-16 px-6 md:px-12 relative bg-gray-50">
      <div class="container mx-auto max-w-7xl">
        <h2 class="text-3xl md:text-5xl font-saira font-bold text-center text-brand-navy mb-12 uppercase">
          {d.casos_estudio.sectionTitle}
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {caseStudies.map((caso) => (
            <a href={`/casos-de-estudio/${caso.slug}`} class="bg-white rounded-lg shadow-lg overflow-hidden flex flex-col transition-transform duration-300 hover:-translate-y-2 group border border-gray-100">
              <!-- Top Image -->
              <div class="relative h-64 overflow-hidden bg-industrial-gray">
                {caso.cover && (
                  <img
                    src={caso.cover}
                    alt={caso.cover_alt ?? caso.title}
                    loading="lazy"
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  />
                )}
                {caso.category && (
                  <span class="absolute top-4 right-4 bg-brand-navy/80 text-white text-xs font-bold uppercase tracking-wider py-1 px-3 rounded-full backdrop-blur-sm">
                    {caso.category.name}
                  </span>
                )}
              </div>

              <!-- Content -->
              <div class="p-8 flex flex-col flex-grow">
                <h3 class="text-xl md:text-2xl font-saira font-bold text-brand-navy mb-4 leading-tight">
                  {caso.title}
                </h3>
                <p class="text-gray-600 mb-8 font-light flex-grow leading-relaxed whitespace-pre-wrap">
                  {caso.excerpt}
                </p>

                <span class="inline-flex items-center text-brand-lime font-bold uppercase tracking-widest text-sm group-hover:text-brand-navy transition-colors mt-auto group-hover:underline decoration-2 underline-offset-4">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                  Leer más
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- 04. CTA BOTTOM -->
    <section class="py-24 relative overflow-hidden" id="contacto-cta">
      <div class="absolute inset-0 z-0">
        <img src={d.cta.image} alt={d.cta.alt} class="w-full h-full object-cover scale-[1.02]" />
        <div class="absolute inset-0 bg-brand-navy/90 mix-blend-multiply"></div>
        <div class="absolute inset-0 bg-[#001c29]/75"></div>
      </div>

      <div class="container mx-auto px-6 relative z-10 text-center max-w-5xl">
        <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-[2.5rem] font-saira italic font-bold text-white uppercase mb-5 tracking-wider">
          {d.cta.title}
        </h2>
        <p class="text-base md:text-lg text-gray-300 mb-10 max-w-3xl mx-auto font-light leading-relaxed whitespace-pre-wrap">
          {d.cta.description}
        </p>
        <div class="flex justify-center">
          <a href={d.cta.button_url} class="inline-flex items-center justify-center px-10 py-4 font-bold text-brand-navy text-sm md:text-base uppercase tracking-widest bg-brand-lime hover:bg-[#8da31c] transition-colors rounded-sm shadow-xl">
            {d.cta.button_label}
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Hero GSAP animations
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.from('.hero-section-text > *', {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.1,
        ease: 'power3.out',
        delay: 0.2
      });
    }
  });
</script>

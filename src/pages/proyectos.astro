---

<Layout title={seoTitle} description={seoDescription}>
  <main class="bg-industrial-gray min-h-screen text-brand-navy">
    <!-- 01. HEADER / HERO -->
    <section class="relative min-h-[50vh] md:min-h-[60vh] flex items-center pt-36 pb-20 bg-brand-navy overflow-hidden">
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0 z-0">
        <img src="/images/home/galeria/factory_gallery_2_1780332570757.png" alt="Proyectos Anaerobia" class="w-full h-full object-cover object-center opacity-50 scale-105" />
        <div class="absolute inset-0 bg-gradient-to-t from-brand-navy via-brand-navy/80 to-brand-navy/60"></div>
      </div>

      <div class="container mx-auto px-6 relative z-10">
        <div class="max-w-4xl hero-section-text">
          <!-- Breadcrumbs -->
          <nav class="flex items-center gap-2 text-xs md:text-sm text-gray-400 font-semibold uppercase tracking-widest mb-6">
            <a href="/" class="hover:text-brand-lime transition-colors">Inicio</a>
            <span>/</span>
            <span class="text-brand-lime">Proyectos</span>
          </nav>

          <span class="inline-block bg-brand-lime/10 text-brand-lime border border-brand-lime/20 rounded px-3 py-1 text-xs font-semibold uppercase tracking-widest mb-6">
            Galería
          </span>
          <h1 class="text-white font-saira italic font-semibold uppercase text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] mb-6">
            Proyectos
          </h1>
          <p class="text-gray-300 text-lg md:text-xl font-light max-w-3xl leading-relaxed">
            Explora nuestra galería de soluciones implementadas. Cada proyecto es testimonio de nuestra capacidad de ingeniería, tecnología y diseño especializado.
          </p>
        </div>
      </div>
    </section>

    <!-- 02. FILTERS & MASONRY GALLERY -->
    <section class="py-16 md:py-24 px-6 md:px-12 relative bg-white min-h-screen">
      <div class="container mx-auto">
        
        <!-- Filtros -->
        <div class="flex flex-wrap justify-center gap-3 mb-12 md:mb-16" id="filter-buttons">
          {filters.map((filter) => (
            <button 
              data-filter={filter.id} 
              class={`filter-btn px-6 py-2 rounded-full font-semibold text-sm uppercase tracking-wider transition-all duration-300 border-2 
                ${filter.id === 'todos' 
                  ? 'bg-brand-navy border-brand-lime text-white shadow-lg' 
                  : 'bg-transparent border-gray-200 text-gray-500 hover:border-brand-lime hover:text-brand-navy'}`}
            >
              {filter.label}
            </button>
          ))}
        </div>

        <!-- Masonry Grid -->
        <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6" id="masonry-gallery">
          {projects.map((project) => (
            <div 
              class="gallery-item relative group break-inside-avoid rounded-xl overflow-hidden shadow-md cursor-pointer bg-gray-100"
              data-category={project.category}
            >
              <img 
                src={project.image} 
                alt={project.title} 
                loading="lazy"
                class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-105"
              />
              <!-- Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-brand-navy/90 via-brand-navy/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-6">
                <span class="text-brand-lime text-xs font-bold uppercase tracking-widest mb-2 inline-block transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                  {project.categoryLabel}
                </span>
                <h3 class="text-white font-saira font-bold text-xl md:text-2xl leading-tight transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300 delay-75">
                  {project.title}
                </h3>
              </div>
            </div>
          ))}
        </div>
        
        <!-- Empty State (Hidden by default) -->
        <div id="empty-state" class="hidden text-center py-20">
          <svg class="w-16 h-16 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          <p class="text-gray-500 font-light text-lg">No hay proyectos en esta categoría por el momento.</p>
        </div>

      </div>
    </section>

    <!-- 03. CTA BOTTOM -->
    <section class="relative min-h-[350px] flex items-center py-20 overflow-hidden">
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0 z-0">
        <img src="/img/parallax_bg.webp" alt="Instalaciones Anaerobia" class="w-full h-full object-cover scale-[1.02]" />
        <div class="absolute inset-0 bg-brand-navy/85 mix-blend-multiply"></div>
        <div class="absolute inset-0 bg-[#001c29]/75"></div>
      </div>

      <div class="container mx-auto px-6 relative z-10 text-center max-w-5xl">
        <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-[2.5rem] font-saira italic font-bold text-white uppercase mb-5 tracking-wider">
          ¿Listo para iniciar tu próximo proyecto?
        </h2>
        <p class="text-base md:text-lg text-gray-300 mb-10 max-w-3xl mx-auto font-light leading-relaxed">
          Contacta a nuestros expertos y diseñemos juntos el sistema ideal para optimizar los procesos de tu planta.
        </p>
        <div class="flex justify-center">
          <a href="/contacto" class="inline-flex items-center justify-center px-10 py-4 font-bold text-brand-navy text-sm md:text-base uppercase tracking-widest bg-brand-lime hover:bg-[#8da31c] transition-colors rounded-sm shadow-xl">
            Hablemos de tu Proyecto
          </a>
        </div>
      </div>
    </section>

  </main>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const galleryItems = document.querySelectorAll('.gallery-item');
    const emptyState = document.getElementById('empty-state');
    const masonryGallery = document.getElementById('masonry-gallery');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        // Remove active styling from all buttons
        filterBtns.forEach(b => {
          b.classList.remove('bg-brand-navy', 'border-brand-navy', 'text-white', 'shadow-lg');
          b.classList.add('bg-transparent', 'border-gray-200', 'text-gray-500', 'hover:border-brand-lime', 'hover:text-brand-navy');
        });

        // Add active styling to clicked button
        btn.classList.remove('bg-transparent', 'border-gray-200', 'text-gray-500', 'hover:border-brand-lime', 'hover:text-brand-navy');
        btn.classList.add('bg-brand-navy', 'border-brand-lime', 'text-white', 'shadow-lg');

        const filterValue = btn.getAttribute('data-filter');
        let visibleCount = 0;

        // Filter items
        galleryItems.forEach(item => {
          const category = item.getAttribute('data-category');
          
          if (filterValue === 'todos' || category === filterValue) {
            item.style.display = 'block';
            visibleCount++;
            // A simple fade in effect
            item.animate([
              { opacity: 0, transform: 'scale(0.95)' },
              { opacity: 1, transform: 'scale(1)' }
            ], {
              duration: 400,
              easing: 'ease-out'
            });
          } else {
            item.style.display = 'none';
          }
        });

        // Show empty state if no items match
        if (visibleCount === 0) {
          emptyState.classList.remove('hidden');
          masonryGallery.classList.add('hidden');
        } else {
          emptyState.classList.add('hidden');
          masonryGallery.classList.remove('hidden');
        }
      });
    });

    // Hero GSAP animations
    if (typeof gsap !== 'undefined' && typeof ScrollTrigger !== 'undefined') {
      gsap.from('.hero-section-text > *', {
        y: 30,
        opacity: 0,
        duration: 0.8,
        stagger: 0.1,
        ease: 'power3.out',
        delay: 0.2
      });
      
      gsap.from('.gallery-item', {
        y: 30,
        opacity: 0,
        duration: 0.6,
        stagger: 0.05,
        ease: 'power3.out',
        delay: 0.4
      });
    }
  });
</script>

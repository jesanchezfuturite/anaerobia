  <!-- ================================================
       SECCIÓN: CTA FINAL — COTIZACIÓN
       ================================================ -->
  <section
    id="cotizar"
    class="section-pad relative overflow-hidden"
    style={`background: linear-gradient(135deg, rgba(0, 49, 65, 0.85) 0%, rgba(12, 91, 140, 0.85) 100%), url('${base}bg_contacto.png'); background-size: cover; background-position: center;`}
    aria-labelledby="cta-heading"
  >
    <!-- Grid decorativo -->
    <div
      class="absolute inset-0 opacity-[0.06]"
      style="background-image: linear-gradient(rgba(154,195,28,1) 1px, transparent 1px), linear-gradient(90deg, rgba(154,195,28,1) 1px, transparent 1px); background-size: 48px 48px;"
      aria-hidden="true"
    ></div>
    <div class="container-aneffy relative z-10 flex flex-col items-center text-center gap-6">
      <div class="flex items-center gap-3">
        <span class="w-8 h-px" style="background:#9ac31c;" aria-hidden="true"></span>
        <span class="font-roboto text-xs tracking-[0.25em] uppercase font-semibold" style="color:#9ac31c;">Contacto Directo</span>
        <span class="w-8 h-px" style="background:#9ac31c;" aria-hidden="true"></span>
      </div>
      <h2 id="cta-heading" class="font-saira font-bold uppercase text-white" style="font-size: clamp(2rem, 5vw, 4rem); line-height:1.05;">
        ¿Necesitas un Filtro<br />
        <span style="color:#9ac31c;">Ahora Mismo?</span>
      </h2>
      <p class="font-roboto font-light text-lg max-w-xl leading-relaxed" style="color:rgba(255,255,255,0.72);">
        Habla con un especialista en filtración industrial. Respuesta garantizada.
      </p>
      <form id="contact-form" class="w-full max-w-2xl mx-auto mt-8 flex flex-col text-left bg-[#001820]/40 backdrop-blur-sm rounded-xl border border-white/10 shadow-2xl" style="gap: 2rem; padding: 2.5rem;" novalidate>
        <div class="grid grid-cols-1 md:grid-cols-2" style="gap: 1.5rem;">
          <div class="flex flex-col" style="gap: 0.5rem;">
            <label for="nombre" class="text-white text-sm font-roboto tracking-wide">Nombre completo *</label>
            <input type="text" id="nombre" name="nombre" required class="rounded-lg bg-white/5 border border-white/10 text-white placeholder-white/30 focus:outline-none focus:border-[#9ac31c] focus:bg-white/10 transition-all font-roboto" style="padding: 1rem 1.25rem;" placeholder="Ej. Juan Pérez">
          </div>
          <div class="flex flex-col" style="gap: 0.5rem;">
            <label for="correo" class="text-white text-sm font-roboto tracking-wide">Correo electrónico *</label>
            <input type="email" id="correo" name="correo" required class="rounded-lg bg-white/5 border border-white/10 text-white placeholder-white/30 focus:outline-none focus:border-[#9ac31c] focus:bg-white/10 transition-all font-roboto" style="padding: 1rem 1.25rem;" placeholder="juan@empresa.com">
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2" style="gap: 1.5rem;">
          <div class="flex flex-col" style="gap: 0.5rem;">
            <label for="telefono" class="text-white text-sm font-roboto tracking-wide">Teléfono *</label>
            <input type="tel" id="telefono" name="telefono" required class="rounded-lg bg-white/5 border border-white/10 text-white placeholder-white/30 focus:outline-none focus:border-[#9ac31c] focus:bg-white/10 transition-all font-roboto" style="padding: 1rem 1.25rem;" placeholder="Ej. 55 1234 5678">
          </div>
          <div class="flex flex-col" style="gap: 0.5rem;">
            <label for="empresa" class="text-white text-sm font-roboto tracking-wide">Empresa *</label>
            <input type="text" id="empresa" name="empresa" required class="rounded-lg bg-white/5 border border-white/10 text-white placeholder-white/30 focus:outline-none focus:border-[#9ac31c] focus:bg-white/10 transition-all font-roboto" style="padding: 1rem 1.25rem;" placeholder="Nombre de tu empresa">
          </div>
        </div>
        <div class="flex flex-col" style="gap: 0.5rem;">
          <label for="mensaje" class="text-white text-sm font-roboto tracking-wide">Mensaje o requerimiento *</label>
          <textarea id="mensaje" name="mensaje" rows="4" required class="rounded-lg bg-white/5 border border-white/10 text-white placeholder-white/30 focus:outline-none focus:border-[#9ac31c] focus:bg-white/10 transition-all font-roboto resize-y" style="padding: 1rem 1.25rem;" placeholder="Describe brevemente tus necesidades de filtración..."></textarea>
        </div>
        
        <input type="hidden" name="origen" value="">
        
        <div class="flex flex-col items-center mt-2">
          <button type="submit" id="submit-btn" class="btn-primary text-base px-10 py-4 w-full md:w-auto flex items-center justify-center gap-2 group">
            <i class="ph ph-paper-plane-right text-xl group-hover:translate-x-1 transition-transform" aria-hidden="true"></i>
            <span>Enviar Mensaje</span>
          </button>
          <p id="form-status" class="text-center font-roboto text-sm mt-4 hidden"></p>
        </div>
      </form>

      <script define:vars={{ baseUrl: base }} is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          const form = document.getElementById('contact-form');
          const submitBtn = document.getElementById('submit-btn');
          const formStatus = document.getElementById('form-status');

          if (form) {
            form.addEventListener('submit', async (e) => {
              e.preventDefault();
              
              const formData = new FormData(form);
              const data = Object.fromEntries(formData.entries());
              
              // Asignar dinámicamente la URL actual (incluyendo subdirectorios) al campo origen
              data.origen = window.location.href.split('?')[0];

              // Extraer parámetros de la URL (como los UTMs) y agregarlos al envío
              const urlParams = new URLSearchParams(window.location.search);
              for (const [key, value] of urlParams.entries()) {
                data[key] = value;
              }
              
              // Validación personalizada
              let isValid = true;
              let errorMessage = '';
              const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
              const phoneRegex = /^[0-9\s\+\-\(\)]+$/; // Permite números y formato básico
              const digitsOnly = data.telefono.replace(/\D/g, '');
              
              if (!data.nombre.trim()) { isValid = false; errorMessage = 'El nombre es obligatorio.'; }
              else if (!data.correo.trim() || !emailRegex.test(data.correo)) { isValid = false; errorMessage = 'Ingresa un correo electrónico válido.'; }
              else if (!data.telefono.trim() || !phoneRegex.test(data.telefono) || digitsOnly.length < 8) { isValid = false; errorMessage = 'Ingresa un teléfono válido (solo números, mín. 8 dígitos).'; }
              else if (!data.empresa.trim()) { isValid = false; errorMessage = 'El nombre de la empresa es obligatorio.'; }
              else if (!data.mensaje.trim()) { isValid = false; errorMessage = 'El mensaje no puede estar vacío.'; }

              if (!isValid) {
                formStatus.textContent = errorMessage;
                formStatus.className = 'text-center font-roboto text-sm text-red-400 font-medium bg-red-400/10 rounded-md border border-red-400/30';
                formStatus.style.padding = '1rem 1.5rem';
                formStatus.style.marginTop = '1.5rem';
                formStatus.classList.remove('hidden');
                return;
              }

              // Estado de carga
              const originalBtnHtml = submitBtn.innerHTML;
              submitBtn.innerHTML = '<i class="ph ph-spinner-gap animate-spin text-xl"></i><span>Enviando...</span>';
              submitBtn.disabled = true;
              submitBtn.style.opacity = '0.7';
              submitBtn.style.cursor = 'not-allowed';

              try {
                // El lead va al panel de Anaerobia, igual que el formulario de
                // contacto del sitio: queda en «Leads y Contactos» y se da de
                // alta en Brevo. El campo «mensaje» es el requerimiento.
                const { mensaje, ...resto } = data;

                const response = await fetch('/api/lead', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ ...resto, requerimiento: mensaje })
                });

                if (response.ok) {
                  // Redirigir a la página de gracias
                  window.location.href = baseUrl + 'gracias';
                } else {
                  throw new Error('Error de red');
                }
              } catch (error) {
                formStatus.textContent = 'Ocurrió un error al intentar enviar tu mensaje. Por favor, inténtalo más tarde.';
                formStatus.className = 'text-center font-roboto text-sm text-red-400 font-medium bg-red-400/10 rounded-md border border-red-400/30';
                formStatus.style.padding = '1rem 1.5rem';
                formStatus.style.marginTop = '1.5rem';
                formStatus.classList.remove('hidden');
                
                // Restaurar estado del botón solo si hubo error
                submitBtn.innerHTML = originalBtnHtml;
                submitBtn.disabled = false;
                submitBtn.style.opacity = '1';
                submitBtn.style.cursor = 'pointer';
              }
            });
          }
        });
      </script>
    </div>
  </section>

</Layout>

<!-- ================================================
     ANIMACIONES GSAP
     ================================================ -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    let initialized = false;
    // Espera a que GSAP esté disponible
    function initAnimations() {
      if (initialized) return;
      if (typeof gsap === 'undefined' || typeof ScrollTrigger === 'undefined') {
        setTimeout(initAnimations, 100);
        return;
      }
      initialized = true;

      gsap.registerPlugin(ScrollTrigger);

      // ── Hero: animación de entrada en cascada ──
      const heroItems = document.querySelectorAll('.gsap-hero-item');
      if (heroItems.length) {
        gsap.from(heroItems, {
          y: 50,
          opacity: 0,
          stagger: 0.2,
          duration: 1,
          ease: 'power3.out',
          delay: 0.3,
        });
      }

      // ── Bento Cards: aparecen al hacer scroll ──
      const bentoCards = document.querySelectorAll('.gsap-bento-card');
      if (bentoCards.length) {
        gsap.from(bentoCards, {
          scrollTrigger: {
            trigger: bentoCards[0],
            start: 'top 85%',
            toggleActions: 'play none none none',
          },
          y: 50,
          opacity: 0,
          stagger: 0.15,
          duration: 0.8,
          ease: 'power2.out',
        });
      }
    }

    // Inicializa cuando GSAP esté listo
    document.addEventListener('gsap:ready', initAnimations);
    // Fallback: intenta inicializar de todas formas
    setTimeout(initAnimations, 500);
  });
</script>

<style>
  /* Scroll dot animation */
  .scroll-dot {
    animation: scrollBounce 1.8s ease-in-out infinite;
  }
  @keyframes scrollBounce {
    0%, 100% { transform: translateY(0); opacity: 1; }
    50%       { transform: translateY(10px); opacity: 0.3; }
  }
</style>

                <td class="p-5 font-roboto font-bold text-xl border-r border-[rgba(255,255,255,0.1)]" style="color: #9ac31c;">S4 DIN5510/<br/>DIN54837</td>
                <td class="p-5 font-roboto font-bold text-2xl border-r border-[rgba(255,255,255,0.1)]" style="color: #9ac31c;">500g/m2</td>

---
import Layout from '../../layouts/AneffyLayout.astro';

// La landing vive en /aneffy dentro del sitio.
const base = '/aneffy/';
---

<Layout title="ANEFFY | Filtros Industriales de Máxima Eficiencia">

  <!-- ================================================
       HERO SECTION
       ================================================ -->
  <section
    id="hero"
    class="relative min-h-[85vh] flex items-center overflow-hidden"
    aria-labelledby="hero-heading"
  >
    <!-- Fondo: gradiente + grid decorativo -->
    <div class="absolute inset-0 -z-10" style="background: linear-gradient(135deg, #003141 0%, #00243a 55%, #001820 100%);"></div>
    <div
      class="absolute inset-0 -z-10 opacity-[0.05]"
      style="background-image: linear-gradient(rgba(154,195,28,1) 1px, transparent 1px), linear-gradient(90deg, rgba(154,195,28,1) 1px, transparent 1px); background-size: 56px 56px;"
      aria-hidden="true"
    ></div>

    <!-- Orbe decorativo derecha -->
    <div
      class="absolute right-0 top-1/2 -translate-y-1/2 w-[600px] h-[600px] rounded-full -z-10 blur-3xl opacity-20"
      style="background: radial-gradient(circle, #0c5b8c 0%, transparent 70%);"
      aria-hidden="true"
    ></div>
    <!-- Acento lime inferior izquierdo -->
    <div
      class="absolute -bottom-24 -left-24 w-64 h-64 rounded-full -z-10 blur-2xl opacity-15"
      style="background: #9ac31c;"
      aria-hidden="true"
    ></div>

    <div class="container-aneffy w-full section-pad section-pad-hero">
      <div class="grid grid-cols-1 lg:grid-cols-2 items-start gap-12 lg:gap-16">
        <div class="max-w-3xl">

        <!-- Badge -->
        <div class="gsap-hero-item inline-flex items-center gap-3" style="margin-bottom: 2rem;">
          <span class="w-8 h-px" style="background:#9ac31c;" aria-hidden="true"></span>
          <span
            class="font-roboto tracking-widest text-xs uppercase font-semibold"
            style="color:#9ac31c;"
          >Filtro marca ANAEROBIA</span>
        </div>

        <!-- H1 -->
        <h1
          id="hero-heading"
          class="gsap-hero-item font-saira font-bold text-white leading-none tracking-wide uppercase"
          style="font-size: clamp(2.8rem, 7vw, 5.5rem); line-height: 1.0;"
        >
          Máxima Eficiencia.<br />
          <span style="color:#9ac31c;">Cero Fricción</span><br />
          Logística.
        </h1>

        <!-- Párrafo de apoyo -->
        <p
          class="gsap-hero-item font-roboto font-light text-lg md:text-xl max-w-2xl leading-relaxed"
          style="color: rgba(255,255,255,0.68); margin-top: 2rem;"
        >
          Filtros industriales diseñados con 100% de compatibilidad OEM para tus cabinas.
          Calidad técnica de excelencia.
        </p>

        <!-- Botones CTA -->
        <div class="gsap-hero-item flex flex-col sm:flex-row" style="gap: 1.5rem; margin-top: 3rem;">
          <a
            href="#cotizar"
            id="hero-cta-primary"
            class="btn-primary text-lg px-8 py-4"
          >
            <i class="ph ph-package text-xl" aria-hidden="true"></i>
            Cotizar Filtro
          </a>
          <a
            href="#caracteristicas"
            id="hero-cta-secondary"
            class="btn-secondary text-lg px-8 py-4"
          >
            <i class="ph ph-file-text text-xl" aria-hidden="true"></i>
            Ver Especificaciones
          </a>
        </div>



        </div>

        <!-- Columna derecha: Imagen Hero -->
        <div class="gsap-hero-item hidden lg:flex justify-end relative h-full">
          <div class="relative w-full max-w-full flex items-start" style="transform: scale(1.05); transform-origin: top right;">
             <!-- Decoración Glow Intensificada pero sin líneas de cuadro (Aura redonda) -->
             <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-4/5 h-4/5 rounded-full opacity-60" style="background: radial-gradient(circle, #9ac31c 0%, #0c5b8c 80%, transparent 100%); filter: blur(80px);"></div>
             
             <!-- Imagen difuminada en los bordes para no parecer un cuadro -->
             <img 
               src={`${base}hero1.webp`} 
               alt="Filtro Industrial ANEFFY" 
               class="relative z-10 w-full h-auto" 
               style="mask-image: radial-gradient(circle at center, black 60%, transparent 100%); -webkit-mask-image: radial-gradient(circle at center, black 60%, transparent 100%);"
               loading="eager"
             />
          </div>
        </div>

      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 opacity-35" aria-hidden="true">
      <div class="w-5 h-8 rounded-full border flex justify-center pt-1.5" style="border-color:rgba(255,255,255,0.3);">
        <div class="w-1 h-2 rounded-full scroll-dot" style="background:#9ac31c;"></div>
      </div>
    </div>
  </section>

  <!-- ================================================
       BENTO GRID — VENTAJAS COMPETITIVAS
       ================================================ -->
  <section
    id="ventajas"
    class="section-pad overflow-hidden"
    style="background: linear-gradient(180deg, #001820 0%, #002535 100%);"
    aria-labelledby="ventajas-heading"
  >
    <div class="container-aneffy">

      <!-- Encabezado de sección -->
      <div class="flex flex-col gap-3 max-w-2xl">
        <div class="flex items-center gap-3">
          <span class="w-8 h-px" style="background:#9ac31c;" aria-hidden="true"></span>
          <span class="font-roboto text-xs tracking-[0.25em] uppercase font-semibold" style="color:#9ac31c;">
            Ventajas Competitivas
          </span>
        </div>
        <h2
          id="ventajas-heading"
          class="font-saira font-bold uppercase text-white leading-tight"
          style="font-size: clamp(2rem, 4vw, 3.25rem);"
        >
          Por qué elegir<br/>
          <span style="color:#9ac31c;">Filtros ANEFFY</span>
        </h2>
        <p class="font-roboto font-light text-base leading-relaxed" style="color:rgba(255,255,255,0.6);">
          Ingeniería nacional con estándar internacional. Construidos para la continuidad operativa de tu planta.
        </p>
      </div>

      <!-- Bento Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6" style="grid-auto-rows: minmax(280px, auto); margin-top: 3rem;">

        <!-- Tarjeta 1 — Libre de Aranceles (2 cols) -->
        <article
          class="gsap-bento-card md:col-span-2 relative rounded-2xl flex flex-col justify-end overflow-hidden group transition-colors duration-300 cursor-default"
          style="background: rgba(255,255,255,0.04); backdrop-filter: blur(12px); border: 1px solid rgba(255,255,255,0.09); padding: 1.5rem;"
        >
          <!-- Icono decorativo de fondo -->
          <div class="absolute top-6 right-6 opacity-10 group-hover:opacity-20 transition-opacity duration-300" aria-hidden="true">
            <i class="ph ph-shield-check" style="font-size: 7rem; color:#9ac31c;"></i>
          </div>
          <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: rgba(255,255,255,0.04);" aria-hidden="true"></div>
          <!-- Acento lime superior -->
          <div class="w-12 h-1 rounded-full" style="background:#9ac31c; margin-bottom: 1rem;" aria-hidden="true"></div>
          <h3 class="font-saira font-bold text-3xl uppercase text-white leading-tight">
            Cumplimiento normativo
          </h3>
          <p class="font-roboto font-light text-base mt-3 leading-relaxed" style="color:rgba(255,255,255,0.60); max-width: 420px;">
            Mejora la calidad del aire dentro de tu cabina de pintura para optimizar procesos de producción, cumplir con normativas y dotar de seguridad al personal operativo.
          </p>
        </article>

        <!-- Tarjeta 2 — Stock Inmediato (1 col) -->
        <article
          class="gsap-bento-card rounded-2xl flex flex-col justify-end overflow-hidden group transition-colors duration-300 cursor-default relative"
          style="background: rgba(154,195,28,0.08); backdrop-filter: blur(12px); border: 1px solid rgba(154,195,28,0.20); padding: 1.5rem;"
        >
          <div class="absolute top-6 right-6 opacity-15 group-hover:opacity-25 transition-opacity duration-300" aria-hidden="true">
            <i class="ph ph-lightning" style="font-size: 6rem; color:#9ac31c;"></i>
          </div>
          <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: rgba(154,195,28,0.05);" aria-hidden="true"></div>
          <div class="w-12 h-1 rounded-full" style="background:#9ac31c; margin-bottom: 1rem;" aria-hidden="true"></div>
          <h3 class="font-saira font-bold text-3xl uppercase text-white leading-tight">
            Stock Inmediato
          </h3>
          <p class="font-roboto font-light text-base mt-3 leading-relaxed" style="color:rgba(255,255,255,0.60);">
            Disponibilidad nacional para envío rápido. Tu línea de producción nunca se detiene.
          </p>
        </article>

        <!-- Contenedor dividido en 2 columnas para Rendimiento y Asesoramiento -->
        <div class="md:col-span-3 grid grid-cols-1 lg:grid-cols-2 gap-6">
          
          <!-- Tarjeta 3 — Rendimiento OEM -->
          <article
            class="gsap-bento-card rounded-2xl flex flex-col justify-end gap-6 overflow-hidden group transition-colors duration-300 cursor-default relative"
            style="background: rgba(12,91,140,0.15); backdrop-filter: blur(12px); border: 1px solid rgba(12,91,140,0.35); padding: 1.5rem;"
          >
            <!-- Orbe decorativo -->
            <div class="absolute -right-16 -bottom-16 w-64 h-64 rounded-full blur-2xl opacity-20" style="background: #0c5b8c;" aria-hidden="true"></div>
            <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: rgba(12,91,140,0.08);" aria-hidden="true"></div>

            <div class="flex flex-col max-w-full">
              <div class="w-12 h-1 rounded-full" style="background:#9ac31c; margin-bottom: 1rem;" aria-hidden="true"></div>
              <h3 class="font-saira font-bold text-3xl uppercase text-white leading-tight">
                Rendimiento OEM <span style="color:#9ac31c;">Garantizado</span>
              </h3>
              <p class="font-roboto font-light text-base mt-3 leading-relaxed" style="color:rgba(255,255,255,0.65);">
                Diseñados bajo las mismas especificaciones de fábrica de los equipos Anaerobia.
                Ajuste perfecto, filtración impecable.
              </p>
            </div>

          </article>

          <!-- Tarjeta 4 — Asesoramiento técnico -->
          <article
            class="gsap-bento-card rounded-2xl flex flex-col justify-end overflow-hidden group transition-colors duration-300 cursor-default relative"
            style="background: rgba(154,195,28,0.08); backdrop-filter: blur(12px); border: 1px solid rgba(154,195,28,0.20); padding: 1.5rem;"
          >
            <div class="absolute top-6 right-6 opacity-15 group-hover:opacity-25 transition-opacity duration-300" aria-hidden="true">
              <i class="ph ph-chats" style="font-size: 6rem; color:#9ac31c;"></i>
            </div>
            <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300" style="background: rgba(154,195,28,0.05);" aria-hidden="true"></div>
            
            <div class="w-12 h-1 rounded-full" style="background:#9ac31c; margin-bottom: 1rem;" aria-hidden="true"></div>
            <h3 class="font-saira font-bold text-3xl uppercase text-white leading-tight">
              Asesoramiento técnico
            </h3>
            <p class="font-roboto font-light text-base mt-3 leading-relaxed" style="color:rgba(255,255,255,0.65); max-width: 90%;">
              Somos capaces de brindar asesoramiento técnico para ayudarte a identificar tus necesidades de filtración de acuerdo a tu área de trabajo y proceso de producción.
            </p>
          </article>

        </div>

      </div>
    </div>
  </section>

  <!-- ================================================
       SECCIÓN: INFORMACIÓN DEL FILTRO
       ================================================ -->
  <section
    id="filtro-info"
    class="section-pad overflow-hidden"
    style="background: #001820;"
    aria-labelledby="filtro-info-heading"
  >
    <div class="container-aneffy">
      
      <!-- Introducción -->
      <div class="w-full flex flex-col items-center justify-center gsap-hero-item px-4 lg:px-0" style="margin-bottom: 6rem;">
        <div class="flex flex-col items-center text-center gap-3" style="margin-bottom: 3rem;">
          <div class="flex items-center gap-3">
            <span class="w-8 h-px" style="background:#9ac31c;" aria-hidden="true"></span>
            <span class="font-roboto text-xs tracking-[0.25em] uppercase font-semibold" style="color:#9ac31c;">Nuestros filtros</span>
            <span class="w-8 h-px" style="background:#9ac31c;" aria-hidden="true"></span>
          </div>
          <h2 class="font-saira font-bold uppercase text-white" style="font-size: clamp(1.8rem, 3.5vw, 2.8rem); line-height: 1.1;">
            EFICIENCIA ABSOLUTA A UN PRECIO INTELIGENTE
          </h2>
        </div>
        <div class="max-w-4xl text-center">
          <p class="font-roboto font-light text-lg md:text-xl leading-relaxed" style="color: rgba(255,255,255,0.85); text-align: center;">
            En ANAEROBIA desarrollamos <span class="font-bold" style="color:#9ac31c;">ANEFFY</span>, un filtro de aire que combina eficiencia G3 y buen precio,<br class="hidden md:block" /> garantizando calidad, seguridad y ahorro en tu proceso de producción.
          </p>
        </div>
      </div>

      <!-- Layout 2 Columnas -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        
        <!-- Izquierda: Galería de Imágenes (Slider) -->
        <div class="gsap-hero-item relative w-full flex justify-center lg:justify-start">
          <div class="relative w-full max-w-[600px] overflow-hidden rounded-2xl border border-white/10 shadow-2xl bg-black/20 mx-auto lg:mx-0" style="aspect-ratio: 4/3;">
            <div id="gallery-slider" class="flex w-full h-full transition-transform duration-700 ease-in-out">
              <img src={`${base}galeria/0D0A5108-2.png`} alt="Filtro ANEFFY" class="w-full h-full object-cover shrink-0" loading="lazy" />
              <img src={`${base}galeria/0D0A5119-1.jpg`} alt="Filtro ANEFFY" class="w-full h-full object-cover shrink-0" loading="lazy" />
              <img src={`${base}galeria/0D0A5147-1.png`} alt="Filtro ANEFFY" class="w-full h-full object-cover shrink-0" loading="lazy" />
              <img src={`${base}galeria/0D0A5160-1.png`} alt="Filtro ANEFFY" class="w-full h-full object-cover shrink-0" loading="lazy" />
              <img src={`${base}galeria/DSC00063.jpg`}  alt="Filtro ANEFFY" class="w-full h-full object-cover shrink-0" loading="lazy" />
              <img src={`${base}galeria/DSC00098-2.png`} alt="Filtro ANEFFY" class="w-full h-full object-cover shrink-0" loading="lazy" />
              <img src={`${base}galeria/DSC00103-2.jpg`} alt="Filtro ANEFFY" class="w-full h-full object-cover shrink-0" loading="lazy" />
              <img src={`${base}galeria/DSC00111-1.png`} alt="Filtro ANEFFY" class="w-full h-full object-cover shrink-0" loading="lazy" />
            </div>
            
            <!-- Controles Slider -->
            <button id="prev-slide" class="absolute left-2 md:left-3 top-1/2 -translate-y-1/2 w-8 h-8 md:w-10 md:h-10 rounded-full bg-black/40 hover:bg-[#9ac31c] flex items-center justify-center text-white backdrop-blur-sm transition-all shadow-lg border border-white/10" aria-label="Anterior">
              <i class="ph ph-caret-left text-lg md:text-xl"></i>
            </button>
            <button id="next-slide" class="absolute right-2 md:right-3 top-1/2 -translate-y-1/2 w-8 h-8 md:w-10 md:h-10 rounded-full bg-black/40 hover:bg-[#9ac31c] flex items-center justify-center text-white backdrop-blur-sm transition-all shadow-lg border border-white/10" aria-label="Siguiente">
              <i class="ph ph-caret-right text-lg md:text-xl"></i>
            </button>
            
            <!-- Puntos de Paginación -->
            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 flex gap-2" id="gallery-dots"></div>
          </div>
          
          <script is:inline>
            document.addEventListener('DOMContentLoaded', () => {
              const slider = document.getElementById('gallery-slider');
              const prev = document.getElementById('prev-slide');
              const next = document.getElementById('next-slide');
              const dotsContainer = document.getElementById('gallery-dots');
              if(!slider || !prev || !next) return;

              const slides = slider.querySelectorAll('img');
              const totalSlides = slides.length;
              let currentSlide = 0;

              for(let i = 0; i < totalSlides; i++) {
                const dot = document.createElement('button');
                dot.className = `w-2 h-2 rounded-full transition-colors ${i === 0 ? 'bg-[#9ac31c]' : 'bg-white/50 hover:bg-white/80'}`;
                dot.ariaLabel = `Ir a diapositiva ${i + 1}`;
                dot.addEventListener('click', () => goToSlide(i));
                dotsContainer.appendChild(dot);
              }
              const dots = dotsContainer.querySelectorAll('button');

              const updateSlider = () => {
                slider.style.transform = `translateX(-${currentSlide * 100}%)`;
                dots.forEach((dot, index) => {
                  dot.className = `w-2 h-2 rounded-full transition-colors ${index === currentSlide ? 'bg-[#9ac31c]' : 'bg-white/50 hover:bg-white/80'}`;
                });
              };

              const goToSlide = (index) => {
                currentSlide = index;
                updateSlider();
              };

              const nextSlide = () => {
                currentSlide = (currentSlide + 1) % totalSlides;
                updateSlider();
              };

              const prevSlide = () => {
                currentSlide = (currentSlide - 1 + totalSlides) % totalSlides;
                updateSlider();
              };

              next.addEventListener('click', nextSlide);
              prev.addEventListener('click', prevSlide);

              // Auto-play
              let interval = setInterval(nextSlide, 3500);
              slider.parentElement.addEventListener('mouseenter', () => clearInterval(interval));
              slider.parentElement.addEventListener('mouseleave', () => {
                interval = setInterval(nextSlide, 3500);
              });
            });
          </script>
        </div>

        <!-- Derecha: Texto / Beneficios -->
        <div class="gsap-hero-item flex flex-col gap-10">
          
          <div class="flex flex-col lg:items-start text-left" style="margin-bottom: 1rem;">
            <div class="w-12 h-1 rounded-full" style="background:#9ac31c; margin-bottom: 1rem;" aria-hidden="true"></div>
            <h3 class="font-saira font-bold uppercase text-2xl md:text-3xl text-white tracking-wide" style="margin-bottom: 1rem;">
              Eleva la Calidad de tus Productos
            </h3>
            <p class="font-roboto font-light text-base leading-relaxed" style="color:rgba(255,255,255,0.7);">
              Elimina partículas, polvo, overspray y otros contaminantes del proceso de producción.
            </p>
          </div>

          <div class="flex flex-col lg:items-start text-left" style="margin-bottom: 1rem;">
            <div class="w-12 h-1 rounded-full" style="background:#9ac31c; margin-bottom: 1rem;" aria-hidden="true"></div>
            <h3 class="font-saira font-bold uppercase text-2xl md:text-3xl text-white tracking-wide" style="margin-bottom: 1rem;">
              Cumple con Normativas
            </h3>
            <p class="font-roboto font-light text-base leading-relaxed" style="color:rgba(255,255,255,0.7);">
              Evita sanciones y garantiza un ambiente seguro de trabajo cumpliendo con regulaciones de emisión de partículas y contaminación.
            </p>
          </div>

          <div class="flex flex-col lg:items-start text-left">
            <div class="w-12 h-1 rounded-full" style="background:#9ac31c; margin-bottom: 1rem;" aria-hidden="true"></div>
            <h3 class="font-saira font-bold uppercase text-2xl md:text-3xl text-white tracking-wide" style="margin-bottom: 1rem;">
              Blindaje Logístico
            </h3>
            <p class="font-roboto font-light text-base leading-relaxed" style="color:rgba(255,255,255,0.7);">
              Nos aseguramos de que tu suministro de filtros nunca falle en cuanto a tiempos de entrega.
            </p>
          </div>

        </div>

      </div>

      <!-- ================================================
           TABLA DE CARACTERÍSTICAS
           ================================================ -->
      <div id="caracteristicas" class="gsap-hero-item scroll-mt-28" style="margin-top: 8rem;">
        <div class="flex flex-col sm:flex-row justify-between items-center gap-6" style="margin-bottom: 3rem;">
          <h2 class="font-saira font-bold text-3xl md:text-4xl text-white tracking-wide uppercase m-0">
            Características
          </h2>
          <a
            href={`${base}ANEFFY_ficha_tecnica.pdf`}
            download="ANEFFY_ficha_tecnica.pdf"
            target="_blank"
            class="btn-secondary text-sm md:text-base px-6 py-2.5"
          >
            <i class="ph ph-download-simple text-lg md:text-xl" aria-hidden="true"></i>
            Ficha técnica
          </a>
        </div>

        <div class="overflow-x-auto rounded-xl shadow-[0_0_30px_rgba(12,91,140,0.15)]" style="border: 1px solid rgba(255,255,255,0.1);">
          <table class="w-full text-center border-collapse" style="min-width: 800px; background: rgba(0,0,0,0.2);">
            <tbody>
              <!-- Fila 1: Títulos Superiores -->
              <tr style="background: rgba(12,91,140,0.35); border-bottom: 1px solid rgba(255,255,255,0.1);">
                <th class="p-5 font-saira font-bold text-white tracking-wider border-r border-[rgba(255,255,255,0.1)]">
                  Avg. arrestance<br/><span class="text-xs font-normal opacity-70">(acc.EN779)</span>
                </th>
                <th class="p-5 font-saira font-bold text-white tracking-wider border-r border-[rgba(255,255,255,0.1)]">Air Velocity</th>
                <th class="p-5 font-saira font-bold text-white tracking-wider border-r border-[rgba(255,255,255,0.1)]">Initial Pressure Drop</th>
                <th class="p-5 font-saira font-bold text-white tracking-wider border-r border-[rgba(255,255,255,0.1)]">Final Pressure Drop</th>
                <th class="p-5 font-saira font-bold text-white tracking-wider">Normal Thickness</th>
              </tr>
              <!-- Fila 2: Datos Superiores -->
              <tr style="border-bottom: 1px solid rgba(255,255,255,0.1);">
                <td class="p-5 font-roboto font-bold text-2xl border-r border-[rgba(255,255,255,0.1)]" style="color: #9ac31c;">85% (G3)</td>
                <td class="p-5 font-roboto font-bold text-2xl border-r border-[rgba(255,255,255,0.1)]" style="color: #9ac31c;">1.5m/s</td>
                <td class="p-5 font-roboto font-bold text-2xl border-r border-[rgba(255,255,255,0.1)]" style="color: #9ac31c;">20pa</td>
                <td class="p-5 font-roboto font-bold text-2xl border-r border-[rgba(255,255,255,0.1)]" style="color: #9ac31c;">200pa</td>
                <td class="p-5 font-roboto font-bold text-2xl" style="color: #9ac31c;">24 mm</td>
              </tr>
              <!-- Fila 3: Títulos Inferiores -->
              <tr style="background: rgba(12,91,140,0.35); border-bottom: 1px solid rgba(255,255,255,0.1);">
                <th class="p-5 font-saira font-bold text-white tracking-wider border-r border-[rgba(255,255,255,0.1)]">Ashrae</th>
                <th class="p-5 font-saira font-bold text-white tracking-wider border-r border-[rgba(255,255,255,0.1)]">Temp. Resistance<br/>Const.</th>

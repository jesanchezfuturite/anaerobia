---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import CatalogoListado from '../../components/CatalogoListado.astro'
import { getCatalogo, getCategoriasLocales } from '../../lib/catalogo.js'
import { withLocale } from '../../lib/i18n.js'

const { locale = 'es' } = Astro.props
const T = locale === 'en' ? {
    title: 'Parts and Filters | Industrial paint system components',
    description: 'Parts, filters, and replacement components for industrial paint systems, including paint booth filters, infrared lamps, application equipment, and components from leading manufacturers.',
} : {
    title: 'Partes y Filtros | Componentes para sistemas de pintura industrial',
    description: 'Catálogo de partes, filtros y refacciones para sistemas de pintura industrial: filtros de cabina, lámparas infrarrojas, equipos de aplicación y componentes de las principales marcas.',
}

// El catálogo es un escaparate: los filtros viajan en la URL para que
// cualquier vista se pueda compartir y la indexen los buscadores. La
// categoría es la excepción: tiene su propia ruta (/partes-y-filtros/{slug})
// para que el título, la descripción y el canonical le pertenezcan solo a
// ella, así que una visita con ?categoria= se consolida ahí.
const parametros = Astro.url.searchParams
const categoria = parametros.get('categoria') ?? ''
const marca = parametros.get('marca') ?? ''
const buscar = parametros.get('buscar') ?? ''
const pagina = Math.max(1, Number(parametros.get('pagina') ?? 1))

if (categoria && getCategoriasLocales().some((c) => c.slug === categoria)) {
    const destino = new URLSearchParams(parametros)
    destino.delete('categoria')
    const cadena = destino.toString()
    return Astro.redirect(`${withLocale(`/partes-y-filtros/${categoria}`, locale)}${cadena ? `?${cadena}` : ''}`, 301)
}

const { data: productos, meta, categorias, marcas } = await getCatalogo({ categoria, marca, buscar, pagina, locale })

const seoTitle = T.title
const seoDescription = T.description
---

<Layout title={seoTitle} description={seoDescription}>
    <CatalogoListado locale={locale} categoria="" marca={marca} buscar={buscar} productos={productos} meta={meta} categorias={categorias} marcas={marcas} />
</Layout>
